---
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import CartDrawer from '@/components/cart/CartDrawer.astro';
import OrderModal from '@/components/cart/OrderModal.astro';
import perfumesData from '@/data/perfumes.json';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  children: any;
}

const { title, description = 'ΛTOMIZΛ - Decants de autor. Boutique de perfumes de lujo en decants de 5ml.', ogImage = '/og-image.jpg', children } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | ΛTOMIZΛ</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
  </head>
  <body>
    <Header />
    <main id="main-content" role="main">
      <slot>{children}</slot>
    </main>
    <Footer />
    <CartDrawer />
    <OrderModal />
  </body>
</html>

<script is:inline define:vars={{ perfumesData }}>
  // Store perfumes data in localStorage for cart functionality
  if (typeof window !== 'undefined') {
    localStorage.setItem('perfumes-data', JSON.stringify({ perfumes: perfumesData.perfumes }));
  }
</script>

<script>
  import { initLiveStock } from '@/utils/live-stock';
  initLiveStock();
</script>

<style>
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
    padding-top: 72px; /* Header height */
  }

  @media (max-width: 640px) {
    main {
      padding-top: 64px;
    }
  }
</style>