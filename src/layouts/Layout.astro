---
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Consent from '@/components/layout/Consent.astro';
import CookieBanner from '@/components/layout/CookieBanner.astro';
import CartDrawer from '@/components/cart/CartDrawer.astro';
import OrderModal from '@/components/cart/OrderModal.astro';
import { site, assetUrl } from '@/site.config';
import { resenasRating, hasResenas } from '@/data/resenas';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  preloadImages?: string[];
  /** true hace que la página sea noindex/noarchive en Google (404, envíos de prueba, etc.). */
  noindex?: boolean;
}

const {
  title,
  description = `${site.name} - ${site.tagline}. ${site.description}`,
  ogImage = '/og-image.jpg',
  ogType = 'website',
  preloadImages = [],
  noindex = false,
} = Astro.props;
const ogImageUrl = new URL(assetUrl(ogImage), Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
// Google muestra ~55-60 caracteres del <title>. Si el título con la marca
// excede eso, se corta; mejor un title corto y completo que uno truncado.
const fullTitle = `${title} | ${site.name}`.length <= 60 ? `${title} | ${site.name}` : title;
const robots = noindex ? 'noindex, nofollow' : 'index, follow';
---

<!DOCTYPE html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:type" content={ogType} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={title} />
    <meta name="theme-color" content="#121414" />
    <link rel="icon" type="image/svg+xml" href={assetUrl('/favicon.svg')} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={assetUrl('/fonts/Montserrat-Variable.woff2')} />
    {preloadImages.map((src) => (
      <link rel="preload" as="image" href={new URL(assetUrl(src), Astro.site).href} />
    ))}
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Store',
      name: site.name,
      url: Astro.site,
      logo: new URL(assetUrl('/favicon.svg'), Astro.site).href,
      description: site.description,
      sameAs: [site.instagramUrl, site.tiktokUrl, `https://wa.me/${site.whatsappNumber}`],
      address: {
        '@type': 'PostalAddress',
        addressLocality: site.addressLocality,
        addressRegion: site.addressRegion,
        addressCountry: site.addressCountry,
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: site.geo.latitude,
        longitude: site.geo.longitude,
      },
      telephone: `+${site.phoneDisplay.replace(/[^0-9]/g, '')}`,
      priceRange: '$$',
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: `+${site.phoneDisplay.replace(/[^0-9]/g, '')}`,
        contactType: 'customer service',
        areaServed: site.addressLocality,
        availableLanguage: ['es'],
      },
      ...(hasResenas
        ? {
            aggregateRating: {
              '@type': 'AggregateRating',
              ratingValue: resenasRating.ratingValue,
              reviewCount: resenasRating.reviewCount,
              bestRating: 5,
            },
          }
        : {}),
      areaServed: {
        '@type': 'City',
        name: site.addressLocality,
      },
      // Igual que el resto de JSON-LD del sitio: se escapa `<` para que un
      // `</script>` en los datos no pueda romper el bloque.
    }).replace(/</g, '\\u003c')} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: site.namePlain,
      alternateName: site.name,
      url: Astro.site,
      logo: new URL(assetUrl('/favicon.svg'), Astro.site).href,
      description: site.description,
      sameAs: [site.instagramUrl, site.tiktokUrl],
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: `+${site.phoneDisplay.replace(/[^0-9]/g, '')}`,
        contactType: 'customer service',
        areaServed: site.addressCountry,
        availableLanguage: ['es'],
      },
    }).replace(/</g, '\\u003c')} />
    <ClientRouter />
    {site.secureprivacyScriptId && (
      <script is:inline defer src={`https://app.secureprivacy.ai/script/${site.secureprivacyScriptId}.js`}></script>
    )}
    <Consent />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido</a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <CartDrawer />
    <OrderModal />
    <CookieBanner />
    <a
      href={`https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(site.whatsappMessage)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="whatsapp-fab"
      aria-label="Consultar por WhatsApp"
    >
      <img src={assetUrl('images/icons/whatsapp.svg')} width="28" height="28" alt="" aria-hidden="true" />
    </a>
  </body>
</html>

<style>
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
    padding-top: var(--header-height);
  }

  .whatsapp-fab {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 90;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-whatsapp);
    border-radius: 50%;
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    transition: transform var(--transition-duration) var(--transition-easing), box-shadow var(--transition-duration) var(--transition-easing);
  }

  .whatsapp-fab:hover {
    transform: scale(1.1);
    box-shadow: var(--shadow-md);
  }

  .whatsapp-fab:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  @media (max-width: 640px) {
    .whatsapp-fab {
      bottom: 16px;
      right: 16px;
      width: 48px;
      height: 48px;
    }

    .whatsapp-fab img {
      width: 24px;
      height: 24px;
    }
  }
</style>