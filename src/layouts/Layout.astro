---
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import CartDrawer from '@/components/cart/CartDrawer.astro';
import OrderModal from '@/components/cart/OrderModal.astro';
import perfumesData from '@/data/perfumes.json';
import { site, assetUrl } from '@/site.config';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  children: any;
}

const { title, description = `${site.name} - ${site.tagline}. ${site.description}`, ogImage = '/og-image.jpg', children } = Astro.props;
const ogImageUrl = new URL(assetUrl(ogImage).replace(site.basePath, ''), Astro.site).href;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | {site.name}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" type="image/svg+xml" href={assetUrl('/favicon.svg')} />
    <ClientRouter />
  </head>
  <body>
    <Header />
    <main id="main-content" role="main">
      <slot>{children}</slot>
    </main>
    <Footer />
    <CartDrawer />
    <OrderModal />
  </body>
</html>

<script is:inline define:vars={{ perfumesData, perfumesStorageKey: site.storage.perfumes }}>
  // Store perfumes data in localStorage for cart functionality
  if (typeof window !== 'undefined') {
    localStorage.setItem(perfumesStorageKey, JSON.stringify({ perfumes: perfumesData.perfumes }));
  }
</script>

<style>
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
    padding-top: 72px; /* Header height */
  }

  @media (max-width: 640px) {
    main {
      padding-top: 64px;
    }
  }
</style>