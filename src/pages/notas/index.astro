---
import Layout from '@/layouts/Layout.astro';
import { NOTAS, perfumesConNota } from '@/data/notas';
import { formatPrice } from '@/utils/formatters';
import perfumesData from '@/data/perfumes.json';
import { site, assetUrl } from '@/site.config';
import type { Perfume } from '@/data/types';

const BASE = site.basePath;
const perfumes = perfumesData.perfumes as Perfume[];

const pageTitle = `Decants por nota olfativa · ${site.addressLocality}`;
const pageDescription = `¿Te gustan los perfumes dulces, frescos o amaderados? Explorá decants de 5ml por nota: vainilla, bergamota, oud, rosa y más, en ${site.addressLocality}.`;

function desdePrecio(items: Perfume[]): string {
  const precios = items.flatMap((p) => p.sizes.map((s) => s.price)).filter((n) => Number.isFinite(n));
  return precios.length > 0 ? formatPrice(Math.min(...precios)) : 'a confirmar';
}
---

<Layout title={pageTitle} description={pageDescription}>
  <section class="notahub-hero" aria-labelledby="notahub-title">
    <div class="container">
      <h1 id="notahub-title" class="notahub-title">Buscá por nota</h1>
      <p class="notahub-subtitle">
        Vainilla, oud, rosa, bergamota: si hay una nota que te encanta,
        acá están sus decants de 5ml.
      </p>
    </div>
  </section>

  <section class="notahub-list" aria-label="Notas olfativas famosas">
    <div class="container">
      <div class="notahub-grid">
        {NOTAS.map((nota) => {
          const items = perfumesConNota(perfumes, nota);
          return (
            <a href={`${BASE}notas/${nota.slug}/`} class="notahub-card">
              <img
                class="notahub-card-img"
                src={assetUrl(nota.image)}
                alt={`Nota olfativa de ${nota.name}`}
                width="144"
                height="144"
                loading="lazy"
              />
              <div class="notahub-card-body">
                <h2 class="notahub-card-title">{nota.name}</h2>
                <p class="notahub-card-sub">{nota.blurb}</p>
                <p class="notahub-card-count">{items.length} {items.length === 1 ? 'decant' : 'decants'}</p>
              </div>
              <span class="notahub-card-price">desde {desdePrecio(items)}</span>
            </a>
          );
        })}
      </div>
      <div class="notahub-cta">
        <a href={`${BASE}decants/`} class="notahub-alt-link">¿Buscás un aroma famoso puntual? →</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .notahub-hero {
    padding: var(--spacing-stack-md) 0 var(--spacing-stack-sm);
    text-align: center;
  }

  .notahub-title {
    font-family: var(--font-family);
    font-size: var(--font-display-lg-size);
    font-weight: var(--font-display-lg-weight);
    letter-spacing: var(--font-display-lg-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
    margin: 0 auto var(--spacing-stack-sm);
    max-width: 720px;
  }

  @media (max-width: 640px) {
    .notahub-title {
      font-size: var(--font-headline-md-size);
      letter-spacing: var(--font-headline-md-tracking);
    }
  }

  .notahub-subtitle {
    font-family: var(--font-family);
    font-size: var(--font-body-lg-size);
    line-height: var(--font-body-lg-line-height);
    color: var(--color-on-surface-variant);
    margin: 0 auto;
    max-width: 640px;
  }

  @media (max-width: 640px) {
    .notahub-subtitle {
      font-size: var(--font-body-md-size);
    }
  }

  .notahub-list {
    padding: var(--spacing-stack-lg) 0;
  }

  .notahub-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-stack-sm);
  }

  @media (min-width: 768px) {
    .notahub-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* En mobile la card es columna con foto centrada (no a todo ancho):
     la imagen 120x120 no se estira y no pixelia; el fondo blanco
     sigue expandido horizontalmente. En desktop vuelve a la fila compacta. */
  .notahub-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: var(--spacing-stack-md) 0;
    border: var(--border-width) solid var(--color-outline-variant);
    border-radius: var(--border-radius);
    background-color: var(--color-surface-container);
    text-decoration: none;
    transition: border-color var(--transition-duration) var(--transition-easing);
  }

  .notahub-card:hover {
    border-color: var(--color-primary);
  }

  .notahub-card-img {
    width: 100px;
    height: 100px;
    flex-shrink: 0;
    object-fit: cover;
    border-radius: 12px;
  }

  .notahub-card-body {
    padding: 0 var(--spacing-stack-md);
    text-align: center;
  }

  .notahub-card-price {
    padding: 0 var(--spacing-stack-md);
  }

  @media (min-width: 768px) {
    .notahub-card {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: var(--spacing-stack-md);
      overflow: visible;
    }

    .notahub-card-img {
      width: 72px;
      height: 72px;
      border-radius: 12px;
    }

    .notahub-card-body,
    .notahub-card-price {
      padding: 0;
    }
  }

  .notahub-card-title {
    font-family: var(--font-family);
    font-size: var(--font-headline-md-size);
    font-weight: var(--font-headline-md-weight);
    color: var(--color-on-surface);
    margin: 0;
  }

  .notahub-card-sub {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    color: var(--color-on-surface-variant);
    margin: 4px 0;
  }

  .notahub-card-count {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
    margin: 0;
  }

  .notahub-card-price {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-primary);
    white-space: nowrap;
  }

  .notahub-cta {
    text-align: center;
    margin-top: var(--spacing-stack-md);
  }

  .notahub-alt-link {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
