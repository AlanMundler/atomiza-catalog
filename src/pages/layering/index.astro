    {/* ================= 10 · FAQ ================= */}
    <section class="ly-section" id="faq" aria-labelledby="ly-faq-title">
      <div class="container">
        <h2 id="ly-faq-title" class="ly-h2 ly-h2--center"><span class="ly-num" aria-hidden="true">09</span>Preguntas frecuentes</h2>
        <Faq items={faq} firstOpen={false} />
