---
/**
 * /layering — Guía editorial + combinador interactivo.
 *
 * Estructura: hero con combo estrella (entra sin scroll en 390×844 medido,
 * render completo en el server para que funcione sin JS) → navegación interna
 * sticky con estado activo por scroll → qué es / qué no es → combinador (búsqueda
 * + dos selects agrupados por rol, previsualización de botellas, medidor de
 * afinidad, notas puente, ratio, estado en URL con `?a=&b=`, copiar link) →
 * combos curadas con filtros (estación/momento/familia), orden por afinidad y
 * "ver más" para escalar a 20 pares → stepper de técnica → matriz de familias
 * (tabla en desktop, cards en mobile) → qué evitar con ejemplos reales del
 * stock → seguridad en disclosure → clima Córdoba → FAQ → CTA.
 *
 * La lógica de afinidad vive en `src/utils/layering.ts` (sin DOM): el server
 * la usa para el estado inicial y el script del cliente importa la MISMA
 * función para el resultado en vivo. Nada de promesas de duración: heurística
 * honesta, precios siempre desde `perfumes.json`. Sin dependencias nuevas ni
 * JS pesado: IntersectionObserver + listeners nativos.
 */
import Layout from '@/layouts/Layout.astro';
import Faq from '@/components/ui/Faq.astro';
import Chip from '@/components/ui/Chip.astro';
import perfumesData from '@/data/perfumes.json';
import imageDimsRaw from '@/data/image-dims.json';
import { getFamilias } from '@/data/familias';
import { site, assetUrl } from '@/site.config';
import { resenasRating, hasResenas } from '@/data/resenas';
import { formatPrice } from '@/utils/formatters';
import { getStockStatus, primarySize, DECANT_ML } from '@/utils/stock';
import {
  availableLayeringCombos,
  decantAvailable,
  decantPrice,
  layeringAffinity,
  layeringRole,
  pairPrice,
  sharedNotes,
  type AffinityVerdict,
  type LayeringRole,
} from '@/utils/layering';
import type { Perfume } from '@/data/types';

const BASE = site.basePath;

// ---------------------------------------------------------------------------
// Datos reales (stock manda): el combinador solo ofrece decants de 5 ml
// disponibles, y las combos curadas se filtran por disponibilidad al vuelo.
// ---------------------------------------------------------------------------
const perfumes = perfumesData.perfumes as Perfume[];
const byId = new Map(perfumes.map((p) => [p.id, p]));
const inStock = perfumes.filter((p) => decantAvailable(p) && decantPrice(p) !== null);

const roleGroups: { role: LayeringRole; label: string; items: Perfume[] }[] = [
  { role: 'ancla', label: 'Ideales como base', items: [] },
  { role: 'acento', label: 'Ideales como acento', items: [] },
  { role: 'puente', label: 'Comodines (sirven de las dos)', items: [] },
];
for (const p of inStock) {
  const group = roleGroups.find((g) => g.role === layeringRole(p));
  group?.items.push(p);
}
for (const g of roleGroups) g.items.sort((a, b) => a.name.localeCompare(b.name, 'es'));

// Agrupación simple de familias olfativas para los chips de filtro de combos
// (el catálogo tiene 30+ familias literales; para filtrar hace falta un
// grouping legible en una línea de chips).
const FAMILY_GROUPS: [RegExp, string][] = [
  [/cuero/i, 'Cueros'],
  [/almizcle/i, 'Almizcles'],
  [/vainilla|gourmand|dulce|coco|pera/i, 'Dulces'],
  [/amader|oud/i, 'Amaderados'],
  [/oriental|ambar|especiad|cálido|calido|foug/i, 'Orientales'],
  [/floral|chipre/i, 'Florales'],
  [/citric|arom|acu|fresc|frutal|verde|tropical|marin/i, 'Frescos'],
];
const familyGroup = (family: string): string =>
  FAMILY_GROUPS.find(([re]) => re.test(family))?.[1] ?? 'Otros';
const familySlug = (label: string): string =>
  label
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/\s+/g, '-');

// Tokens de estación para filtrar: "todo el año" entra en TODA estación.
const seasonTokens = (season: string): string[] => {
  if (/todo el año/i.test(season)) return ['all'];
  const tokens: string[] = [];
  if (/primavera/i.test(season)) tokens.push('primavera');
  if (/verano/i.test(season)) tokens.push('verano');
  if (/otoñ/i.test(season)) tokens.push('otono');
  if (/inviern/i.test(season)) tokens.push('invierno');
  return tokens.length ? tokens : ['all'];
};
const momentOf = (occasion: string): 'dia' | 'noche' => (/noche/i.test(occasion) ? 'noche' : 'dia');

const combos = availableLayeringCombos(perfumes);
const comboViews = combos.map((combo, i) => {
  const anchor = byId.get(combo.anchorSlug)!;
  const accent = byId.get(combo.accentSlug)!;
  const anchorSize = primarySize(anchor);
  const accentSize = primarySize(accent);
  const aff = layeringAffinity(anchor, accent);
  return {
    ...combo,
    index: i,
    anchor,
    accent,
    shared: sharedNotes(anchor, accent),
    total: pairPrice(anchor, accent) ?? 0,
    score: aff.score,
    verdict: aff.verdict,
    family: familyGroup(anchor.olfactoryFamily),
    seasons: seasonTokens(combo.season).join(' '),
    moment: momentOf(combo.occasion),
    // Chip honesto de "poco stock" (1-4 unidades) cuando alguna pata lo esté.
    lowStock:
      (anchorSize ? getStockStatus(anchorSize) : 'out-of-stock') === 'low-stock' ||
      (accentSize ? getStockStatus(accentSize) : 'out-of-stock') === 'low-stock',
  };
});

// Familia de los anclas presentes, en orden de aparición (chips de filtro).
const comboFamilies: string[] = [];
for (const c of comboViews) if (!comboFamilies.includes(c.family)) comboFamilies.push(c.family);

// Combo estrella del hero = la primera disponible (orden de curaduría).
const star = comboViews[0] ?? null;

// Estado inicial del combinador (server render, mismo que pintaría el cliente):
// la combo estrella como default.
const defA = star?.anchor ?? inStock[0];
const defB = star?.accent ?? inStock[1];
const defAff = layeringAffinity(defA, defB);
const defTotal = pairPrice(defAff.anchor, defAff.accent) ?? 0;

const verdictMeta: Record<AffinityVerdict, { label: string; className: string }> = {
  fuerte: { label: 'Combinación fuerte', className: 'ly-verdict--fuerte' },
  buena: { label: 'Buena combinación', className: 'ly-verdict--buena' },
  cuidado: { label: 'Combiná con cuidado', className: 'ly-verdict--cuidado' },
};

// Anchos/altos reales (scripts/image-dims.mjs) para cero CLS en las botellas.
type ImageDims = { width: number; height: number };
const imageDims = imageDimsRaw as unknown as Record<string, ImageDims>;
const FALLBACK_DIMS: ImageDims = { width: 400, height: 400 };
const dimsFor = (p: Perfume): ImageDims => imageDims[p.images[0]?.src ?? ''] ?? FALLBACK_DIMS;
const bottleSrc = (p: Perfume): string => assetUrl(p.images[0]?.src);
const bottleAlt = (p: Perfume): string => p.images[0]?.alt || `${p.brand} ${p.name}`;

// Links de la matriz de familias a páginas reales de /familias/ cuando existen.
const familias = getFamilias();
const norm = (v: string) => v.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
const familiaLink = (keyword: string): string | null => {
  const f = familias.find((x) => norm(x.name).includes(norm(keyword)));
  return f ? `${BASE}familias/${f.slug}/` : null;
};

const matrix = [
  { anchorWord: 'Amaderada', accentWord: 'Cítrica', verdict: 'Clásico seguro', note: 'La madera sostiene; lo liviano levanta la salida sin pelearse.' },
  { anchorWord: 'Oriental vainilla', accentWord: 'Aromática verde', verdict: 'Dulce cortado', note: 'El mentolado corta el azúcar: gourmand usable de día.' },
  { anchorWord: 'Cuero', accentWord: 'Floral frutal', verdict: 'Noche sin gritar', note: 'El floral doman el cuero: contraste que se recuerda sin saturar.' },
  { anchorWord: 'Almizcle', accentWord: 'Dulce especiado', verdict: 'Limpio con carácter', note: 'Prolijo de día, cálido de cerca. El almizcle cose todo.' },
  { anchorWord: 'Oriental', accentWord: 'Oriental vainilla', verdict: 'Cuidado', note: 'Dos anclas densas se pisan. Si los amás, 1 spray de cada uno y nada más.' },
  { anchorWord: 'Gourmand', accentWord: 'Gourmand', verdict: 'Sobredosis', note: 'Excepción: si uno es claramente más liviano que el otro, puede cerrar.' },
];

// Ejemplos reales del stock para "qué evitar": pares que el propio combinador
// puntúa como "cuidado". Mismos ids que valida `layering.spec.ts`.
const avoidExamples = [
  { key: 'dos-potentes', a: 'ameer-al-oudh', b: 'asad-elixir' },
  { key: 'dos-dulces', a: 'angham', b: 'yara' },
];

// FAQ compartida entre el `<Faq>` visible y el JSON-LD FAQPage.
const faq = [
  {
    question: '¿Qué perfume va primero?',
    answer: 'El más denso siempre va primero: amaderados, oud, vainillas, cueros, especidos. Sobre esa base, 30 a 60 segundos después, va el más liviano: cítricos, frescos, acuosos, florales. Es una heurística, no una ley: si tenés dos perfumes parecidos, probá los dos órdenes y quedate con el que leas mejor.',
  },
  {
    question: '¿Se pueden mezclar marcas distintas?',
    answer: 'Sí, y es lo más común: el layering justamente libera combinaciones entre casas. Nuestro catálogo completa los pairs con perfumes de Armaf, Lattafa, Maison Alhambra y otras marcas sin problema. Lo único que no se mezcla es el líquido dentro del frasco: las capas van sobre la piel.',
  },
  {
    question: '¿Cuántos sprays uso?',
    answer: '1 o 2 de cada perfume, no 2 de cada uno por las dudas. La regla: la dosis TOTAL no tiene que ser mayor a la de un solo perfume solo. Si arrancás con 2 del de abajo, ponele 1 arriba. Siempre podés sumar un spray más al rato; quitar no se puede.',
  },
  {
    question: '¿El layering hace que el perfume dure más?',
    answer: 'No es un truco de duración, y desconfiá de quien te lo prometa. Lo que sí pasa: el ancla (la capa densa) suele ser más longeva que el acento, así que a medida que el acento se apaga, queda tu base sonando con otro carácter. Ganás evolución, no necesariamente horas.',
  },
  {
    question: '¿Mancha la ropa?',
    answer: 'Puede, sobre todo en telas claras o de seda: los perfumes árabes concentrados tienen óleos y colorantes. Rociá sobre la piel, dejá secar y recién ahí te vestís. Si querés perfume en la ropa, probá primero en una costura interna.',
  },
  {
    question: 'Tengo piel sensible. ¿Puedo hacer layering?',
    answer: 'Con más precaución, no con prohibición. Hacé la prueba de contacto abierta (ROAT): aplicá la mezcla en un parche chico del antebrazo dos veces por día durante una semana. Si no hay rojeces ni picazón, aléate. Y menos sprays en total: con piel sensible, menos es más.',
  },
  {
    question: '¿Cuál es la forma más fácil de empezar?',
    answer: 'Una de las combos curadas de esta guía, en decants de 5 ml: dos decants chicos, los probás una semana en capas y recién ahí decidís si querés los frascos. El combinador de arriba te deja testear cualquier par antes de comprar.',
  },
];

const faqSchema = faq.map((f) => ({
  '@type': 'Question',
  name: f.question,
  acceptedAnswer: { '@type': 'Answer', text: f.answer },
}));

// Payload mínimo para el combinador cliente: solo lo que lee layeringAffinity
// (name, olfactoryFamily, notes) + precio/id/slug/imagen para la UI. Nada de
// duplicar el JSON completo en el bundle.
const clientPerfumes = inStock.map((p) => ({
  id: p.id,
  slug: p.slug,
  name: p.name,
  brand: p.brand,
  family: p.olfactoryFamily,
  notes: { top: p.notes.top, heart: p.notes.heart, base: p.notes.base },
  price: decantPrice(p) ?? 0,
  img: bottleSrc(p),
  w: dimsFor(p).width,
  h: dimsFor(p).height,
}));

const pageTitle = 'Layering: cómo combinar perfumes';
const pageDescription = `Guía de layering para combinar dos perfumes en capas: ancla abajo, acento arriba. Probá cualquier par en el combinador y llevá los dos en decants de 5 ml con entrega en ${site.addressLocality}.`;
const preloadImages = star ? [star.anchor.images[0]?.src, star.accent.images[0]?.src].filter(Boolean) : [];

// URLs para los JSON-LD: se resuelven en el frontmatter (los scripts inline
// viajan dentro del slot de Layout y allá `Astro` no está en scope).
const schemaAuthorUrl = Astro.site ?? new URL(Astro.url.href);
const schemaPageUrl = new URL(Astro.url.pathname, Astro.site).href;
const schemaSiteOrigin = `${Astro.site?.origin}${site.basePath}`;

// Secciones de la navegación interna sticky (id → etiqueta corta).
const navItems = [
  { id: 'que-es', label: 'Qué es' },
  { id: 'ly-combinador', label: 'Combinador' },
  { id: 'combos', label: 'Combos' },
  { id: 'como-se-hace', label: 'Cómo' },
  { id: 'matriz', label: 'Familias' },
  { id: 'seguridad', label: 'Seguridad' },
  { id: 'faq', label: 'FAQ' },
];

const meterTicks = (score: number): number => Math.max(0, Math.min(10, Math.round(score)));
---

<Layout
  title={pageTitle}
  description={pageDescription}
  ogImage="og-image.jpg"
  ogType="article"
  preloadImages={preloadImages}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqSchema,
  }).replace(/</g, '\\u003c')} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: pageTitle,
    description: pageDescription,
    inLanguage: 'es-AR',
    datePublished: '2026-11-06',
    author: { '@type': 'Organization', name: site.namePlain, url: schemaAuthorUrl },
    publisher: { '@type': 'Organization', name: site.namePlain, url: schemaAuthorUrl },
    mainEntityOfPage: schemaPageUrl,
  }).replace(/</g, '\\u003c')} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: schemaSiteOrigin },
      { '@type': 'ListItem', position: 2, name: 'Layering' },
    ],
  }).replace(/</g, '\\u003c')} />

  <script is:inline id="layering-data" type="application/json" set:html={JSON.stringify(clientPerfumes).replace(/</g, '\\u003c')} />

  <article class="ly" data-base={BASE}>
    {/* ================= 1 · HERO editorial con combo estrella ================= */}
    {star && (
      <section class="ly-hero" aria-labelledby="ly-title">
        <div class="container">
          <nav class="ly-breadcrumb" aria-label="Migas de pan">
            <ol>
              <li><a href={BASE}>Inicio</a></li>
              <li aria-current="page">Layering</li>
            </ol>
          </nav>
          <p class="ly-kicker">Guía de layering · 5 min</p>
          <h1 id="ly-title" class="page-title ly-title">Layering: cómo combinar perfumes</h1>
          <p class="ly-sub">
            Dos perfumes en capas: el denso abajo, el liviano arriba.
            <span class="ly-sub-2">Se leen como un solo perfume.</span>
          </p>

          <div class="ly-star" aria-label={`Combo estrella: ${star.title}`}>
            <div class="ly-star-pair">
              <figure class="ly-bottle">
                <span class="ly-role-tag ly-role-tag--base">Base</span>
                <img
                  src={bottleSrc(star.anchor)}
                  alt={bottleAlt(star.anchor)}
                  width={dimsFor(star.anchor).width}
                  height={dimsFor(star.anchor).height}
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
                <figcaption>{star.anchor.name}</figcaption>
              </figure>
              <span class="ly-star-plus" aria-hidden="true">+</span>
              <figure class="ly-bottle">
                <span class="ly-role-tag ly-role-tag--accent">Acento</span>
                <img
                  src={bottleSrc(star.accent)}
                  alt={bottleAlt(star.accent)}
                  width={dimsFor(star.accent).width}
                  height={dimsFor(star.accent).height}
                  loading="eager"
                  decoding="async"
                />
                <figcaption>{star.accent.name}</figcaption>
              </figure>
            </div>
            <div class="ly-star-copy">
              <p class="ly-star-title">{star.title}</p>
              <p class="ly-star-why">{star.why}</p>
              <p class="ly-star-price">
                <strong>{formatPrice(star.total)}</strong> el par · 2 decants de {DECANT_ML} ml
              </p>
              <div class="ly-star-actions">
                <a href="#ly-combinador" class="btn btn--primary btn--md">Probá tu combinación</a>
                <button
                  type="button"
                  class="btn btn--secondary btn--md"
                  data-combo-add
                  data-anchor={star.anchor.id}
                  data-accent={star.accent.id}
                >
                  Probalos juntos
                </button>
              </div>
              <p class="ly-trust">
                <span>Originales y sellados</span>
                <span aria-hidden="true">·</span>
                <span>Entrega en {site.addressLocality}</span>
                {hasResenas && (
                  <>
                    <span aria-hidden="true">·</span>
                    <span>{resenasRating.ratingValue.toFixed(1).replace('.', ',')}★ en Google ({resenasRating.reviewCount} reseñas)</span>
                  </>
                )}
              </p>
            </div>
          </div>
        </div>
      </section>
    )}

    {/* ============ Navegación interna sticky (bajo el header) ============ */}
    <nav class="ly-nav" aria-label="Secciones de la guía">
      <div class="ly-nav-inner">
        <ul class="ly-nav-list">
          {navItems.map((item) => (
            <li><a class="ly-nav-link" href={`#${item.id}`} data-nav-link={item.id}>{item.label}</a></li>
          ))}
        </ul>
      </div>
    </nav>

    {/* ================= 2 · Qué es / qué no es ================= */}
    <section class="ly-section" id="que-es" aria-labelledby="ly-que-es">
      <div class="container ly-prose">
        <h2 id="ly-que-es" class="ly-h2"><span class="ly-num" aria-hidden="true">01</span>Qué es el layering (y qué no)</h2>
        <p>
          Layering es aplicarte dos perfumes (máximo tres) en capas sobre la piel: primero el más
          denso, esperás medio minuto, y encima el más liviano. Bien hecho, no se siente como dos
          perfumes peleando: se siente como <em>un</em> perfume con más matices. La técnica vive en
          los roles.
        </p>
        <div class="ly-roles" role="list" aria-label="Los tres roles del layering">
          <div class="ly-role" role="listitem">
            <p class="ly-role-word"><dfn class="ly-dfn" title="El perfume más denso; va primero y sostiene el conjunto">Ancla</dfn></p>
            <p>El más denso (madera, oud, vainilla, cuero). Va primero y da estructura.</p>
          </div>
          <div class="ly-role" role="listitem">
            <p class="ly-role-word"><dfn class="ly-dfn" title="El perfume más liviano; va arriba y aporta brillo">Acento</dfn></p>
            <p>El más liviano (cítrico, fresco, floral). Va arriba y da luz.</p>
          </div>
          <div class="ly-role" role="listitem">
            <p class="ly-role-word"><dfn class="ly-dfn" title="Una nota que comparten los dos perfumes y cose la mezcla">Nota puente</dfn></p>
            <p>Una nota que comparten los dos: es lo que hace que se lean juntos.</p>
          </div>
        </div>
        <p>
          Lo que <strong>no</strong> es: mezclar líquidos dentro de un frasco (eso arruina dos perfumes),
          sumar dosis para "durar el doble" (no lo prometemos: lo que gana es evolución, no horas), ni una
          fórmula química con garantía. Es heurística de perfumistas y de la comunidad. La
          <dfn class="ly-dfn" title="La mezcla final que resulta de superponer las capas">blending</dfn>
          sale distinta en cada piel: por eso la forma barata de probarla son dos decants de 5 ml, no dos frascos.
        </p>
      </div>
    </section>

    <figure class="ly-quote">
      <blockquote>
        <p>Layering no es mezclar: es superponer. Si a los veinte minutos se siente como un solo perfume, va por buen camino.</p>
      </blockquote>
    </figure>

    {/* ================= 3 · Combinador interactivo ================= */}
    <section class="ly-section ly-section--tint" id="ly-combinador" aria-labelledby="ly-combinador-title">
      <div class="container">
        <p class="ly-kicker">Herramienta</p>
        <h2 id="ly-combinador-title" class="ly-h2"><span class="ly-num" aria-hidden="true">02</span>Elegí dos perfumes con stock y mirá qué sale</h2>
        <p class="ly-hint">
          El veredicto usa notas compartidas y roles (densa abajo, liviana arriba). Es una guía, no una sentencia:
          el narices manda siempre.
        </p>
        <noscript>
          <p class="ly-noscript">Sin JavaScript el combinador no recalcula: te dejamos igual el veredicto del par estrella, y las combos curadas de abajo funcionan igual (se muestran todas).</p>
        </noscript>

        <div class="ly-comb">
          <div class="ly-comb-controls">
            <div class="ly-field ly-field--search">
              <label for="ly-search">Buscar en el catálogo</label>
              <input
                id="ly-search"
                type="search"
                placeholder="Nombre o marca… (ej. oud, Lattafa)"
                autocomplete="off"
                data-search
              />
            </div>
            <div class="ly-pickers">
              <div class="ly-field">
                <label for="ly-a">Perfume A</label>
                <select id="ly-a" name="a" data-combo-select>
                  {roleGroups.map((g) => (
                    <optgroup label={g.label}>
                      {g.items.map((p) => (
                        <option value={p.id} selected={p.id === defA.id}>{p.name} — {p.brand}</option>
                      ))}
                    </optgroup>
                  ))}
                </select>
              </div>
              <button type="button" class="ly-swap" data-swap aria-label="Intercambiar los perfumes">⇄</button>
              <div class="ly-field">
                <label for="ly-b">Perfume B</label>
                <select id="ly-b" name="b" data-combo-select>
                  {roleGroups.map((g) => (
                    <optgroup label={g.label}>
                      {g.items.map((p) => (
                        <option value={p.id} selected={p.id === defB.id}>{p.name} — {p.brand}</option>
                      ))}
                    </optgroup>
                  ))}
                </select>
              </div>
            </div>
            <p class="ly-controls-note">La búsqueda solo filtra la lista; el catálogo completo sigue intacto.</p>
          </div>

          <div class="ly-result" id="ly-result" aria-live="polite">
            <div class="ly-preview" aria-hidden="true">
              <figure class="ly-bottle ly-bottle--prev">
                <span class="ly-role-tag ly-role-tag--base">Base</span>
                <img
                  src={bottleSrc(defAff.anchor)}
                  alt=""
                  width={dimsFor(defAff.anchor).width}
                  height={dimsFor(defAff.anchor).height}
                  loading="lazy"
                  decoding="async"
                  data-preview-img="anchor"
                />
              </figure>
              <span class="ly-preview-plus">+</span>
              <figure class="ly-bottle ly-bottle--prev">
                <span class="ly-role-tag ly-role-tag--accent">Acento</span>
                <img
                  src={bottleSrc(defAff.accent)}
                  alt=""
                  width={dimsFor(defAff.accent).width}
                  height={dimsFor(defAff.accent).height}
                  loading="lazy"
                  decoding="async"
                  data-preview-img="accent"
                />
              </figure>
            </div>
            <div class="ly-meter" data-affinity-meter role="img" aria-label={`Afinidad ${meterTicks(defAff.score)}/10 · ${verdictMeta[defAff.verdict].label}`}>
              <span class:list={['ly-meter-label', `ly-meter-label--${defAff.verdict}`]}>{meterTicks(defAff.score)}/10</span>
              <span class="ly-meter-track" aria-hidden="true">
                {Array.from({ length: 10 }, (_, i) => (
                  <span class:list={['ly-tick', { 'ly-tick--on': i < meterTicks(defAff.score) }]} data-tick={i} />
                ))}
              </span>
            </div>
            <p class:list={['ly-verdict', verdictMeta[defAff.verdict].className]}>
              {verdictMeta[defAff.verdict].label}
            </p>
            <ol class="ly-order">
              <li><span class="ly-order-tag">Abajo · ancla</span> <a href={`${BASE}producto/${defAff.anchor.slug}/`} class="ly-inline-link">{defAff.anchor.name}</a></li>
              <li><span class="ly-order-tag ly-order-tag--accent">Arriba · acento</span> <a href={`${BASE}producto/${defAff.accent.slug}/`} class="ly-inline-link">{defAff.accent.name}</a></li>
            </ol>
            {defAff.shared.length > 0 && (
              <ul class="ly-shared" aria-label="Notas puente">
                {defAff.shared.map((n) => <li class="ly-note-chip">{n}</li>)}
              </ul>
            )}
            <p class="ly-ratio"><span class="ly-ratio-label">Proporción sugerida</span>{defAff.ratio}</p>
            <p class="ly-reason">{defAff.reason}</p>
          </div>

          <div class="ly-actions" id="ly-actions">
            <button
              type="button"
              class="btn btn--primary btn--lg ly-add"
              data-combo-add
              data-anchor={defAff.anchor.id}
              data-accent={defAff.accent.id}
            >
              Agregar los dos ({DECANT_ML} ml) · <span data-pair-total>{formatPrice(defTotal)}</span>
            </button>
            <div class="ly-actions-side">
              <button type="button" class="ly-copy" data-copy-link>Copiar link</button>
              <p class="ly-copy-status" data-copy-status role="status" aria-live="polite"></p>
              <p class="ly-fichas">
                Fichas: <a href={`${BASE}producto/${defAff.anchor.slug}/`} class="ly-inline-link" data-ficha-a>{defAff.anchor.name}</a>
                {' · '}
                <a href={`${BASE}producto/${defAff.accent.slug}/`} class="ly-inline-link" data-ficha-b>{defAff.accent.name}</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ================= 4 · Las combos curadas ================= */}
    <section class="ly-section" id="combos" aria-labelledby="ly-combos-title">
      <div class="container">
        <p class="ly-kicker">Curaduría</p>
        <div class="ly-combos-head">
          <h2 id="ly-combos-title" class="ly-h2"><span class="ly-num" aria-hidden="true">03</span>{comboViews.length} pares que ya probamos por vos</h2>
          <div class="ly-sort" role="group" aria-label="Orden de las combos" data-filters hidden>
            <button type="button" class="ly-chip ly-chip--sort" data-sort="curaduria" aria-pressed="true">Curaduría</button>
            <button type="button" class="ly-chip ly-chip--sort" data-sort="afinidad" aria-pressed="false">Afinidad</button>
          </div>
        </div>
        <p class="ly-hint">Cada par existe en decants de 5 ml, con stock real. Las notas puente están calculadas sobre las fichas del catálogo.</p>

        {/* Filtros: solo con JS (sin JS se muestran todas las combos tal cual). */}
        <div class="ly-filters" data-filters hidden>
          <div class="ly-filter-group" role="group" aria-label="Filtrar por estación">
            <span class="ly-filter-label" aria-hidden="true">Estación</span>
            <ul class="ly-filter-chips">
              <li><button type="button" class="ly-chip" data-season="todas" aria-pressed="true">Todas</button></li>
              <li><button type="button" class="ly-chip" data-season="primavera" aria-pressed="false">Primavera</button></li>
              <li><button type="button" class="ly-chip" data-season="verano" aria-pressed="false">Verano</button></li>
              <li><button type="button" class="ly-chip" data-season="otono" aria-pressed="false">Otoño</button></li>
              <li><button type="button" class="ly-chip" data-season="invierno" aria-pressed="false">Invierno</button></li>
            </ul>
          </div>
          <div class="ly-filter-group" role="group" aria-label="Filtrar por momento">
            <span class="ly-filter-label" aria-hidden="true">Momento</span>
            <ul class="ly-filter-chips">
              <li><button type="button" class="ly-chip" data-moment="todos" aria-pressed="true">Todos</button></li>
              <li><button type="button" class="ly-chip" data-moment="dia" aria-pressed="false">Día</button></li>
              <li><button type="button" class="ly-chip" data-moment="noche" aria-pressed="false">Noche</button></li>
            </ul>
          </div>
          <div class="ly-filter-group" role="group" aria-label="Filtrar por familia del ancla">
