      <div class="container">
        <p class="ly-kicker">Referencia rápida</p>
        <h2 id="ly-matriz-title" class="ly-h2"><span class="ly-num" aria-hidden="true">05</span>Matriz de familias: base × acento</h2>
        <div class="ly-table-wrap">
          <table class="ly-table">
            <caption class="ly-table-caption">Qué esperar cuando una familia funciona de ancla y otra de acento.</caption>
            <thead>
              <tr>
                <th scope="col">Base (abajo)</th>
                <th scope="col">Acento (arriba)</th>
                <th scope="col">Qué esperar</th>
              </tr>
            </thead>
            <tbody>
              {matrix.map((row) => {
                const aLink = familiaLink(row.anchorWord);
                const bLink = familiaLink(row.accentWord);
                return (
                  <tr>
                    <th scope="row" data-label="Base (abajo)">
                      {aLink ? <a href={aLink} class="ly-inline-link">{row.anchorWord}</a> : row.anchorWord}
                    </th>
                    <td data-label="Acento (arriba)">
                      {bLink ? <a href={bLink} class="ly-inline-link">{row.accentWord}</a> : row.accentWord}
                    </td>
                    <td data-label="Qué esperar">
                      <span class={`ly-cell-verdict ${row.verdict === 'Cuidado' || row.verdict === 'Sobredosis' ? 'ly-cell-verdict--warn' : 'ly-cell-verdict--ok'}`}>{row.verdict}</span>
                      <span class="ly-cell-note">{row.note}</span>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
