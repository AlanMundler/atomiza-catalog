---
import Layout from '@/layouts/Layout.astro';
import ProductCard from '@/components/catalog/ProductCard.astro';
import TridenteModal from '@/components/cart/TridenteModal.astro';
import perfumesData from '@/data/perfumes.json';
import { isSizeAvailable } from '@/utils/stock';
import { resenas, resenasRating, hasResenas } from '@/data/resenas';
import { site } from '@/site.config';
import { TRIDENT_DISCOUNT, TRIDENT_BULK_PER_DECANT } from '@/utils/trident';
import { formatPrice } from '@/utils/formatters';
import type { Perfume } from '@/data/types';

const BASE = site.basePath;

const homeDescription = `${site.name}. ${site.tagline} en ${site.addressLocality}, ${site.addressRegion}. ${site.description}`;
// Título con keyword local: es lo que busca quien quiere comprar perfumes árabes
// en Córdoba. El "decants" + ciudad diferencia a ATOMIZA de otros "ATOMIZA" del mundo.
const homeTitle = `Perfumes árabes en decants · ${site.addressLocality}`;
// Perfumes in stock to rotate on the home page
const allPerfumes = perfumesData.perfumes as Perfume[];
const inStockPerfumes = allPerfumes.filter((perfume) => {
  const primary = perfume.sizes.find((s) => s.ml === 5) || perfume.sizes[0];
  return primary ? isSizeAvailable(primary) : false;
});

/**
 * Mezcla determinista por día de build (mulberry32): el SSR pinta los 4
 * finales directo, sin `hidden` ni shuffle en cliente. Antes se renderizaba
 * todo el catálogo oculto y se reordenaba tras el primer paint (CLS + HTML
 * desperdiciado + preload que no coincidía). Rota solo con cada deploy.
 */
function pickDaily<T>(items: T[], n: number, seed: number): T[] {
  const pool = [...items];
  let s = seed >>> 0 || 1;
  const rand = () => {
    s |= 0;
    s = (s + 0x6d2b79f5) | 0;
    let t = Math.imul(s ^ (s >>> 15), 1 | s);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
  for (let i = pool.length - 1; i > 0; i--) {
    const j = Math.floor(rand() * (i + 1));
    [pool[i], pool[j]] = [pool[j], pool[i]];
  }
  return pool.slice(0, n);
}

const homePerfumes = pickDaily(inStockPerfumes, 4, Math.floor(Date.now() / 86400000));
// FAQ real de la home: el JSON-LD FAQPage refleja exactamente el contenido visible
const faqs = [
  {
    question: '¿Los decants son originales?',
    answer: 'Sí. Cada decant sale de un frasco original y sellado.',
  },
  {
    question: '¿Qué es un decant?',
    answer: 'Es una porción de perfume pasada de un frasco original a una botellita de 5ml. Alcanza para probar la fragancia unos días antes de decidir si querés el frasco completo.',
  },
  {
    question: '¿Cuánto dura un decant de 5ml?',
    answer: '5ml alcanza para usar la fragancia varios días seguidos y decidir con calma si querés el frasco completo.',
  },
  {
    question: '¿Cómo hago mi pedido?',
    answer: 'Sumá los decants que quieras, completá tu nombre y contacto, y enviá el pedido por WhatsApp o Instagram. Te respondemos para coordinar.',
  },
  {
    question: '¿Cómo se coordina el envío y el pago?',
    answer: 'El envío y el pago se coordinan por mensaje, a tu medida, una vez que enviás tu pedido.',
  },
  {
    question: '¿Qué pasa si no me gusta la fragancia?',
    answer: 'Por eso existen los decants: probás la fragancia unos días antes de comprometerte con el frasco completo. Si necesitás asesoramiento, escribinos y te ayudamos a elegir.',
  },
    {
      question: '¿Puedo armar un tridente?',
      answer: `Sí, y es automático: 3 decants te descuentan ${formatPrice(TRIDENT_DISCOUNT)} y con 6 o más, $1.000 por decant. No tenés que armar nada, se aplica solo.`,
    },
  {
    question: '¿Cuánto tarda en llegar mi pedido?',
    answer: 'Depende de tu ubicación. Coordinamos los tiempos por mensaje después de que hacés tu pedido.',
  },
] as const;
---

<Layout title={homeTitle} description={homeDescription} preloadImages={homePerfumes[0] ? [homePerfumes[0].images[0]?.src] : []}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  }).replace(/</g, '\\u003c')} />
  <button type="button" class="promo-strip" data-open-tridente aria-haspopup="dialog" aria-label={`Ver promociones: 3 decants ${formatPrice(TRIDENT_DISCOUNT)} menos, 6 ${formatPrice(TRIDENT_BULK_PER_DECANT * 6)} menos, 9 ${formatPrice(TRIDENT_BULK_PER_DECANT * 9)} menos`}>
    <span aria-hidden="true">🎁</span>
    <strong class="promo-strip-label" aria-hidden="true">Promociones:</strong>
    <span class="promo-strip-items" aria-hidden="true">
      <span class="promo-strip-item active" data-promo-item><strong>3</strong> → {formatPrice(TRIDENT_DISCOUNT)} menos</span>
      <span class="promo-strip-item" data-promo-item><strong>6</strong> → {formatPrice(TRIDENT_BULK_PER_DECANT * 6)} menos</span>
      <span class="promo-strip-item" data-promo-item><strong>9</strong> → {formatPrice(TRIDENT_BULK_PER_DECANT * 9)} menos</span>
    </span>
    <span class="promo-strip-cta" aria-hidden="true">Ver →</span>
  </button>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="container">
      <h1 id="hero-heading" class="hero-title">{site.hero.title} <strong>{site.hero.titleHighlight}</strong></h1>
      <p class="hero-subtitle">{site.hero.subtitle}</p>
      <p class="hero-price-note">{site.hero.priceNote}</p>
      <div class="hero-cta">
        <a href={`${BASE}catalogo/`} class="btn btn--primary btn--lg">{site.hero.ctaPrimary}</a>
      </div>
      <p class="hero-alt">
        ¿No sabés por dónde empezar? <a href={`${BASE}quiz/`}>{site.hero.ctaSecondary}</a> o <a href={`${BASE}tridentes/`}>{site.hero.ctaTertiary}</a>
      </p>
    </div>
  </section>

  <TridenteModal />

  <section class="home-perfumes" aria-labelledby="home-perfumes-title">
    <div class="container">
      <div class="home-perfume-head">
        <h2 id="home-perfumes-title" class="section-title">Decants en stock</h2>
      </div>
      <div class="home-perfume-grid" id="home-perfume-grid">
        {homePerfumes.map((perfume) => (
          <div class="home-perfume-item">
            <ProductCard perfume={perfume} eager />
          </div>
        ))}
      </div>
      <a href={`${BASE}catalogo/`} class="home-perfumes-cta">Ver todo el catálogo →</a>
    </div>
  </section>

  <section class="aroma-band" aria-labelledby="aroma-band-title">
    <div class="container">
      <div class="aroma-band-inner">
        <div class="aroma-band-text">
          <h2 id="aroma-band-title" class="aroma-band-title">Buscá por el aroma famoso que te gusta</h2>
          <p class="aroma-band-sub">
            ¿Te gusta cómo huele Baccarat Rouge, Sauvage o Delina? Tenemos el decant inspirado en cada uno.
          </p>
        </div>
        <a href={`${BASE}decants/`} class="btn btn--primary btn--md">Ver aromas famosos</a>
      </div>
    </div>
  </section>

  <section class="value-prop" aria-labelledby="value-prop-title">
    <div class="container">
      <h2 id="value-prop-title" class="section-title">Por qué elegir {site.name}</h2>
      <div class="value-prop-grid">
        <article class="value-prop-card">
          <div class="value-prop-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3 class="value-prop-card-title">Autenticidad</h3>
          <p class="value-prop-card-text">Cada decant sale de un frasco original y sellado.</p>
        </article>
        <article class="value-prop-card">
          <div class="value-prop-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M2 12h20"></path>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </div>
          <h3 class="value-prop-card-title">Variedad árabe</h3>
          <p class="value-prop-card-text">Decants de perfumería árabe para probar antes de comprar el frasco completo.</p>
        </article>
        <article class="value-prop-card">
          <div class="value-prop-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <h3 class="value-prop-card-title">Atención por mensaje</h3>
          <p class="value-prop-card-text">Te asesoramos para elegir, y el envío y el pago los coordinamos por mensaje.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="social-proof" aria-labelledby="social-proof-title">
    <div class="container">
      <h2 id="social-proof-title" class="section-title">Lo que dicen nuestros clientes</h2>
      {hasResenas && (
      <div class="reviews-grid">
        {resenas.map((r) => (
          <article class="review-card">
            <div class="review-stars" aria-label={`${r.rating} de 5 estrellas`} role="img">
              {'★'.repeat(r.rating)}{'☆'.repeat(Math.max(0, 5 - r.rating))}
            </div>
            <p class="review-text">"{r.text}"</p>
            <p class="review-name">{r.name} · {r.locality}{r.perfume ? ` · ${r.perfume}` : ''}</p>
          </article>
        ))}
      </div>
      )}

      {hasResenas && (
      <p class="reviews-note">
        {resenasRating.ratingValue} de 5, según {resenasRating.reviewCount} reseñas de clientes reales.
      </p>
      )}

      {site.googleReviewsUrl && !hasResenas && (
        <div class="reviews-cta-inline">
          <p class="reviews-cta-text">¿Ya probaste un decant? Tu opinión ayuda a que más gente pruebe perfumes árabes sin miedo. Dejá tu reseña en Google, nos re ayuda.</p>
          <a
            href={site.googleReviewsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="reviews-cta-btn"
          >
            Dejar mi reseña
          </a>
        </div>
      )}
    </div>
  </section>

  <section class="how-to-buy" aria-labelledby="how-to-buy-title">
    <div class="container">
      <h2 id="how-to-buy-title" class="section-title">Cómo comprar</h2>
      <div class="grid grid-cols-1 gap-[var(--spacing-stack-md)] sm:grid-cols-2 lg:grid-cols-4">
        <article class="step">
          <div class="step-number">01</div>
          <div class="step-content">
            <h3 class="step-title">Buscá</h3>
            <p class="step-text">Recorré el catálogo, filtrá por género o buscá tu fragancia por nombre.</p>
          </div>
        </article>
        <article class="step">
          <div class="step-number">02</div>
          <div class="step-content">
            <h3 class="step-title">Sumala</h3>
            <p class="step-text">Cada decant es de 5ml. Agregalo al pedido y ajustá la cantidad.</p>
          </div>
        </article>
        <article class="step">
          <div class="step-number">03</div>
          <div class="step-content">
            <h3 class="step-title">Finalizá</h3>
            <p class="step-text">Completá tu nombre y contacto. El resumen del pedido se arma solo.</p>
          </div>
        </article>
        <article class="step">
          <div class="step-number">04</div>
          <div class="step-content">
            <h3 class="step-title">Coordiná</h3>
            <p class="step-text">Enviá el pedido por WhatsApp o Instagram y coordinamos envío y pago. <a href={`${BASE}envios/`} class="step-link">Ver opciones de envío</a></p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="faq" aria-labelledby="faq-title">
    <div class="container">
      <h2 id="faq-title" class="section-title">Preguntas frecuentes</h2>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary>{faq.question}</summary>
            <p class="faq-answer">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script>
    import { bindOnce, onPageLoad } from '@/utils/view-transitions';
    import { tridenteProgressText } from '@/utils/tridente-live';

    // Tira de promociones: abre el modal con la regla y tu progreso en vivo.
    onPageLoad('tridente-strip', () => {
      const strip = document.querySelector('[data-open-tridente]');
      const modal = document.querySelector('#tridente-modal');
      if (!strip || !modal) return;
      bindOnce(strip, (el) => {
        el.addEventListener('click', async () => {
          const live = modal.querySelector('[data-tridente-live]');
          if (live) live.textContent = await tridenteProgressText();
          modal.dispatchEvent(new CustomEvent('modal:open'));
        });
      });
    });

    // Rotación de promos en celu (en PC se ven las 3 fijas). Sin movimiento
    // si el usuario prefiere movimiento reducido; se frena sola si el DOM
    // cambia (navegación SPA) para no dejar intervalos huérfanos.
    onPageLoad('tridente-strip-rotate', () => {
      if (window.__atzPromoRot) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const items = Array.from(document.querySelectorAll('[data-promo-item]'));
      if (items.length < 2) return;
      let i = 0;
      window.__atzPromoRot = window.setInterval(() => {
        if (!items[0].isConnected) {
          window.clearInterval(window.__atzPromoRot);
          window.__atzPromoRot = 0;
          return;
        }
        items[i].classList.remove('active');
        i = (i + 1) % items.length;
        items[i].classList.add('active');
      }, 4000);
    });

  </script>
</Layout>

<style>
  .hero {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 48px 0 40px;
  }

  .hero-title {
    font-family: var(--font-family);
    font-size: var(--font-display-lg-size);
    font-weight: var(--font-display-lg-weight);
    line-height: var(--font-display-lg-line-height);
    letter-spacing: var(--font-display-lg-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
    margin: 0;
  }

  .hero-title strong {
    color: var(--color-primary);
  }

  .hero-subtitle {
    font-family: var(--font-family);
    font-size: var(--font-body-lg-size);
    line-height: var(--font-body-lg-line-height);
    letter-spacing: var(--font-body-lg-tracking);
    color: var(--color-on-surface-variant);
    max-width: 640px;
    margin: var(--spacing-stack-sm) auto 0;
  }

  .hero-price-note {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-primary);
    margin: var(--spacing-stack-sm) 0 0;
  }

  .hero-cta {
    display: flex;
    justify-content: center;
    margin-top: var(--spacing-stack-md);
  }

  .hero-cta .btn {
    min-height: 52px;
    padding-inline: 36px;
  }

  .hero-alt {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    color: var(--color-on-surface-variant);
    text-align: center;
    margin: var(--spacing-stack-sm) 0 0;
  }

  .hero-alt a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Tira de promociones a todo el ancho, pegada al header: abre el modal
     del tridente sin salir de la home. */
  .promo-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    margin: 0;
    padding: 10px 16px;
    min-height: 48px;
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    color: var(--color-on-surface);
    text-align: center;
    background-color: rgba(197, 160, 89, 0.1);
    border: none;
    border-bottom: var(--border-width) solid var(--color-primary);
    border-radius: 0;
    cursor: pointer;
    transition: background-color var(--transition-duration) var(--transition-easing);
  }

  .promo-strip:hover {
    background-color: rgba(197, 160, 89, 0.15);
  }

  .promo-strip:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .promo-strip strong {
    color: var(--color-primary);
  }

  /* Items apilados para fundido en celu; en PC fluyen en fila. */
  .promo-strip-items {
    display: grid;
    flex: 1 1 auto;
    min-width: 0;
  }

  .promo-strip-item {
    grid-area: 1 / 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-align: center;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
      opacity 0.45s var(--transition-easing),
      transform 0.45s var(--transition-easing),
      visibility 0.45s;
  }

  .promo-strip-item.active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .promo-strip-item strong {
    color: var(--color-primary);
  }

  .promo-strip-label {
    color: var(--color-primary);
    white-space: nowrap;
  }

  /* Celu: una promo por vez, rotando con fundido; todo junto y centrado
     (sin el flex:1 que separaba regalo y CTA a los bordes). */
  @media (max-width: 767px) {
    .promo-strip {
      gap: 8px;
      padding: 10px 12px;
      font-size: 13px;
    }

    .promo-strip-items {
      flex: 0 1 auto;
    }
  }

  /* PC: contenido junto y centrado, con aire entre grupos. */
  @media (min-width: 768px) {
    .promo-strip {
      justify-content: center;
      gap: 28px;
      padding: 10px 32px;
    }

    .promo-strip-items {
      display: contents;
    }

    .promo-strip-item {
      opacity: 1;
      visibility: visible;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .promo-strip-item {
      transition: none;
    }
  }

  .promo-strip-cta {
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-primary);
    white-space: nowrap;
  }

  @media (max-width: 1024px) {
    .hero {
      padding: 20px 0 12px;
    }

    .hero-title {
      font-size: var(--font-headline-lg-mobile-size);
    }

    .hero-subtitle {
      font-size: var(--font-body-md-size);
    }

    .hero-cta {
      width: 100%;
    }

    .hero-cta .btn {
      width: 100%;
      max-width: 320px;
      min-height: 48px;
    }
  }

  .section-title {
    font-family: var(--font-family);
    font-size: var(--font-headline-lg-size);
    font-weight: var(--font-headline-lg-weight);
    line-height: var(--font-headline-lg-line-height);
    letter-spacing: var(--font-headline-lg-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
    text-align: center;
    margin: 0 0 var(--spacing-stack-lg);
  }

  @media (max-width: 640px) {
    .section-title {
      font-size: var(--font-headline-lg-mobile-size);
    }
  }

  /* Aroma hub band */
  .aroma-band {
    padding: var(--spacing-stack-lg) 0;
    border-top: var(--border-width) solid var(--color-outline-variant);
    border-bottom: var(--border-width) solid var(--color-outline-variant);
    background-color: var(--color-surface-container);
  }

  .aroma-band-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-stack-md);
    text-align: center;
  }

  @media (min-width: 768px) {
    .aroma-band-inner {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .aroma-band-title {
    font-family: var(--font-family);
    font-size: var(--font-headline-lg-size);
    font-weight: var(--font-headline-lg-weight);
    line-height: var(--font-headline-lg-line-height);
    letter-spacing: var(--font-headline-lg-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
    margin: 0 0 var(--spacing-stack-sm);
  }

  @media (max-width: 640px) {
    .aroma-band-title {
      font-size: var(--font-headline-lg-mobile-size);
    }
  }

  .aroma-band-sub {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    line-height: var(--font-body-md-line-height);
    color: var(--color-on-surface-variant);
    margin: 0;
  }

  /* Value Prop */
  .value-prop {
    padding: var(--spacing-stack-lg) 0;
    border-top: var(--border-width) solid var(--color-outline-variant);
    border-bottom: var(--border-width) solid var(--color-outline-variant);
  }

  .value-prop-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-stack-md);
  }

  @media (min-width: 768px) {
    .value-prop-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .value-prop-card {
    text-align: center;
    padding: var(--spacing-stack-md);
  }

  .value-prop-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    margin-bottom: var(--spacing-stack-sm);
    color: var(--color-primary);
  }

  .value-prop-card-title {
