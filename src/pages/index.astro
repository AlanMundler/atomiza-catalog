---
import Layout from '@/layouts/Layout.astro';
import ProductCard from '@/components/catalog/ProductCard.astro';
import perfumesData from '@/data/perfumes.json';
import { isSizeAvailable } from '@/utils/stock';
import { site } from '@/site.config';
import { buildWhatsAppLink } from '@/utils/formatters';
import type { Perfume } from '@/data/types';

const BASE = site.basePath;
const whatsappLink = buildWhatsAppLink(site.whatsappNumber, site.whatsappMessage);

// Perfumes in stock to rotate on the home page
const allPerfumes = perfumesData.perfumes as Perfume[];
const inStockPerfumes = allPerfumes.filter((perfume) => {
  const primary = perfume.sizes.find((s) => s.ml === 5) || perfume.sizes[0];
  return primary ? isSizeAvailable(primary) : false;
});
---

<Layout title={site.tagline} description={`${site.name}. ${site.tagline}. ${site.description}`}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container">
      <h1 id="hero-title" class="visually-hidden">{site.tagline}</h1>
      <div class="hero-cta">
        <a href={`${BASE}catalogo/`} class="btn btn--primary btn--lg">Ver catálogo</a>
        <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="btn btn--secondary btn--lg">Consultar por WhatsApp</a>
      </div>
    </div>
  </section>

  <section class="home-perfumes" aria-labelledby="home-perfumes-title">
    <div class="container">
      <div class="home-perfume-head">
        <h2 id="home-perfumes-title" class="section-title">Decants en stock</h2>
      </div>
      <div class="home-perfume-grid" id="home-perfume-grid">
        {inStockPerfumes.map((perfume, index) => (
          <div class="home-perfume-item" hidden={index >= 3}>
            <ProductCard perfume={perfume} />
          </div>
        ))}
      </div>
      <div class="home-perfume-cta">
        <a href={`${BASE}catalogo/`} class="btn btn--secondary btn--lg">Ver todo el catálogo</a>
      </div>
    </div>
  </section>

  <section class="value-prop" aria-labelledby="value-prop-title">
    <div class="container">
      <h2 id="value-prop-title" class="section-title">Por qué elegir {site.name}</h2>
      <div class="value-prop-grid">
        <article class="value-prop-card">
          <div class="value-prop-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3 class="value-prop-card-title">Autenticidad</h3>
          <p class="value-prop-card-text">Cada decant sale de un frasco original y sellado.</p>
        </article>
        <article class="value-prop-card">
          <div class="value-prop-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M2 12h20"></path>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </div>
          <h3 class="value-prop-card-title">Variedad árabe</h3>
          <p class="value-prop-card-text">Decants de perfumería árabe para probar antes de comprar el frasco completo.</p>
        </article>
        <article class="value-prop-card">
          <div class="value-prop-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <h3 class="value-prop-card-title">Atención por mensaje</h3>
          <p class="value-prop-card-text">Te asesoramos para elegir, y el envío y el pago se coordinan por mensaje.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="decant-info" aria-labelledby="decant-info-title">
    <div class="container">
      <h2 id="decant-info-title" class="section-title">¿Qué es un decant?</h2>
      <div class="decant-info-body">
        <p class="decant-info-text">Un decant es una porción de perfume extraída de un frasco original y envasada en uno más chico. Acá cada decant es de 5ml y sale de un frasco original y sellado: suficiente para probar la fragancia unos días antes de comprar el frasco completo.</p>
      </div>
    </div>
  </section>

  <section class="how-to-buy" aria-labelledby="how-to-buy-title">
    <div class="container">
      <h2 id="how-to-buy-title" class="section-title">Cómo comprar</h2>
      <div class="steps">
        <article class="step">
          <div class="step-number">01</div>
          <div class="step-content">
            <h3 class="step-title">Buscá</h3>
            <p class="step-text">Recorré el catálogo, filtrá por género o buscá tu fragancia por nombre.</p>
          </div>
        </article>
        <article class="step">
          <div class="step-number">02</div>
          <div class="step-content">
            <h3 class="step-title">Sumala</h3>
            <p class="step-text">Cada decant es de 5ml. Agregalo al pedido y ajustá la cantidad.</p>
          </div>
        </article>
        <article class="step">
          <div class="step-number">03</div>
          <div class="step-content">
            <h3 class="step-title">Finalizá</h3>
            <p class="step-text">Completá tu nombre y contacto. El resumen del pedido se arma solo.</p>
          </div>
        </article>
        <article class="step">
          <div class="step-number">04</div>
          <div class="step-content">
            <h3 class="step-title">Coordiná</h3>
            <p class="step-text">Enviá el pedido por WhatsApp o Instagram y coordinamos envío y pago.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="faq" aria-labelledby="faq-title">
    <div class="container">
      <h2 id="faq-title" class="section-title">Preguntas frecuentes</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary>¿Los decants son originales?</summary>
          <p class="faq-answer">Sí. Cada decant sale de un frasco original y sellado.</p>
        </details>
        <details class="faq-item">
          <summary>¿Cuánto dura un decant de 5ml?</summary>
          <p class="faq-answer">5ml alcanza para usar la fragancia varios días seguidos y decidir con calma si querés el frasco completo.</p>
        </details>
        <details class="faq-item">
          <summary>¿Cómo hago mi pedido?</summary>
          <p class="faq-answer">Sumá los decants que quieras, completá tu nombre y contacto, y enviá el pedido por WhatsApp o Instagram. Te respondemos para coordinar.</p>
        </details>
        <details class="faq-item">
          <summary>¿Cómo se coordina el envío y el pago?</summary>
          <p class="faq-answer">El envío y el pago se coordinan por mensaje, a tu medida, una vez que enviás tu pedido.</p>
        </details>
      </div>
    </div>
  </section>

  <script>
    import { onPageLoad } from '@/utils/view-transitions';

    // Pick 3 random perfumes from stock on each visit
    onPageLoad('home', () => {
      const grid = document.querySelector('#home-perfume-grid') as HTMLElement | null;
      if (!grid || (grid as any).__vtShuffled) return;
      (grid as any).__vtShuffled = true;

      const items = Array.from(grid.querySelectorAll('.home-perfume-item')) as HTMLElement[];
      if (items.length > 3) {
        const shuffled = items.sort(() => Math.random() - 0.5);
        shuffled.forEach((item, i) => {
          item.hidden = i >= 3;
        });
      }
    });
  </script>
</Layout>

<style>
  .hero {
    text-align: center;
    padding: 12px 0 20px;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 0;
  }

  .section-title {
    font-family: var(--font-family);
    font-size: var(--font-headline-lg-size);
    font-weight: var(--font-headline-lg-weight);
    line-height: var(--font-headline-lg-line-height);
    letter-spacing: var(--font-headline-lg-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
    text-align: center;
    margin: 0 0 var(--spacing-stack-lg);
  }

  @media (max-width: 640px) {
    .section-title {
      font-size: var(--font-headline-lg-mobile-size);
    }
  }

  /* Value Prop */
  .value-prop {
    padding: var(--spacing-stack-lg) 0;
    border-top: var(--border-width) solid var(--color-outline-variant);
    border-bottom: var(--border-width) solid var(--color-outline-variant);
  }

  .value-prop-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-stack-md);
  }

  @media (min-width: 768px) {
    .value-prop-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .value-prop-card {
    text-align: center;
    padding: var(--spacing-stack-md);
  }

  .value-prop-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    margin-bottom: var(--spacing-stack-sm);
    color: var(--color-primary);
  }

  .value-prop-card-title {
    font-family: var(--font-family);
    font-size: var(--font-headline-md-size);
    font-weight: var(--font-headline-md-weight);
    line-height: var(--font-headline-md-line-height);
    letter-spacing: var(--font-headline-md-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
    margin: 0 0 var(--spacing-stack-sm);
  }

  .value-prop-card-text {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    line-height: var(--font-body-md-line-height);
    letter-spacing: var(--font-body-md-tracking);
    color: var(--color-on-surface-variant);
    margin: 0;
  }

  /* How to Buy */
  .how-to-buy {
    padding: var(--spacing-stack-lg) 0;
  }

  .steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-stack-md);
  }

  @media (min-width: 768px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--spacing-stack-sm);
    padding: var(--spacing-stack-md);
    border: var(--border-width) solid var(--color-outline-variant);
    border-radius: var(--border-radius);
  }

  .step-number {
    font-family: var(--font-family);
    font-size: var(--font-headline-lg-size);
    font-weight: var(--font-headline-lg-weight);
    letter-spacing: var(--font-headline-lg-tracking);
    color: var(--color-primary);
  }

  @media (max-width: 640px) {
    .step-number {
      font-size: var(--font-headline-md-size);
    }
  }

  .step-title {
    font-family: var(--font-family);
    font-size: var(--font-headline-md-size);
    font-weight: var(--font-headline-md-weight);
    line-height: var(--font-headline-md-line-height);
    letter-spacing: var(--font-headline-md-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
    margin: 0;
  }

  .step-text {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    line-height: var(--font-body-md-line-height);
    letter-spacing: var(--font-body-md-tracking);
    color: var(--color-on-surface-variant);
    margin: 0;
  }

  /* Home perfumes (random rotation) */
  .home-perfumes {
    padding: 0 0 var(--spacing-stack-lg);
    border-top: var(--border-width) solid var(--color-outline-variant);
  }

  .home-perfume-head {
    text-align: center;
    padding: var(--spacing-stack-md) 0 0;
  }

  .home-perfume-head .section-title {
    margin: 0 0 var(--spacing-stack-sm);
  }

  .home-perfume-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-stack-md);
    margin-top: var(--spacing-stack-md);
  }

  @media (min-width: 768px) {
    .home-perfume-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .home-perfume-cta {
    text-align: center;
    margin-top: var(--spacing-stack-md);
  }

  /* Decant info */
  .decant-info {
    padding: var(--spacing-stack-lg) 0;
  }

  .decant-info-body {
    max-width: 680px;
    margin: 0 auto;
  }

  .decant-info-text {
    font-family: var(--font-family);
    font-size: var(--font-body-lg-size);
    line-height: var(--font-body-lg-line-height);
    letter-spacing: var(--font-body-lg-tracking);
    color: var(--color-on-surface-variant);
    text-align: center;
    margin: 0;
  }

  /* FAQ */
  .faq {
    padding: var(--spacing-stack-lg) 0;
    border-top: var(--border-width) solid var(--color-outline-variant);
  }

  .faq-list {
    max-width: 720px;
    margin: 0 auto;
  }

  .faq-item {
    border: var(--border-width) solid var(--color-outline-variant);
    border-radius: var(--border-radius);
    margin-bottom: var(--spacing-stack-sm);
  }

  .faq-item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-stack-sm);
    cursor: pointer;
    list-style: none;
    padding: var(--spacing-stack-sm) var(--spacing-stack-md);
    font-family: var(--font-family);
    font-size: var(--font-body-lg-size);
    font-weight: 500;
    color: var(--color-on-surface);
    transition: color var(--transition-duration) var(--transition-easing);
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: -2px;
    border-radius: var(--border-radius);
  }

  .faq-item summary::after {
    content: '+';
    font-size: 20px;
    line-height: 1;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .faq-item[open] summary {
    color: var(--color-primary);
  }

  .faq-item[open] summary::after {
    content: '−';
  }

  .faq-answer {
    padding: 0 var(--spacing-stack-md) var(--spacing-stack-sm);
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    line-height: var(--font-body-md-line-height);
    letter-spacing: var(--font-body-md-tracking);
    color: var(--color-on-surface-variant);
    margin: 0;
  }
</style>