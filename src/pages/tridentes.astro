---
import Layout from '@/layouts/Layout.astro';
import { formatPrice } from '@/utils/formatters';
import { TRIDENT_COUNT, TRIDENT_DISCOUNT } from '@/utils/trident';
import { site } from '@/site.config';

const BASE = site.basePath;
---

<Layout
  title={`Tridentes: cada ${TRIDENT_COUNT} decants, ${formatPrice(TRIDENT_DISCOUNT)} menos`}
  description={`Cada ${TRIDENT_COUNT} decants de 5ml se descuentan ${formatPrice(TRIDENT_DISCOUNT)} automáticamente en tu pedido, sin armar nada. 6 decants o más: $1.000 menos por decant.`}
>
  <section class="trident-hero" aria-labelledby="trident-title">
    <div class="container">
      <h1 id="trident-title" class="trident-title">Cada {TRIDENT_COUNT} decants, {formatPrice(TRIDENT_DISCOUNT)} menos.</h1>
      <p class="trident-subtitle">
        Automático, sin códigos ni vueltas: el descuento se aplica solo en tu pedido.
      </p>
    </div>
  </section>

  <section class="trident-steps" aria-label="Cómo funciona">
    <div class="container trident-steps-grid">
      <div class="trident-step">
        <span class="trident-step-number">1</span>
        <p class="trident-step-text">Elegí tus decants en el catálogo, como siempre</p>
      </div>
      <div class="trident-step">
        <span class="trident-step-number">2</span>
        <p class="trident-step-text">3 decants te descuentan {formatPrice(TRIDENT_DISCOUNT)}; 6 o más, $1.000 por decant</p>
      </div>
      <div class="trident-step">
        <span class="trident-step-number">3</span>
        <p class="trident-step-text">Enviá por WhatsApp y coordinamos entrega y pago</p>
      </div>
    </div>
  </section>

  <section class="trident-live" aria-labelledby="trident-live-title">
    <div class="container">
      <h2 id="trident-live-title" class="trident-live-title">Tu pedido ahora mismo</h2>
      <p class="trident-live-text" data-trident-live role="status">Cargando tu pedido…</p>
      <div class="trident-live-actions">
        <a href={`${BASE}catalogo/`} class="btn btn--primary btn--md">Elegir decants</a>
      </div>
    </div>
  </section>

  <section class="trident-examples" aria-label="Ejemplos de descuento">
    <div class="container">
      <ul class="trident-examples-list">
        <li><strong>{TRIDENT_COUNT} decants</strong> → {formatPrice(TRIDENT_DISCOUNT)} menos</li>
        <li><strong>{TRIDENT_COUNT * 2} decants</strong> → $6.000 menos</li>
        <li><strong>{TRIDENT_COUNT * 3} decants</strong> → $9.000 menos</li>
      </ul>
    </div>
  </section>
</Layout>

<script>
  import { onPageLoad } from '@/utils/view-transitions';
  import { getCart } from '@/utils/cart';
  import { getPerfumesMap } from '@/utils/perfumes-client';
  import { resolveCartItems, formatPrice } from '@/utils/formatters';
  import { TRIDENT_COUNT, tridentesCompletos, descuentoTridente } from '@/utils/trident';

  onPageLoad('tridentes-live', () => {
    const el = document.querySelector('[data-trident-live]');
    if (!el) return;
    void (async () => {
      try {
        const cart = getCart();
        if (cart.items.length === 0) {
          el.textContent = 'Tu pedido está vacío. Sumá decants y el descuento aparece solo.';
          return;
        }
        const resolved = resolveCartItems(cart.items, await getPerfumesMap());
        const count = resolved.filter((r) => r.available).reduce((s, r) => s + r.quantity, 0);
        if (count <= 0) {
          el.textContent = 'Los decants de tu pedido quedaron sin stock. Elegí otros y listo.';
          return;
        }
        const n = tridentesCompletos(count);
        if (n > 0) {
          el.textContent = `Tenés ${count} decants: ${n} ${n === 1 ? 'tridente aplicado' : 'tridentes aplicados'} (${formatPrice(descuentoTridente(count))} menos).`;
        } else {
          const missing = TRIDENT_COUNT - count;
          el.textContent = `Tenés ${count} ${count === 1 ? 'decant' : 'decants'}: te falta${missing === 1 ? '' : 'n'} ${missing} para el descuento.`;
        }
      } catch {
        el.textContent = 'No pudimos leer tu pedido. Igual el descuento se aplica solo al enviar.';
      }
    })();
  });
</script>

<style>
  .trident-hero {
    padding: var(--spacing-stack-md) 0 var(--spacing-stack-sm);
    text-align: center;
  }

  .trident-title {
    font-family: var(--font-family);
    font-size: var(--font-display-lg-size);
    font-weight: var(--font-display-lg-weight);
    line-height: var(--font-display-lg-line-height);
    letter-spacing: var(--font-display-lg-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
    margin: 0 0 12px;
  }

  @media (max-width: 640px) {
    .trident-title {
      font-size: 36px;
    }
  }

  .trident-subtitle {
    font-family: var(--font-family);
    font-size: var(--font-body-lg-size);
    font-weight: var(--font-body-lg-weight);
    line-height: var(--font-body-lg-line-height);
    letter-spacing: var(--font-body-lg-tracking);
    color: var(--color-on-surface-variant);
    margin: 0;
  }

  .trident-subtitle strong {
    color: var(--color-primary);
  }

  .trident-steps {
    padding: var(--spacing-stack-sm) 0;
  }

  .trident-steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-stack-sm);
    max-width: 900px;
  }

  @media (min-width: 768px) {
    .trident-steps-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .trident-step {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: var(--spacing-stack-sm) var(--spacing-stack-md);
    border: var(--border-width) solid var(--color-outline-variant);
    border-radius: var(--border-radius);
    background-color: var(--color-surface-container);
  }

  .trident-step-number {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-family: var(--font-family);
    font-weight: 600;
    color: var(--color-on-primary);
    background-color: var(--color-primary);
  }

  .trident-step-text {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    color: var(--color-on-surface);
    margin: 0;
  }

  .trident-live {
    padding: var(--spacing-stack-md) 0;
    text-align: center;
  }

  .trident-live-title {
    font-family: var(--font-family);
    font-size: var(--font-headline-md-size);
    font-weight: var(--font-headline-md-weight);
    letter-spacing: var(--font-headline-md-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
    margin: 0 0 var(--spacing-stack-sm);
  }

  .trident-live-text {
    font-family: var(--font-family);
    font-size: var(--font-body-lg-size);
    color: var(--color-primary);
    margin: 0 0 var(--spacing-stack-sm);
  }

  .trident-live-actions {
    display: flex;
    justify-content: center;
  }

  .trident-examples {
    padding: 0 0 var(--spacing-stack-lg);
  }

  .trident-examples-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 480px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    color: var(--color-on-surface-variant);
    text-align: center;
  }

  .trident-examples-list strong {
    color: var(--color-on-surface);
  }
</style>
