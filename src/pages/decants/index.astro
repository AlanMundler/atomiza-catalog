---
import Layout from '@/layouts/Layout.astro';
import { inspiraciones } from '@/data/inspiraciones';
import perfumesData from '@/data/perfumes.json';
import { site } from '@/site.config';
import { formatPrice } from '@/utils/formatters';
import type { Perfume } from '@/data/types';

const BASE = site.basePath;
const perfumes = perfumesData.perfumes as Perfume[];

const pageTitle = `Decants inspirados en perfumes famosos · ${site.addressLocality}`;
const pageDescription = `Buscá un perfume por el aroma famoso que te gusta: decants de 5ml inspirados en Baccarat Rouge, Sauvage, Delina y más, en ${site.addressLocality}.`;
---

<Layout title={pageTitle} description={pageDescription} ogImage="og-decants.jpg">
  <section class="hub-hero" aria-labelledby="hub-title">
    <div class="container">
      <h1 id="hub-title" class="hub-title">Buscá tu perfume por el aroma famoso</h1>
      <p class="hub-subtitle">
        Todos nuestros decants tienen una fragancia famosa detrás. Elegí la que más te gusta y
        probala sobre tu piel en decant de 5ml antes de comprar el frasco completo.
      </p>
    </div>
  </section>

  <section class="hub-list" aria-label="Aromas famosos en decant">
    <div class="container">
      <div class="hub-grid">
        {inspiraciones.map((insp) => {
          const perfume = perfumes.find((p) => p.slug === insp.perfumeSlug);
          const price = perfume?.sizes.find((s) => s.ml === 5) || perfume?.sizes[0];
          return (
            <a href={`${BASE}decants/${insp.slug}/`} class="hub-card">
              <div class="hub-card-body">
                <h2 class="hub-card-title">{insp.original}</h2>
                <p class="hub-card-sub">{insp.perfumeName} · {insp.casa}</p>
              </div>
              <span class="hub-card-price">{price ? formatPrice(price.price) : ''}</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="hub-more" aria-label="Seguir explorando">
    <div class="container">
      <p class="hub-more-text">¿Preferís explorar por nota? <a href={`${BASE}notas/`}>Ver notas famosas →</a></p>
      <div class="hub-cta">
        <a href={`${BASE}catalogo/`} class="btn btn--primary btn--md">Ver el catálogo completo</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hub-hero {
    padding: var(--spacing-stack-md) 0 var(--spacing-stack-sm);
    text-align: center;
  }

  @media (max-width: 640px) {
    .hub-hero {
      padding: var(--spacing-stack-md) 0;
    }
  }

  .hub-title {
    font-family: var(--font-family);
    font-size: var(--font-display-lg-size);
    font-weight: var(--font-display-lg-weight);
    letter-spacing: var(--font-display-lg-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
    margin: 0 auto var(--spacing-stack-sm);
    max-width: 720px;
  }

  @media (max-width: 640px) {
    .hub-title {
      font-size: var(--font-headline-md-size);
      letter-spacing: var(--font-headline-md-tracking);
    }
  }

  @media (min-width: 641px) {
    .hub-title {
      margin-bottom: 12px;
    }
  }

  .hub-subtitle {
    font-family: var(--font-family);
    font-size: var(--font-body-lg-size);
    line-height: var(--font-body-lg-line-height);
    color: var(--color-on-surface-variant);
    margin: 0 auto;
    max-width: 640px;
  }

  @media (max-width: 640px) {
    .hub-subtitle {
      font-size: var(--font-body-md-size);
    }
  }

  .hub-list {
    padding: var(--spacing-stack-lg) 0;
  }

  .hub-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-stack-sm);
  }

  @media (min-width: 768px) {
    .hub-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .hub-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: var(--spacing-stack-md);
    border: var(--border-width) solid var(--color-outline-variant);
    border-radius: var(--border-radius);
    background-color: var(--color-surface-container);
    text-decoration: none;
    transition: border-color var(--transition-duration) var(--transition-easing);
  }

  .hub-card:hover {
    border-color: var(--color-primary);
  }

  .hub-card-title {
    font-family: var(--font-family);
    font-size: var(--font-headline-md-size);
    font-weight: var(--font-headline-md-weight);
    color: var(--color-on-surface);
    margin: 0;
  }

  .hub-card-sub {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    color: var(--color-on-surface-variant);
    margin: 4px 0 0;
  }

  .hub-card-price {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-primary);
    white-space: nowrap;
  }

  .hub-more {
    padding: var(--spacing-stack-lg) 0;
    border-top: var(--border-width) solid var(--color-outline-variant);
    text-align: center;
  }

  .hub-more-text {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    color: var(--color-on-surface-variant);
    margin: 0 0 var(--spacing-stack-md);
  }

  .hub-more-text a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .hub-cta {
    text-align: center;
  }
</style>
