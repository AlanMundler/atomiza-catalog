---
import Layout from '@/layouts/Layout.astro';
import Search from '@/components/catalog/Search.astro';
import Chip from '@/components/ui/Chip.astro';
import { inspiraciones } from '@/data/inspiraciones';
import perfumesData from '@/data/perfumes.json';
import imageDimsRaw from '@/data/image-dims.json';
import { site, assetUrl } from '@/site.config';
import { formatPrice } from '@/utils/formatters';
import {
  HUB_CASA_ALL,
  buildHubCountText,
  buildHubCountTextWithCasa,
  casasDeInspiraciones,
  casasPrincipales,
  hubCasaSlug,
} from '@/utils/hub';
import { primarySize, getStockStatus, getStockLabel } from '@/utils/stock';
import type { Perfume } from '@/data/types';
import type { Inspiracion } from '@/data/inspiraciones';

const BASE = site.basePath;
const perfumes = perfumesData.perfumes as Perfume[];

// Ancho/alto reales de cada avif (los genera `node scripts/image-dims.mjs`),
// claveados por la ruta relativa sin base path. Van en width/height de las
// <img> para que el navegador reserve el espacio: sin CLS aunque las fotos
// de originales tienen proporciones distintas entre sí.
type ImageDims = { width: number; height: number };
const imageDims = imageDimsRaw as unknown as Record<string, ImageDims>;
const FALLBACK_DIMS: ImageDims = { width: 400, height: 400 };
const dimsFor = (relSrc: string | undefined): ImageDims =>
  (relSrc && imageDims[relSrc]) || FALLBACK_DIMS;

// Mismo índice que usa el catálogo: aroma famoso, casa, perfume nuestro,
// marca y familia. Se usa para el fuzzy (typos) y como `data-search` de cada
// card (fallback literal sin JS).
const searchTextFor = (insp: Inspiracion): string =>
  `${insp.original} ${insp.casa} ${insp.perfumeName} ${insp.perfumeBrand} ${insp.familia}`.toLowerCase();

interface HubItem {
  slug: string;
  original: string;
  casa: string;
  casaSlug: string;
  perfumeName: string;
  imageSrc: string;
  imageW: number;
  imageH: number;
  // Alt del frasco nuestro cuando va SOLO (sin foto del original): nombra a
  // ambos para no perder contexto.
  imageAlt: string;
  // Alt del frasco nuestro en la pareja: el original ya se nombra al lado.
  oursAlt: string;
  // Foto del perfume original (la inspiración). '' si la inspiración no la
  // tiene o falta el archivo: la card cae al layout de una sola botella.
  originalSrc: string;
  originalAlt: string;
  originalW: number;
  originalH: number;
  priceText: string;
  stockVariant: 'in-stock' | 'low-stock' | 'out-of-stock';
  stockLabel: string;
}

const items: HubItem[] = inspiraciones.map((insp) => {
  const perfume = perfumes.find((p) => p.slug === insp.perfumeSlug);
  const size = perfume ? primarySize(perfume) : undefined;
  const status = size ? getStockStatus(size) : 'out-of-stock';
  const image = perfume?.images[0];
  const originalRel = insp.originalImageId
    ? `images/originales/${insp.originalImageId}.avif`
    : undefined;
  // Solo mostramos la pareja si la foto existe en el manifest (o sea, en
  // public/images/originales/); si no, mejor una botella limpia que un 404.
  const hasOriginal = Boolean(originalRel && imageDims[originalRel]);
  const ourDims = dimsFor(image?.src?.replace(/^\//, ''));
  const originalDims = dimsFor(originalRel);
  return {
    slug: insp.slug,
    original: insp.original,
    casa: insp.casa,
    casaSlug: hubCasaSlug(insp.casa),
    perfumeName: insp.perfumeName,
    imageSrc: assetUrl(image?.src),
    imageW: ourDims.width,
    imageH: ourDims.height,
    // Alt útil en el orden de lectura de la card: qué aroma famoso es y con
    // qué perfume nuestro está hecho.
    imageAlt: `${insp.original} — ${insp.perfumeName}`,
    oursAlt: `nuestro ${insp.perfumeName}`,
    originalSrc: hasOriginal && originalRel ? assetUrl(originalRel) : '',
    originalAlt: `${insp.original} (original)`,
    originalW: originalDims.width,
    originalH: originalDims.height,
    priceText: size ? formatPrice(size.price) : '—',
    stockVariant: status,
    stockLabel: getStockLabel(status),
  };
});

// Tira de casas: las de 3+ aromas siempre a la vista; el resto detrás de un
// botón de expansión compacto que vive FUERA del scroller (debajo en mobile,
// alineado a la derecha en desktop), siempre alcanzable sin scrollear nada.
const casas = casasDeInspiraciones(items);
const topCasas = casasPrincipales(casas);
const otherCasas = casas.filter((c) => !topCasas.includes(c));

const hubSearchIndex = inspiraciones.map((insp) => ({ id: insp.slug, text: searchTextFor(insp) }));

const pageTitle = `Decants inspirados en perfumes famosos · ${site.addressLocality}`;
const pageDescription = `Buscá un perfume por el aroma famoso que te gusta: decants de 5ml inspirados en Baccarat Rouge, Sauvage, Delina y más, en ${site.addressLocality}.`;
---

<Layout title={pageTitle} description={pageDescription} ogImage="og-decants.jpg">
  <script is:inline type="application/json" id="hub-search-index" set:html={JSON.stringify(hubSearchIndex).replace(/</g, '\\u003c')} />

  <section class="hub-hero" aria-labelledby="hub-title">
    <div class="container">
      <p class="hub-eyebrow">Decants de 5 ml · {site.addressLocality}</p>
      <h1 id="hub-title" class="hub-title">Buscá tu perfume por el aroma famoso</h1>
      <p class="hub-subtitle">
        Elegí la casa que te gusta o escribí el aroma: cada tarjeta ya tiene su frasco a la vista.
      </p>
    </div>
  </section>

  <section class="hub-toolbar" aria-label="Buscar y filtrar aromas por casa">
    <div class="container">
      <div class="hub-toolbar-row">
        <div class="hub-toolbar-search">
          <Search />
        </div>
        <p class="hub-count" data-hub-count role="status" aria-live="polite">
          {buildHubCountText(items.length)}
        </p>
      </div>

      <div class="hub-casa">
        <div class="hub-casa-scrollwrap">
          <div class="hub-casa-scroller" data-casa-scroller>
            <button type="button" class="casa-chip casa-chip--active" data-casa-chip data-casa="Todas" data-casa-slug={HUB_CASA_ALL} aria-pressed="true">
              Todas
            </button>
            {topCasas.map((c) => (
              <button type="button" class="casa-chip" data-casa-chip data-casa={c.casa} data-casa-slug={c.slug} aria-pressed="false">
                {c.casa} <span class="casa-chip-n">{c.count}</span>
              </button>
            ))}
            {otherCasas.map((c) => (
              <button type="button" class="casa-chip casa-chip--extra" data-casa-chip data-casa={c.casa} data-casa-slug={c.slug} aria-pressed="false" hidden>
                {c.casa} <span class="casa-chip-n">{c.count}</span>
              </button>
            ))}
          </div>
          {/* Indicador de más contenido a la derecha; se apaga al llegar al final (JS). */}
          <span class="hub-casa-fade" data-casa-fade aria-hidden="true"></span>
        </div>
        <div class="hub-casa-toggle">
          <button type="button" class="casa-chip casa-chip--more" data-casa-more aria-expanded="false">
            Ver {otherCasas.length} más
          </button>
        </div>
      </div>
    </div>
  </section>

  <section class="hub-list" aria-label="Aromas famosos en decant">
    <div class="container">
      <div class="hub-grid">
        {items.map((item, idx) => (
          <a
            href={`${BASE}decants/${item.slug}/`}
            class="hub-card"
            data-hub-card
            data-insp-slug={item.slug}
            data-casa={item.casa}
            data-casa-slug={item.casaSlug}
            data-search={searchTextFor(inspiraciones[idx])}
          >
            <div class="hub-card-media">
              {item.originalSrc ? (
                <div class="hub-duo">
                  <span class="hub-bottle hub-bottle--orig">
                    <img
                      src={item.originalSrc}
                      alt={item.originalAlt}
                      class="hub-card-img"
                      loading={idx < 4 ? 'eager' : 'lazy'}
                      decoding="async"
                      width={item.originalW}
                      height={item.originalH}
                    />
                    <span class="hub-bottle-tag" aria-hidden="true">original</span>
                  </span>
                  <span class="hub-duo-arrow" aria-hidden="true">&rarr;</span>
                  <span class="hub-bottle hub-bottle--ours">
                    <img
                      src={item.imageSrc}
                      alt={item.oursAlt}
                      class="hub-card-img"
                      loading={idx < 4 ? 'eager' : 'lazy'}
                      decoding="async"
                      width={item.imageW}
                      height={item.imageH}
                    />
                    <span class="hub-bottle-tag" aria-hidden="true">dupe</span>
                  </span>
                </div>
              ) : (
                <img
                  src={item.imageSrc}
                  alt={item.imageAlt}
                  class="hub-card-img hub-card-img--solo"
                  loading={idx < 4 ? 'eager' : 'lazy'}
                  width={item.imageW}
                  height={item.imageH}
                />
              )}
              <Chip variant={item.stockVariant} class="hub-card-stock">{item.stockLabel}</Chip>
            </div>
            <div class="hub-card-info">
              <h2 class="hub-card-title" title={item.original}>{item.original}</h2>
              <p class="hub-card-casa" title={item.casa}>{item.casa}</p>
              <p class="hub-card-sub" title={item.perfumeName}>{item.perfumeName}</p>
              <span class="hub-card-price">Decant 5 ml · {item.priceText}</span>
            </div>
          </a>
        ))}
      </div>

      <div class="hub-empty" role="status" hidden>
        <h2 class="hub-empty-title">No encontramos ese aroma</h2>
        <p class="hub-empty-text">
          Probá con el nombre del perfume original (por ejemplo, Aventus) o mirá el catálogo completo.
        </p>
        <button type="button" class="btn btn--secondary btn--md hub-empty-btn" data-clear-filters>Limpiar filtros</button>
        <a href={`${BASE}catalogo/`} class="hub-empty-link">Ver todo el catálogo →</a>
      </div>
    </div>
  </section>

  <section class="hub-more" aria-label="Seguir explorando">
    <div class="container">
      <p class="hub-more-text">¿Preferís explorar por nota? <a href={`${BASE}notas/`}>Ver notas famosas →</a></p>
      <div class="hub-cta">
        <a href={`${BASE}catalogo/`} class="btn btn--primary btn--md">Ver el catálogo completo</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { onPageLoad, onWindowOnce, bindOnce } from '@/utils/view-transitions';
  import { fuzzySearchIds } from '@/utils/catalogo';
  import {
    HUB_CASA_ALL,
    buildHubCountTextWithCasa,
    hubSearchMatches,
  } from '@/utils/hub';

  let currentSearch = '';
  // Slug de casa ("" = todas). Va en la URL como ?casa=creed.
  let currentCasa = HUB_CASA_ALL;
  let fuzzyMatches: Set<string> | null = null;
  // Token anti-race: el tecleo rápido dispara varias búsquedas difusas en
  // paralelo; solo la última puede escribir el Set.
  let searchSeq = 0;
  let casasExpanded = false;

  function readUrlState() {
    const params = new URL(window.location.href).searchParams;
    currentSearch = params.get('search') || '';
    currentCasa = params.get('casa') || HUB_CASA_ALL;
  }

  function pushUrl() {
    const url = new URL(window.location.href);
    if (currentSearch) url.searchParams.set('search', currentSearch);
    else url.searchParams.delete('search');
    if (currentCasa !== HUB_CASA_ALL) url.searchParams.set('casa', currentCasa);
    else url.searchParams.delete('casa');
    window.history.pushState({}, '', url);
  }

  function casaDisplayFor(slug: string): string | null {
    if (slug === HUB_CASA_ALL) return null;
    const chip = document.querySelector<HTMLElement>(`[data-casa-chip][data-casa-slug="${slug}"]`);
    return chip?.getAttribute('data-casa') || slug;
  }

  /**
   * Label del toggle de casas, siempre compacto ("Ver 20 más"): en desktop el
   * botón comparte la fila con el scroller de chips, y un label largo dejaría
   * apenas unos pocos chips visibles. Vive fuera del scroller, siempre a mano.
   */
  function moreLabel(total: number): string {
    return casasExpanded ? 'Ver menos' : `Ver ${total} más`;
  }

  /**
   * Pone la UI de control en el estado lógico (input, chips, botón de
   * expansión). Al plegar, la casa activa aunque sea "extra" queda visible:
   * nunca mostramos un filtro que no se ve.
   */
  function syncControls() {
    const input = document.querySelector('[data-search-input]') as HTMLInputElement | null;
    if (input && input.value !== currentSearch) input.value = currentSearch;

    document.querySelectorAll<HTMLElement>('[data-casa-chip]').forEach((chip) => {
      const active = chip.getAttribute('data-casa-slug') === currentCasa;
      chip.setAttribute('aria-pressed', String(active));
      chip.classList.toggle('casa-chip--active', active);
    });

    document.querySelectorAll<HTMLElement>('.casa-chip--extra').forEach((chip) => {
      chip.hidden = !casasExpanded && chip.getAttribute('data-casa-slug') !== currentCasa;
    });

    const moreBtn = document.querySelector<HTMLElement>('[data-casa-more]');
    if (moreBtn) {
      const total = document.querySelectorAll('.casa-chip--extra').length;
      moreBtn.setAttribute('aria-expanded', String(casasExpanded));
      moreBtn.textContent = moreLabel(total);
    }
  }

  /** Fade de "hay más chips" solo si el scroller tiene overflow y no está al final. */
  function updateCasaFade(): void {
    const scroller = document.querySelector<HTMLElement>('[data-casa-scroller]');
    const fade = document.querySelector<HTMLElement>('[data-casa-fade]');
    if (!scroller || !fade) return;
    const overflow = scroller.scrollWidth - scroller.clientWidth;
    const atEnd = scroller.scrollLeft >= overflow - 2;
    fade.classList.toggle('hub-casa-fade--hidden', overflow <= 2 || atEnd);
  }

  function applyFilters() {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-hub-card]'));
    const matches = hubSearchMatches(
      cards.map((c) => ({
        id: c.getAttribute('data-insp-slug') || '',
        text: c.getAttribute('data-search') || '',
      })),
      currentSearch,
      fuzzyMatches
    );

    let visible = 0;
    cards.forEach((card) => {
      const ok =
        matches.has(card.getAttribute('data-insp-slug') || '') &&
        (currentCasa === HUB_CASA_ALL || card.getAttribute('data-casa-slug') === currentCasa);
      card.style.display = ok ? '' : 'none';
      if (ok) visible++;
    });

    const countEl = document.querySelector('[data-hub-count]');
    if (countEl) countEl.textContent = buildHubCountTextWithCasa(visible, casaDisplayFor(currentCasa));

    const emptyEl = document.querySelector('.hub-empty') as HTMLElement | null;
    const gridEl = document.querySelector('.hub-grid') as HTMLElement | null;
    if (emptyEl) emptyEl.hidden = visible !== 0;
    if (gridEl) gridEl.style.display = visible === 0 ? 'none' : '';

    updateCasaFade();
  }

  // Recalcula el set difuso para la búsqueda actual. Se usa al escribir y en
  // popstate, porque el Set anterior no sirve para el query nuevo.
  async function refreshFuzzyMatches(query: string, seq: number): Promise<void> {
    if (!query) {
      if (seq === searchSeq) fuzzyMatches = null;
      return;
    }
    try {
      const indexEl = document.getElementById('hub-search-index');
      const indexData: { id: string; text: string }[] = indexEl
        ? JSON.parse(indexEl.textContent || '[]')
        : [];
      const ids = fuzzySearchIds(indexData, query);
      if (seq === searchSeq) fuzzyMatches = ids;
    } catch {
      if (seq === searchSeq) fuzzyMatches = null;
    }
  }

  /** Entra filtrado con ?casa=de-una-extra: el chip activo debe quedar a la vista. */
  function revealActiveChip(): void {
    if (currentCasa === HUB_CASA_ALL) return;
    const chip = document.querySelector<HTMLElement>(
      `[data-casa-chip][data-casa-slug="${currentCasa}"]`
    );
    chip?.scrollIntoView({ inline: 'nearest', block: 'nearest' });
  }

  function setupCasaStrip() {
    const wrap = document.querySelector('.hub-casa');
    const scroller = document.querySelector('[data-casa-scroller]');
    if (!wrap || !scroller) return;

    // El click se delega en .hub-casa porque el botón de expansión vive FUERA
    // del scroller (así queda siempre visible sin scrollear).
    bindOnce(wrap, (el) => {
      el.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;

        const moreBtn = target.closest<HTMLElement>('[data-casa-more]');
        if (moreBtn) {
          casasExpanded = !casasExpanded;
          syncControls();
          updateCasaFade();
          return;
        }

        const chip = target.closest<HTMLElement>('[data-casa-chip]');
        if (!chip) return;
        currentCasa = chip.getAttribute('data-casa-slug') || HUB_CASA_ALL;
        // En la fila con scroll horizontal (desktop), el chip tocado queda
        // siempre a la vista tras filtrar.
        chip.scrollIntoView({ inline: 'nearest', block: 'nearest' });
        pushUrl();
        syncControls();
        applyFilters();
      });
    });

    bindOnce(scroller, (el) => {
      el.addEventListener('scroll', updateCasaFade, { passive: true });
    });
  }

  function setupClear() {
    const btn = document.querySelector('[data-clear-filters]');
    if (!btn) return;
    bindOnce(btn, (el) => {
      el.addEventListener('click', () => {
        currentSearch = '';
        currentCasa = HUB_CASA_ALL;
        pushUrl();
        syncControls();
        void refreshFuzzyMatches('', ++searchSeq).then(() => applyFilters());
      });
    });
  }

  // Al redimensionar se recalcula el fade del scroller (y el label si cambia el estado).
  onWindowOnce('decants-hub-resize', 'resize', () => {
    syncControls();
    updateCasaFade();
  });

  onWindowOnce('decants-hub-search', 'search:change', async (e) => {
    currentSearch = (e as CustomEvent<{ query?: string }>).detail?.query || '';
    pushUrl();
    await refreshFuzzyMatches(currentSearch, ++searchSeq);
    applyFilters();
  });

  // Back/forward: se re-lee la URL (búsqueda y casa) y se recalculan los matches difusos.
  onWindowOnce('decants-hub-popstate', 'popstate', () => {
    readUrlState();
    syncControls();
    revealActiveChip();
    void refreshFuzzyMatches(currentSearch, ++searchSeq).then(() => applyFilters());
  });

  onPageLoad('decants-hub', () => {
    casasExpanded = false;
    readUrlState();
    syncControls();
    setupCasaStrip();
    setupClear();
    revealActiveChip();

    // Primer pintado con el estado de la URL (coincidencia literal, sin
    // esperar al fuzzy); después se corrige con el set difuso.
    applyFilters();
    void refreshFuzzyMatches(currentSearch, ++searchSeq).then(() => applyFilters());
  });
</script>

<style>
  /* ---------- Hero ---------- */
  .hub-hero {
    padding: var(--spacing-stack-md) 0 var(--spacing-stack-sm);
    text-align: center;
  }

  .hub-eyebrow {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-primary);
    margin: 0 0 10px;
  }

  .hub-title {
    font-family: var(--font-family);
    font-size: var(--font-headline-lg-size);
    font-weight: var(--font-headline-lg-weight);
    line-height: var(--font-headline-lg-line-height);
    letter-spacing: var(--font-headline-lg-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
    margin: 0 auto 10px;
    max-width: 780px;
  }

  /* Mobile: headline-md para que el hero no se coma media pantalla. */
  @media (max-width: 640px) {
    .hub-title {
      font-size: var(--font-headline-md-size);
      font-weight: var(--font-headline-md-weight);
      letter-spacing: var(--font-headline-md-tracking);
    }
  }

  .hub-subtitle {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    line-height: var(--font-body-md-line-height);
    color: var(--color-on-surface-variant);
    margin: 0 auto;
    max-width: 620px;
  }

  /* ---------- Toolbar (búsqueda + chips de casa) ---------- */
  .hub-toolbar {
    padding: 10px 0 2px;
    border-top: var(--border-width) solid var(--color-outline-variant);
    border-bottom: var(--border-width) solid var(--color-outline-variant);
    position: sticky;
    top: var(--header-height);
    z-index: 50;
    background-color: var(--color-background);
  }

  .hub-toolbar-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  @media (max-width: 640px) {
    .hub-toolbar-row {
      flex-direction: column;
      align-items: center;
      gap: 6px;
    }
  }

  .hub-toolbar-search {
    flex: 1;
    max-width: 420px;
  }

  @media (max-width: 640px) {
    .hub-toolbar-search {
      width: 100%;
    }
  }

  .hub-count {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
    margin: 0;
    white-space: nowrap;
    padding-bottom: 10px;
    text-align: right;
  }

  @media (max-width: 640px) {
    .hub-count {
      text-align: center;
      padding-bottom: 0;
    }
  }

  /* Tira de casas. Mobile/tablet (≤767px): los chips ocupan TODO el ancho con
     scroll horizontal y el botón de expansión va DEBAJO, a lo ancho. Si
     comparte la fila con el scroller, este queda de ~150px y no se entiende
     que hay más casas.
     Desktop (≥768px): UNA sola fila con scroll horizontal (mismo fade/chevron
     que mobile) + toggle compacto fuera del scroller, a la derecha. Nada de
     wrap: la barra sticky no debe tapar media pantalla. */
  .hub-casa {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
    padding: 8px 0 10px;
  }

  @media (min-width: 768px) {
    .hub-casa {
      flex-direction: row;
      align-items: center;
      gap: 12px;
      padding: 2px 0 4px;
    }
  }

  .hub-casa-scrollwrap {
    position: relative;
    min-width: 0;
  }

  .hub-casa-scroller {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .hub-casa-scroller::-webkit-scrollbar {
    display: none;
  }

  /* Gradiente sobre el borde derecho del scroller + chevron: indica que hay más
     chips a la derecha. Se apaga al llegar al final (JS). `right: 0` para no
     generar overflow horizontal. */
  .hub-casa-fade {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 56px;
    pointer-events: none;
    background: linear-gradient(to right, transparent, var(--color-background) 55%);
    transition: opacity var(--transition-duration) var(--transition-easing);
  }

  .hub-casa-fade::after {
    content: "";
    position: absolute;
    top: 50%;
    right: 12px;
    width: 8px;
    height: 8px;
    border-top: 2px solid var(--color-primary);
