---
import Layout from '@/layouts/Layout.astro';
import Filters from '@/components/catalog/Filters.astro';
import Search from '@/components/catalog/Search.astro';
import ProductGrid from '@/components/catalog/ProductGrid.astro';
import type { Perfume, GenderFilter } from '@/data/types';
import perfumesData from '@/data/perfumes.json';

const perfumes = perfumesData.perfumes as Perfume[];

const searchIndex = perfumes.map((p) => ({
  id: p.id,
  // Incluye notas: antes la búsqueda no encontraba por "vainilla", "oud", etc.
  text: `${p.brand} ${p.name} ${p.olfactoryFamily} ${p.notes.top.join(' ')} ${p.notes.heart.join(' ')} ${p.notes.base.join(' ')}`.toLowerCase(),
}));

import { site } from '@/site.config';

const BASE = site.basePath;
// Filtro inicial desde la URL para el primer pintado (sin JS o antes de que
// el JS corrija el chip activo, evitaba el flash de "TODOS").
const urlFilter = Astro.url.searchParams.get('filter');
const initialFilter: GenderFilter = urlFilter === 'masculino' || urlFilter === 'femenino' || urlFilter === 'unisex' ? urlFilter : 'all';
const catalogDescription = `Catálogo de decants de 5ml de perfumes árabes originales en ${site.addressLocality}. Filtra por género y busca tu fragancia favorita.`;
const catalogSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Catálogo de decants ${site.namePlain}`,
  numberOfItems: perfumes.length,
  itemListElement: perfumes.map((perfume, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${perfume.brand} ${perfume.name}`,
    url: `${Astro.site?.origin}${BASE}producto/${perfume.slug}/`,
  })),
};
---

<Layout title={`Catálogo de decants de perfumes árabes en ${site.addressLocality}`} description={catalogDescription}>
  <script is:inline type="application/json" id="search-index" set:html={JSON.stringify(searchIndex).replace(/</g, '\\u003c')} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(catalogSchema).replace(/</g, '\\u003c')} />
  <section class="catalog-hero" aria-labelledby="catalog-title">
    <div class="container">
      <h1 id="catalog-title" class="catalog-title">Catálogo</h1>
      <p class="catalog-subtitle">Descubrí nuestra selección de decants de perfumes árabes</p>
    </div>
  </section>

  <section class="catalog-toolbar" aria-label="Filtros y búsqueda">
    <div class="container">
      <div class="toolbar-content">
        <div class="toolbar-filters">
          <Filters currentFilter={initialFilter} />
        </div>
        <div class="toolbar-search">
          <Search />
        </div>
      </div>
    </div>
  </section>

  <section class="catalog-results" aria-labelledby="catalog-results-title">
    <div class="container">
      <div class="results-header">
        <h2 id="catalog-results-title" class="visually-hidden">Decants disponibles</h2>
        <p class="results-count" data-results-count role="status" aria-live="polite">
          {perfumes.length} {perfumes.length === 1 ? 'perfume' : 'perfumes'} encontrado{perfumes.length !== 1 ? 's' : ''}
        </p>
      </div>
      <ProductGrid perfumes={perfumes} />
    </div>
  </section>
</Layout>

<script>
  // Client-side filtering without page reload (static output has no query params at build time)
  import { bindOnce, onPageLoad, onWindowOnce } from '@/utils/view-transitions';
  import {
    buildResultsText,
    cardMatches,
    fuzzySearchIds,
    normalizeFilter,
  } from '@/utils/catalogo';

  let currentFilter = 'all';
  let currentSearch = '';
  let fuzzyMatches: Set<string> | null = null;
  // Token anti-race: el tecleo rápido dispara varias búsquedas Fuse en
  // paralelo; solo la última puede escribir el Set.
  let searchSeq = 0;

  function readUrlState() {
    const params = new URL(window.location.href).searchParams;
    currentFilter = normalizeFilter(params.get('filter'));
    currentSearch = params.get('search') || '';
  }

  function syncSearchInput() {
    const input = document.querySelector('[data-search-input]') as HTMLInputElement | null;
    if (input && input.value !== currentSearch) input.value = currentSearch;
  }

  function applyFilters() {
    const cards = Array.from(document.querySelectorAll('.product-card')) as HTMLElement[];
    const countEl = document.querySelector('[data-results-count]') as HTMLElement | null;
    const emptyEl = document.querySelector('.product-grid-empty') as HTMLElement | null;
    const gridEl = document.querySelector('.product-grid') as HTMLElement | null;

    let visible = 0;
    cards.forEach((card) => {
      const matches = cardMatches({
        gender: card.getAttribute('data-gender') || '',
        searchText: card.getAttribute('data-search') || '',
        perfumeId: card.getAttribute('data-perfume-id') || '',
        filter: currentFilter,
        query: currentSearch,
        fuzzyIds: fuzzyMatches,
      });

      card.style.display = matches ? '' : 'none';
      if (matches) visible++;
    });

    if (countEl) {
      countEl.textContent = buildResultsText(visible, currentFilter, currentSearch);
    }

    if (emptyEl && gridEl) {
      emptyEl.hidden = visible !== 0;
      gridEl.style.display = visible === 0 ? 'none' : '';
    }
  }

  // Recalcula el set de fuzzy matches para la búsqueda actual. Se usa al
  // escribir (search:change) y al navegar con atrás/adelante (popstate),
  // porque el Set viejo no sirve para el query nuevo. Devuelve el Set (o
  // null) y solo lo publica si sigue siendo la búsqueda vigente.
  async function refreshFuzzyMatches(query: string, seq: number): Promise<void> {
    if (!query) {
      if (seq === searchSeq) fuzzyMatches = null;
      return;
    }
    try {
      const indexEl = document.getElementById('search-index');
      const indexData: { id: string; text: string }[] = indexEl ? JSON.parse(indexEl.textContent || '[]') : [];
      const ids = await fuzzySearchIds(indexData, query);
      if (seq === searchSeq) fuzzyMatches = ids;
    } catch {
      if (seq === searchSeq) fuzzyMatches = null;
    }
  }

  function applyUrlState() {
    readUrlState();
    syncSearchInput();
    updateActiveChip();
    applyFilters();
  }

  function updateActiveChip() {
    const filterButtons = document.querySelectorAll('.filter-chip') as NodeListOf<HTMLButtonElement>;
    filterButtons.forEach((b) => {
      const isActive = b.getAttribute('data-filter') === currentFilter;
      b.classList.toggle('filter-chip--active', isActive);
      b.setAttribute('aria-pressed', String(isActive));
    });
  }

  onWindowOnce('catalogo-search', 'search:change', async (e) => {
    currentSearch = (e as CustomEvent).detail?.query || '';
    const url = new URL(window.location.href);
    if (currentSearch) {
      url.searchParams.set('search', currentSearch);
    } else {
      url.searchParams.delete('search');
    }
    window.history.pushState({}, '', url);

    // Búsqueda fuzzy con Fuse.js (lazy-loaded)
    await refreshFuzzyMatches(currentSearch, ++searchSeq);

    applyFilters();
    if (currentSearch) {
      document.dispatchEvent(new CustomEvent('analytics:search', { detail: { query: currentSearch } }));
    }
  });

  // Back/forward del navegador re-aplica el estado de filtros y búsqueda.
  // Se recalculan los fuzzy matches porque el Set corresponde al query
  // anterior y si no el filtrado queda incorrecto.
  onWindowOnce('catalogo-popstate', 'popstate', () => {
    readUrlState();
    syncSearchInput();
    updateActiveChip();
    const seq = ++searchSeq;
    void refreshFuzzyMatches(currentSearch, seq).then(() => applyFilters());
  });

  onPageLoad('catalogo', () => {
    const filterButtons = document.querySelectorAll('.filter-chip') as NodeListOf<HTMLButtonElement>;
    filterButtons.forEach((button) => {
      bindOnce(button, (el) => {
        el.addEventListener('click', () => {
          const filter = el.getAttribute('data-filter');
          if (!filter) return;
          currentFilter = filter;
          const url = new URL(window.location.href);
          if (filter === 'all') {
            url.searchParams.delete('filter');
          } else {
            url.searchParams.set('filter', filter);
          }
          window.history.pushState({}, '', url);

          updateActiveChip();
          applyFilters();
        });
      });
    });

    applyUrlState();

    // Analytics: view_item_list con los perfumes visibles
    requestAnimationFrame(() => {
      const visibleCards = Array.from(document.querySelectorAll('.product-card')).filter(
        (c) => (c as HTMLElement).style.display !== 'none'
      );
      if (visibleCards.length > 0) {
        document.dispatchEvent(new CustomEvent('analytics:view_item_list', {
          detail: {
            listName: 'catalogo',
            items: visibleCards.slice(0, 10).map((c) => ({
              item_id: c.getAttribute('data-perfume-id') || '',
              item_name: c.getAttribute('data-search') || '',
            })),
          },
        }));
      }
    });
  });
</script>

<style>
  .catalog-hero {
    padding: var(--spacing-stack-md) 0 var(--spacing-stack-sm);
    text-align: center;
  }

  .catalog-title {
    font-family: var(--font-family);
    font-size: var(--font-display-lg-size);
    font-weight: var(--font-display-lg-weight);
    line-height: var(--font-display-lg-line-height);
    letter-spacing: var(--font-display-lg-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
    margin: 0 0 12px;
  }

  @media (max-width: 640px) {
    .catalog-title {
      font-size: 36px;
    }
  }

  .catalog-subtitle {
    font-family: var(--font-family);
    font-size: var(--font-body-lg-size);
    font-weight: var(--font-body-lg-weight);
    line-height: var(--font-body-lg-line-height);
    letter-spacing: var(--font-body-lg-tracking);
    color: var(--color-on-surface-variant);
    margin: 0;
  }

  .catalog-toolbar {
    padding: 12px 0;
    border-top: var(--border-width) solid var(--color-outline-variant);
    border-bottom: var(--border-width) solid var(--color-outline-variant);
    position: sticky;
    top: 72px;
    z-index: 50;
    background-color: var(--color-background);
  }

  @media (max-width: 640px) {
    .catalog-toolbar {
      padding: 8px 0;
    }

    .toolbar-content {
      gap: 8px;
    }
  }

  .toolbar-content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-stack-sm);
    align-items: center;
  }

  @media (min-width: 768px) {
    .toolbar-content {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: var(--spacing-stack-md);
    }
  }

  .toolbar-filters {
    width: 100%;
    max-width: 100%;
  }

  @media (min-width: 768px) {
    .toolbar-filters {
      grid-column: 2;
      justify-self: center;
    }
  }

  .toolbar-search {
    width: 100%;
    max-width: 400px;
  }

  @media (min-width: 768px) {
    .toolbar-search {
      grid-column: 3;
      justify-self: end;
      max-width: 280px;
    }
  }

  .catalog-results {
    padding: var(--spacing-stack-sm) 0 var(--spacing-stack-lg);
  }

  .results-header {
    margin-bottom: var(--spacing-stack-sm);
  }

  .results-count {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
    margin: 0;
  }
</style>