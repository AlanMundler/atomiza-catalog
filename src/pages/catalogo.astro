---
import Layout from '@/layouts/Layout.astro';
import Filters from '@/components/catalog/Filters.astro';
import Search from '@/components/catalog/Search.astro';
import ProductGrid from '@/components/catalog/ProductGrid.astro';
import type { Perfume } from '@/data/types';
import perfumesData from '@/data/perfumes.json';

const perfumes = perfumesData.perfumes as Perfume[];

const catalogDescription = `Catálogo de decants de 5ml de perfumes árabes originales en ${'Córdoba'}. Filtra por género y busca tu fragancia favorita.`;
const catalogSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Catálogo de decants ATOMIZA',
  numberOfItems: perfumes.length,
  itemListElement: perfumes.map((perfume, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${perfume.brand} ${perfume.name}`,
    url: new URL(`/producto/${perfume.slug}/`, Astro.site).href,
  })),
};
---

<Layout title="Catálogo de decants de perfumes árabes en Córdoba" description={catalogDescription}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(catalogSchema).replace(/</g, '\\u003c')} />
  <section class="catalog-hero" aria-labelledby="catalog-title">
    <div class="container">
      <h1 id="catalog-title" class="catalog-title">Catálogo</h1>
      <p class="catalog-subtitle">Descubrí nuestra selección de decants de perfumes árabes</p>
    </div>
  </section>

  <section class="catalog-toolbar" aria-label="Filtros y búsqueda">
    <div class="container">
      <div class="toolbar-content">
        <div class="toolbar-filters">
          <Filters />
        </div>
        <div class="toolbar-search">
          <Search />
        </div>
      </div>
    </div>
  </section>

  <section class="catalog-results" aria-label="Resultados del catálogo">
    <div class="container">
      <div class="results-header">
        <p class="results-count" data-results-count>
          {perfumes.length} {perfumes.length === 1 ? 'perfume' : 'perfumes'} encontrado{perfumes.length !== 1 ? 's' : ''}
        </p>
      </div>
      <ProductGrid perfumes={perfumes} />
    </div>
  </section>
</Layout>

<script>
  // Client-side filtering without page reload (static output has no query params at build time)
  import { bindOnce, onPageLoad, onWindowOnce } from '@/utils/view-transitions';

  const GENDERS: Record<string, string[]> = {
    'masculino': ['masculino', 'unisex'],
    'femenino': ['femenino', 'unisex'],
    'unisex': ['unisex'],
  };

  let currentFilter = 'all';
  let currentSearch = '';

  function readUrlState() {
    const params = new URL(window.location.href).searchParams;
    const rawFilter = params.get('filter') || 'all';
    currentFilter = Object.hasOwn(GENDERS, rawFilter) ? rawFilter : 'all';
    currentSearch = params.get('search') || '';
  }

  function syncSearchInput() {
    const input = document.querySelector('[data-search-input]') as HTMLInputElement | null;
    if (input && input.value !== currentSearch) input.value = currentSearch;
  }

  function applyFilters() {
    const cards = Array.from(document.querySelectorAll('.product-card')) as HTMLElement[];
    const countEl = document.querySelector('[data-results-count]') as HTMLElement | null;
    const emptyEl = document.querySelector('.product-grid-empty') as HTMLElement | null;
    const gridEl = document.querySelector('.product-grid') as HTMLElement | null;

    let visible = 0;
    cards.forEach((card) => {
      const gender = card.getAttribute('data-gender') || '';
      const search = card.getAttribute('data-search') || '';

      let matches = true;
      if (currentFilter !== 'all') {
        const allowed = GENDERS[currentFilter] || [];
        matches = allowed.includes(gender);
      }
      if (matches && currentSearch) {
        matches = search.includes(currentSearch.toLowerCase());
      }

      card.style.display = matches ? '' : 'none';
      if (matches) visible++;
    });

    if (countEl) {
      let text = `${visible} ${visible === 1 ? 'perfume' : 'perfumes'} encontrado${visible !== 1 ? 's' : ''}`;
      if (currentFilter !== 'all') text += ` en ${currentFilter}`;
      if (currentSearch) text += ` para "${currentSearch}"`;
      countEl.textContent = text;
    }

    if (emptyEl && gridEl) {
      emptyEl.hidden = visible !== 0;
      gridEl.style.display = visible === 0 ? 'none' : '';
    }
  }

  function applyUrlState() {
    readUrlState();
    syncSearchInput();
    updateActiveChip();
    applyFilters();
  }

  function updateActiveChip() {
    const filterButtons = document.querySelectorAll('.filter-chip') as NodeListOf<HTMLButtonElement>;
    filterButtons.forEach((b) => {
      const isActive = b.getAttribute('data-filter') === currentFilter;
      b.classList.toggle('filter-chip--active', isActive);
      b.setAttribute('aria-pressed', String(isActive));
    });
  }

  onWindowOnce('catalogo-search', 'search:change', (e) => {
    currentSearch = (e as CustomEvent).detail?.query || '';
    const url = new URL(window.location.href);
    if (currentSearch) {
      url.searchParams.set('search', currentSearch);
    } else {
      url.searchParams.delete('search');
    }
    window.history.pushState({}, '', url);
    applyFilters();
  });

  // Back/forward del navegador re-aplica el estado de filtros y búsqueda
  onWindowOnce('catalogo-popstate', 'popstate', () => {
    applyUrlState();
  });

  onPageLoad('catalogo', () => {
    const filterButtons = document.querySelectorAll('.filter-chip') as NodeListOf<HTMLButtonElement>;
    filterButtons.forEach((button) => {
      bindOnce(button, (el) => {
        el.addEventListener('click', () => {
          const filter = el.getAttribute('data-filter');
          if (!filter) return;
          currentFilter = filter;
          const url = new URL(window.location.href);
          if (filter === 'all') {
            url.searchParams.delete('filter');
          } else {
            url.searchParams.set('filter', filter);
          }
          window.history.pushState({}, '', url);

          updateActiveChip();
          applyFilters();
        });
      });
    });

    applyUrlState();
  });
</script>

<style>
  .catalog-hero {
    padding: var(--spacing-stack-md) 0 var(--spacing-stack-sm);
    text-align: center;
  }

  .catalog-title {
    font-family: var(--font-family);
    font-size: var(--font-display-lg-size);
    font-weight: var(--font-display-lg-weight);
    line-height: var(--font-display-lg-line-height);
    letter-spacing: var(--font-display-lg-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
    margin: 0 0 12px;
  }

  @media (max-width: 640px) {
    .catalog-title {
      font-size: 36px;
    }
  }

  .catalog-subtitle {
    font-family: var(--font-family);
    font-size: var(--font-body-lg-size);
    font-weight: var(--font-body-lg-weight);
    line-height: var(--font-body-lg-line-height);
    letter-spacing: var(--font-body-lg-tracking);
    color: var(--color-on-surface-variant);
    margin: 0;
  }

  .catalog-toolbar {
    padding: 12px 0;
    border-top: var(--border-width) solid var(--color-outline-variant);
    border-bottom: var(--border-width) solid var(--color-outline-variant);
    position: sticky;
    top: 72px;
    z-index: 50;
    background-color: var(--color-background);
  }

  .toolbar-content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-stack-sm);
    align-items: center;
  }

  @media (min-width: 768px) {
    .toolbar-content {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: var(--spacing-stack-md);
    }
  }

  .toolbar-filters {
    width: 100%;
    max-width: 100%;
  }

  @media (min-width: 768px) {
    .toolbar-filters {
      grid-column: 2;
      justify-self: center;
    }
  }

  .toolbar-search {
    width: 100%;
    max-width: 400px;
  }

  @media (min-width: 768px) {
    .toolbar-search {
      grid-column: 3;
      justify-self: end;
      max-width: 280px;
    }
  }

  .catalog-results {
    padding: var(--spacing-stack-sm) 0 var(--spacing-stack-lg);
  }

  .results-header {
    margin-bottom: var(--spacing-stack-sm);
  }

  .results-count {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
    margin: 0;
  }
</style>