---
import Layout from '@/layouts/Layout.astro';
import Filters from '@/components/catalog/Filters.astro';
import Search from '@/components/catalog/Search.astro';
import ProductGrid from '@/components/catalog/ProductGrid.astro';
import { filterPerfumes, searchPerfumes } from '@/utils/filters';
import type { Perfume, GenderFilter } from '@/data/types';
import perfumesData from '@/data/perfumes.json';

const allPerfumes: Perfume[] = perfumesData.perfumes;

// Get filter and search from URL params
const url = new URL(Astro.request.url);
const filterParam = url.searchParams.get('filter') as GenderFilter | null;
const searchParam = url.searchParams.get('search') || '';

const currentFilter: GenderFilter = filterParam || 'all';
const currentSearch = searchParam;

const filteredPerfumes = searchPerfumes(filterPerfumes(allPerfumes, currentFilter), currentSearch);
---

<Layout title="Catálogo - ΛTOMIZΛ" description="Explora nuestro catálogo de perfumes de nicho y diseñador. Filtra por género y busca tus fragancias favoritas.">
  <section class="catalog-hero" aria-labelledby="catalog-title">
    <div class="container">
      <h1 id="catalog-title" class="catalog-title">Catálogo</h1>
      <p class="catalog-subtitle">Descubre nuestra selección curada de fragancias de autor</p>
    </div>
  </section>

  <section class="catalog-toolbar" aria-label="Filtros y búsqueda">
    <div class="container">
      <div class="toolbar-content">
        <div class="toolbar-filters">
          <Filters currentFilter={currentFilter} />
        </div>
        <div class="toolbar-search">
          <Search />
        </div>
      </div>
    </div>
  </section>

  <section class="catalog-results" aria-label="Resultados del catálogo">
    <div class="container">
      <div class="results-header">
        <p class="results-count" data-results-count>
          {filteredPerfumes.length} {filteredPerfumes.length === 1 ? 'perfume' : 'perfumes'} encontrado{filteredPerfumes.length !== 1 ? 's' : ''}
          {currentFilter !== 'all' && <span data-filter-label> en {currentFilter}</span>}
          {currentSearch && <span data-search-label> para "{currentSearch}"</span>}
        </p>
      </div>
      <ProductGrid perfumes={filteredPerfumes} />
    </div>
  </section>
</Layout>

<script>
  // Client-side filtering without page reload (static output has no query params at build time)
  const cards = Array.from(document.querySelectorAll('.product-card')) as HTMLElement[];
  const countEl = document.querySelector('[data-results-count]') as HTMLElement;
  const filterLabelEl = document.querySelector('[data-filter-label]') as HTMLElement | null;
  const searchLabelEl = document.querySelector('[data-search-label]') as HTMLElement | null;
  const emptyEl = document.querySelector('.product-grid-empty') as HTMLElement | null;
  const gridEl = document.querySelector('.product-grid') as HTMLElement | null;
  const filterButtons = document.querySelectorAll('.filter-chip') as NodeListOf<HTMLButtonElement>;

  const GENDERS: Record<string, string[]> = {
    'masculino': ['masculino', 'unisex'],
    'femenino': ['femenino', 'unisex'],
    'unisex': ['unisex'],
  };

  let currentFilter: string = new URL(window.location.href).searchParams.get('filter') || 'all';
  let currentSearch: string = new URL(window.location.href).searchParams.get('search') || '';

  function applyFilters() {
    let visible = 0;
    cards.forEach((card) => {
      const gender = card.getAttribute('data-gender') || '';
      const isBoutique = card.getAttribute('data-boutique') === 'true';
      const search = card.getAttribute('data-search') || '';

      let matches = true;
      if (currentFilter === 'boutique') {
        matches = isBoutique;
      } else if (currentFilter !== 'all') {
        const allowed = GENDERS[currentFilter] || [];
        matches = allowed.includes(gender);
      }
      if (matches && currentSearch) {
        matches = search.includes(currentSearch.toLowerCase());
      }

      card.style.display = matches ? '' : 'none';
      if (matches) visible++;
    });

    if (countEl) {
      countEl.innerHTML = `${visible} ${visible === 1 ? 'perfume' : 'perfumes'} encontrado${visible !== 1 ? 's' : ''}` +
        (currentFilter !== 'all' ? ` <span>en ${currentFilter}</span>` : '') +
        (currentSearch ? ` <span>para "${currentSearch}"</span>` : '');
    }

    if (emptyEl && gridEl) {
      emptyEl.style.display = visible === 0 ? '' : 'none';
      gridEl.style.display = visible === 0 ? 'none' : '';
    }
  }

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.getAttribute('data-filter');
      if (!filter) return;
      currentFilter = filter;
      const url = new URL(window.location.href);
      if (filter === 'all') {
        url.searchParams.delete('filter');
      } else {
        url.searchParams.set('filter', filter);
      }
      window.history.pushState({}, '', url);

      updateActiveChip();
      applyFilters();
    });
  });

  function updateActiveChip() {
    filterButtons.forEach((b) => {
      const isActive = b.getAttribute('data-filter') === currentFilter;
      b.classList.toggle('filter-chip--active', isActive);
      b.setAttribute('aria-pressed', String(isActive));
    });
  }

  window.addEventListener('search:change', (e: CustomEvent) => {
    currentSearch = e.detail?.query || '';
    const url = new URL(window.location.href);
    if (currentSearch) {
      url.searchParams.set('search', currentSearch);
    } else {
      url.searchParams.delete('search');
    }
    window.history.pushState({}, '', url);
    applyFilters();
  });

  updateActiveChip();
  applyFilters();
</script>

<style>
  .catalog-hero {
    padding: var(--spacing-stack-lg) 0 var(--spacing-stack-md);
    text-align: center;
  }

  .catalog-title {
    font-family: var(--font-family);
    font-size: var(--font-display-lg-size);
    font-weight: var(--font-display-lg-weight);
    line-height: var(--font-display-lg-line-height);
    letter-spacing: var(--font-display-lg-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
    margin: 0 0 var(--spacing-stack-sm);
  }

  @media (max-width: 640px) {
    .catalog-title {
      font-size: 48px;
    }
  }

  .catalog-subtitle {
    font-family: var(--font-family);
    font-size: var(--font-body-lg-size);
    font-weight: var(--font-body-lg-weight);
    line-height: var(--font-body-lg-line-height);
    letter-spacing: var(--font-body-lg-tracking);
    color: var(--color-on-surface-variant);
    margin: 0;
  }

  .catalog-toolbar {
    padding: var(--spacing-stack-sm) 0;
    border-top: var(--border-width) solid var(--color-outline-variant);
    border-bottom: var(--border-width) solid var(--color-outline-variant);
    position: sticky;
    top: 72px;
    z-index: 50;
    background-color: var(--color-background);
  }

  .toolbar-content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-stack-sm);
    align-items: center;
  }

  @media (min-width: 768px) {
    .toolbar-content {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: var(--spacing-stack-md);
    }
  }

  .toolbar-filters {
    width: 100%;
    max-width: 100%;
  }

  .toolbar-search {
    width: 100%;
    max-width: 400px;
  }

  .catalog-results {
    padding: var(--spacing-stack-lg) 0;
  }

  .results-header {
    margin-bottom: var(--spacing-stack-md);
  }

  .results-count {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
    margin: 0;
  }
</style>