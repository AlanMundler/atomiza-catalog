---
/**
 * Portada del catálogo: ya no es el listado. Presenta los dos modos
 * (decants / frascos) y enlaza a /catalogo/decants/ y /catalogo/frascos/.
 * El ItemList de JSON-LD sigue apuntando a las 73 fichas de producto.
 */
import Layout from '@/layouts/Layout.astro';
import CatalogChooser from '@/components/catalog/CatalogChooser.astro';
import type { Perfume } from '@/data/types';
import perfumesData from '@/data/perfumes.json';
import { site } from '@/site.config';

const perfumes = perfumesData.perfumes as Perfume[];

const BASE = site.basePath;

const catalogSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Catálogo ${site.namePlain}`,
  numberOfItems: perfumes.length,
  itemListElement: perfumes.map((perfume, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${perfume.brand} ${perfume.name}`,
    url: `${Astro.site?.origin}${BASE}producto/${perfume.slug}/`,
  })),
};
---

<Layout
  title="Catálogo de perfumes árabes en Córdoba: decants y frascos"
  description={`Elegí decant de 5 ml para probar antes de comprar, o el frasco original sellado. Perfumes árabes originales en ${site.addressLocality}, con entrega coordinada por WhatsApp.`}
  ogImage="og-catalogo.jpg"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(catalogSchema).replace(/</g, '\\u003c')} />
  <CatalogChooser />
</Layout>
