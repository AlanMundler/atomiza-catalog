---
import Layout from '@/layouts/Layout.astro';
import ProductDetail from '@/components/product/ProductDetail.astro';
import ProductCard from '@/components/catalog/ProductCard.astro';
import perfumesData from '@/data/perfumes.json';
import { site, assetUrl } from '@/site.config';
import { isSizeAvailable } from '@/utils/stock';
import type { Perfume } from '@/data/types';

export async function getStaticPaths() {
  const perfumes: Perfume[] = perfumesData.perfumes as Perfume[];
  
  return perfumes.map((perfume) => ({
    params: { slug: perfume.slug },
    props: { perfume }
  }));
}

const { perfume } = Astro.props;

const allPerfumes: Perfume[] = perfumesData.perfumes as Perfume[];
const related = allPerfumes
  .filter((p) => p.id !== perfume.id && (p.olfactoryFamily === perfume.olfactoryFamily || p.gender === perfume.gender))
  .slice(0, 4);

const primarySize = perfume.sizes.find((s) => s.ml === 5) || perfume.sizes[0];
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${perfume.brand} ${perfume.name}`,
  description: `${perfume.brand} ${perfume.name} - ${perfume.olfactoryFamily}. Decant de 5ml.`,
  brand: { '@type': 'Brand', name: perfume.brand },
  image: new URL(assetUrl(perfume.images[0]?.src), Astro.site).href,
  offers: {
    '@type': 'Offer',
    priceCurrency: site.currency,
    price: primarySize?.price,
    availability: primarySize && isSizeAvailable(primarySize)
      ? 'https://schema.org/InStock'
      : 'https://schema.org/OutOfStock',
    url: new URL(Astro.url.pathname, Astro.site).href,
  },
};
---

<Layout 
    title={`Decant 5ml ${perfume.brand} ${perfume.name} | Perfume árabe en ${site.addressLocality}`} 
    description={`Decant 5ml de ${perfume.brand} ${perfume.name}. ${perfume.olfactoryFamily}, perfume árabe original. Probalo sobre tu piel antes de comprar el frasco en ${site.addressLocality}.`}
    ogImage={`og/${perfume.slug}.jpg`}
    ogType="product"
  >
    <script type="application/ld+json" is:inline set:html={JSON.stringify(productSchema).replace(/</g, '\\u003c')} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: 'Catálogo', item: new URL('/catalogo/', Astro.site).href },
        { '@type': 'ListItem', position: 3, name: `${perfume.brand} ${perfume.name}` },
      ],
    }).replace(/</g, '\\u003c')} />
  <div class="container">
    <ProductDetail perfume={perfume} />
  </div>
  {related.length > 0 && (
    <section class="related" aria-labelledby="related-title">
      <div class="container">
        <h2 id="related-title" class="related-title">Podría interesarte</h2>
        <div class="related-grid">
          {related.map((p) => (
            <ProductCard perfume={p} />
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>

<style>
  .related {
    padding: var(--spacing-stack-lg) 0;
    border-top: var(--border-width) solid var(--color-outline-variant);
  }

  .related-title {
    font-family: var(--font-family);
    font-size: var(--font-headline-md-size);
    font-weight: var(--font-headline-md-weight);
    line-height: var(--font-headline-md-line-height);
    letter-spacing: var(--font-headline-md-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
    text-align: center;
    margin: 0 0 var(--spacing-stack-md);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-stack-md);
  }

  @media (min-width: 768px) {
    .related-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>