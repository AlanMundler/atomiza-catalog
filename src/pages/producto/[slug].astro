---
import Layout from '@/layouts/Layout.astro';
import ProductDetail from '@/components/product/ProductDetail.astro';
import perfumesData from '@/data/perfumes.json';
import type { Perfume } from '@/data/types';

export async function getStaticPaths() {
  const perfumes: Perfume[] = perfumesData.perfumes;
  
  return perfumes.map((perfume) => ({
    params: { slug: perfume.slug },
    props: { perfume }
  }));
}

const { perfume } = Astro.props;
---

<Layout 
  title={`${perfume.brand} ${perfume.name} - ATOMIZA`} 
  description={`${perfume.brand} ${perfume.name} - ${perfume.olfactoryFamily}. Decants disponibles en 2ml, 5ml y 10ml.`}
  ogImage={perfume.images[0]?.src}
>
  <ProductDetail perfume={perfume} />
</Layout>