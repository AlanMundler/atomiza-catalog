---
import Layout from '@/layouts/Layout.astro';
import ProductDetail from '@/components/product/ProductDetail.astro';
import perfumesData from '@/data/perfumes.json';
import { site } from '@/site.config';
import type { Perfume } from '@/data/types';

export async function getStaticPaths() {
  const perfumes: Perfume[] = perfumesData.perfumes as Perfume[];
  
  return perfumes.map((perfume) => ({
    params: { slug: perfume.slug },
    props: { perfume }
  }));
}

const { perfume } = Astro.props;
---

<Layout 
  title={`${perfume.brand} ${perfume.name} - ${site.name}`} 
  description={`${perfume.brand} ${perfume.name} - ${perfume.olfactoryFamily}. Decant de 5ml disponible.`}
  ogImage={`og/${perfume.slug}.jpg`}
>
  <div class="container">
    <ProductDetail perfume={perfume} />
  </div>
</Layout>