---
import Layout from '@/layouts/Layout.astro';
import { getFamilias } from '@/data/familias';
import { formatPrice } from '@/utils/formatters';
import { site } from '@/site.config';
import type { Perfume } from '@/data/types';

const BASE = site.basePath;
const familias = getFamilias();

const pageTitle = `Familias olfativas · ${site.addressLocality}`;
const pageDescription = `Explorá decants de 5ml por familia olfativa: orientales, frescos, amaderados, dulces y más, en ${site.addressLocality}.`;

function desdePrecio(items: Perfume[]): string {
  const precios = items.flatMap((p) => p.sizes.map((s) => s.price)).filter((n) => Number.isFinite(n));
  return precios.length > 0 ? formatPrice(Math.min(...precios)) : 'a confirmar';
}
---

<Layout title={pageTitle} description={pageDescription}>
  <section class="famhub-hero" aria-labelledby="famhub-title">
    <div class="container">
      <h1 id="famhub-title" class="famhub-title">Buscá por familia olfativa</h1>
      <p class="famhub-subtitle">
        ¿Dulce, fresco, amaderado? Elegí la familia que va con vos y descubrí
        sus decants de 5ml.
      </p>
    </div>
  </section>

  <section class="famhub-list" aria-label="Familias olfativas">
    <div class="container">
      <div class="famhub-grid">
        {familias.map((f) => (
          <a href={`${BASE}familias/${f.slug}/`} class="famhub-card">
            <div class="famhub-card-body">
              <h2 class="famhub-card-title">{f.name}</h2>
              <p class="famhub-card-sub">{f.items.length} {f.items.length === 1 ? 'decant' : 'decants'}</p>
            </div>
            <span class="famhub-card-price">desde {desdePrecio(f.items)}</span>
          </a>
        ))}
      </div>
      <div class="famhub-cta">
        <a href={`${BASE}decants/`} class="famhub-alt-link">¿Buscás un aroma famoso puntual? →</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .famhub-hero {
    padding: var(--spacing-stack-md) 0 var(--spacing-stack-sm);
    text-align: center;
  }

  .famhub-title {
    font-family: var(--font-family);
    font-size: var(--font-display-lg-size);
    font-weight: var(--font-display-lg-weight);
    letter-spacing: var(--font-display-lg-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
    margin: 0 auto var(--spacing-stack-sm);
    max-width: 720px;
  }

  @media (max-width: 640px) {
    .famhub-title {
      font-size: var(--font-headline-md-size);
      letter-spacing: var(--font-headline-md-tracking);
    }
  }

  .famhub-subtitle {
    font-family: var(--font-family);
    font-size: var(--font-body-lg-size);
    line-height: var(--font-body-lg-line-height);
    color: var(--color-on-surface-variant);
    margin: 0 auto;
    max-width: 640px;
  }

  @media (max-width: 640px) {
    .famhub-subtitle {
      font-size: var(--font-body-md-size);
    }
  }

  .famhub-list {
    padding: var(--spacing-stack-lg) 0;
  }

  .famhub-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-stack-sm);
  }

  @media (min-width: 768px) {
    .famhub-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .famhub-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: var(--spacing-stack-md);
    border: var(--border-width) solid var(--color-outline-variant);
    border-radius: var(--border-radius);
    background-color: var(--color-surface-container);
    text-decoration: none;
    transition: border-color var(--transition-duration) var(--transition-easing);
  }

  .famhub-card:hover {
    border-color: var(--color-primary);
  }

  .famhub-card-title {
    font-family: var(--font-family);
    font-size: var(--font-headline-md-size);
    font-weight: var(--font-headline-md-weight);
    color: var(--color-on-surface);
    margin: 0;
  }

  .famhub-card-sub {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    color: var(--color-on-surface-variant);
    margin: 4px 0 0;
  }

  .famhub-card-price {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-primary);
    white-space: nowrap;
  }

  .famhub-cta {
    text-align: center;
    margin-top: var(--spacing-stack-md);
  }

  .famhub-alt-link {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
