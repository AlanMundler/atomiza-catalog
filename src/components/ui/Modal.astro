---
interface Props {
  id?: string;
  title?: string;
  class?: string;
  children: any;
}

const { id = '', title, class: className = '', children } = Astro.props;
const modalId = id || `modal-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="modal-root" id={modalId} data-modal-root>
  <div class="modal-backdrop" data-modal-backdrop role="presentation" aria-hidden="true"></div>
  <dialog 
    class={`modal ${className}`}
    data-modal-dialog
    role="dialog"
    aria-modal="true"
    aria-labelledby={title ? `${modalId}-title` : undefined}
  >
    {title && <h2 id={`${modalId}-title`} class="modal-title">{title}</h2>}
    <button 
      class="modal-close" 
      data-modal-close
      aria-label="Cerrar modal"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <div class="modal-content">
      <slot>{children}</slot>
    </div>
  </dialog>
</div>

<script>
  import { bindOnce, onPageLoad, onWindowOnce } from '@/utils/view-transitions';

  function resetBodyOverflowIfClosed() {
    if (!document.querySelector('.drawer--open') && !document.querySelector('dialog[open]')) {
      document.body.style.overflow = '';
    }
  }

  onWindowOnce('modal-escape', 'keydown', (e) => {
    if ((e as KeyboardEvent).key === 'Escape') {
      document.querySelectorAll('dialog[open]').forEach((dialog) => (dialog as HTMLDialogElement).close());
      resetBodyOverflowIfClosed();
    }
  });

  onPageLoad('modal', () => {
    document.querySelectorAll('[data-modal-root]').forEach((root) => {
      bindOnce(root, (el) => {
        const dialog = el.querySelector('[data-modal-dialog]') as HTMLDialogElement | null;
        const backdrop = el.querySelector('[data-modal-backdrop]') as HTMLElement | null;
        const closeBtn = el.querySelector('[data-modal-close]') as HTMLElement | null;
        if (!dialog) return;

        const open = () => {
          if (!dialog.open) {
            dialog.showModal();
          }
          document.body.style.overflow = 'hidden';
        };

        const close = () => {
          if (dialog.open) {
            dialog.close();
          }
          resetBodyOverflowIfClosed();
        };

        closeBtn?.addEventListener('click', close);
        backdrop?.addEventListener('click', close);

        dialog.addEventListener('close', resetBodyOverflowIfClosed);

        dialog.addEventListener('click', (e) => {
          if (e.target === dialog) close();
        });

        el.addEventListener('modal:open', () => open());
        el.addEventListener('modal:close', () => close());

        // Store open/close helpers so other scripts can trigger them
        (el as any)._modalOpen = open;
        (el as any)._modalClose = close;
      });
    });

    // Close any modal left open by the previous navigation
    document.querySelectorAll('dialog[open]').forEach((dialog) => (dialog as HTMLDialogElement).close());
    resetBodyOverflowIfClosed();
  });
</script>

<style>
  .modal-root {
    position: relative;
  }

  .modal-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(4px);
    /* Por encima del drawer (backdrop 999 / aside 1000) */
    z-index: 1100;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--transition-duration) var(--transition-easing), visibility var(--transition-duration) var(--transition-easing);
  }

  .modal {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background-color: var(--color-surface-container);
    border: var(--border-width) solid var(--color-outline-variant);
    border-radius: var(--border-radius);
    padding: 0;
    max-width: 90vw;
    max-height: 90vh;
    width: var(--modal-width, 500px);
    z-index: 1101;
    overflow: hidden;
    animation: slide-up var(--transition-duration) var(--transition-easing);
  }

  .modal[open] ~ .modal-backdrop {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .modal::backdrop {
    display: none;
  }

  .modal-title {
    font-family: var(--font-family);
    font-size: var(--font-headline-md-size);
    font-weight: var(--font-headline-md-weight);
    line-height: var(--font-headline-md-line-height);
    letter-spacing: var(--font-headline-md-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
    padding: 24px 24px 0;
    margin: 0;
  }

  .modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-on-surface-variant);
    background: transparent;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    transition: all var(--transition-duration) var(--transition-easing);
    z-index: 1;
  }

  .modal-close:hover {
    color: var(--color-primary);
    background-color: var(--color-surface-container-high);
  }

  .modal-close:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .modal-content {
    padding: 24px;
    overflow-y: auto;
    max-height: calc(90vh - 80px);
  }

  @media (max-width: 640px) {
    .modal {
      width: calc(100vw - 40px);
      max-width: none;
    }
  }
</style>
