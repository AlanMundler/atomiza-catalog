---
interface Props {
  position?: 'left' | 'right';
  id?: string;
  class?: string;
}

const { position = 'right', id, class: className = '' } = Astro.props;
---

<div class={`drawer-root ${className}`} data-drawer-root {id}>
  <aside 
    class={`drawer drawer--${position}`}
    role="dialog"
    aria-modal="true"
    aria-label={position === 'right' ? 'Carrito de compras' : 'Menú de navegación'}
  >
    <div class="drawer-header">
      <slot name="header">
        <h2 class="drawer-title">Carrito</h2>
      </slot>
      <button 
        class="drawer-close" 
        data-drawer-close
        aria-label="Cerrar"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="drawer-content">
      <slot />
    </div>
  </aside>
  <div 
    class="drawer-backdrop" 
    role="presentation"
    aria-hidden="true"
  ></div>
</div>

<script>
  import { bindOnce, onPageLoad, onWindowOnce } from '@/utils/view-transitions';

  function resetBodyOverflowIfClosed() {
    if (!document.querySelector('.drawer--open') && !document.querySelector('dialog[open]')) {
      document.body.style.overflow = '';
    }
  }

  onWindowOnce('drawer-escape', 'keydown', (e) => {
    if ((e as KeyboardEvent).key === 'Escape') {
      const openDrawer = document.querySelector('.drawer--open');
      if (openDrawer) {
        openDrawer.classList.remove('drawer--open');
        resetBodyOverflowIfClosed();
      }
    }
  });

  onPageLoad('drawer', () => {
    document.querySelectorAll('[data-drawer-root]').forEach((root) => {
      bindOnce(root, (el) => {
        const drawer = el.querySelector('.drawer');
        const backdrop = el.querySelector('.drawer-backdrop') as HTMLElement | null;
        if (!drawer || !backdrop) return;

        const openDrawer = () => {
          drawer.classList.add('drawer--open');
          backdrop.style.opacity = '1';
          document.body.style.overflow = 'hidden';
        };

        const closeDrawer = () => {
          drawer.classList.remove('drawer--open');
          backdrop.style.opacity = '0';
          resetBodyOverflowIfClosed();
        };

        const closeBtn = el.querySelector('[data-drawer-close]');
        closeBtn?.addEventListener('click', closeDrawer);

        backdrop.addEventListener('click', closeDrawer);

        el.addEventListener('drawer:toggle', (e: Event) => {
          const detail = (e as CustomEvent).detail;
          if (detail?.open) {
            openDrawer();
          } else {
            closeDrawer();
          }
        });
      });
    });

    // Close any drawer left open by the previous navigation
    document.querySelectorAll('.drawer--open').forEach((d) => d.classList.remove('drawer--open'));
    resetBodyOverflowIfClosed();
  });
</script>

<style>
  .drawer-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--transition-duration) var(--transition-easing), visibility var(--transition-duration) var(--transition-easing);
  }

  .drawer {
    position: fixed;
    top: 0;
    bottom: 0;
    width: 100%;
    max-width: var(--drawer-width, 400px);
    background-color: var(--color-surface-container);
    border: var(--border-width) solid var(--color-outline-variant);
    z-index: 1000;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .drawer--left {
    left: 0;
    border-right: var(--border-width) solid var(--color-outline-variant);
    transform: translateX(-100%);
  }

  .drawer--right {
    right: 0;
    border-left: var(--border-width) solid var(--color-outline-variant);
    transform: translateX(100%);
  }

  .drawer--open {
    transform: translateX(0);
  }

  .drawer--open ~ .drawer-backdrop {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    border-bottom: var(--border-width) solid var(--color-outline-variant);
    flex-shrink: 0;
  }

  .drawer-title {
    font-family: var(--font-family);
    font-size: var(--font-headline-md-size);
    font-weight: var(--font-headline-md-weight);
    line-height: var(--font-headline-md-line-height);
    letter-spacing: var(--font-headline-md-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
    margin: 0;
  }

  .drawer-close {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-on-surface-variant);
    background: transparent;
    border: none;
    border-radius: var(--border-radius);
    cursor: pointer;
    transition: all var(--transition-duration) var(--transition-easing);
  }

  .drawer-close:hover {
    color: var(--color-primary);
    background-color: var(--color-surface-container-high);
  }

  .drawer-close:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .drawer-content {
    flex: 1;
    overflow-y: auto;
    padding: 24px;
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 640px) {
    .drawer {
      max-width: 100%;
    }
  }
</style>