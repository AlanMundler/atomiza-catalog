---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  disabled?: boolean;
  type?: 'button' | 'submit' | 'reset';
  title?: string;
  class?: string;
  children: any;
}

const { 
  variant = 'primary', 
  size = 'md', 
  disabled = false, 
  type = 'button', 
  class: className = '',
  children,
  ...attrs 
} = Astro.props;
---

<button
  type={type}
  disabled={disabled}
  class={`btn btn--${variant} btn--${size} ${className} ${disabled ? 'btn--disabled' : ''}`}
  {...attrs}
>
  <slot>{children}</slot>
</button>