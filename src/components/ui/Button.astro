---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  disabled?: boolean;
  type?: 'button' | 'submit' | 'reset';
  title?: string;
  class?: string;
  children: any;
}

const { 
  variant = 'primary', 
  size = 'md', 
  disabled = false, 
  type = 'button', 
  class: className = '',
  children,
  ...attrs 
} = Astro.props;

const variantMap = {
  primary: 'btn-primary',
  secondary: 'btn-secondary',
  ghost: 'btn-ghost'
};

const sizeMap = {
  sm: 'btn-sm',
  md: 'btn-md',
  lg: 'btn-lg'
};
---

<button
  type={type}
  disabled={disabled}
  class={`btn ${variantMap[variant]} ${sizeMap[size]} ${className} ${disabled ? 'btn-disabled' : ''}`}
  {...attrs}
>
  <slot>{children}</slot>
</button>
