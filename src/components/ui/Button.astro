---
interface Props {
  variant?: 'primary' | 'secondary';
  size?: 'md' | 'lg';
  disabled?: boolean;
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  disabled = false,
  class: className = '',
  ...attrs
} = Astro.props;
---

<button
  type="button"
  disabled={disabled}
  class={`btn btn--${variant} btn--${size} ${className} ${disabled ? 'btn--disabled' : ''}`}
  {...attrs}
>
  <slot />
</button>