---
interface Props {
  variant?: 'in-stock' | 'low-stock' | 'out-of-stock' | 'default';
  class?: string;
  children: any;
}

const { variant = 'default', class: className = '', children, ...attrs } = Astro.props;

const variantClasses = {
  'in-stock': 'badge-success',
  'low-stock': 'badge-warning',
  'out-of-stock': 'badge-error',
  'default': 'badge-ghost'
};
---

<span class={`badge badge-sm border-0 ${variantClasses[variant]} ${className}`} {...attrs}>
  <slot>{children}</slot>
</span>
