---
interface Props {
  variant: 'in-stock' | 'low-stock' | 'out-of-stock';
  class?: string;
}

const { variant, class: className = '', ...attrs } = Astro.props;

const variantClasses = {
  'in-stock': 'chip--in-stock',
  'low-stock': 'chip--low-stock',
  'out-of-stock': 'chip--out-of-stock',
};
---

<span class={`chip ${variantClasses[variant]} ${className}`} {...attrs}>
  <slot />
</span>

<!-- is:global por el mismo motivo que ProductCard: el chip se renderiza
  también dentro de cards inyectadas por JS en la home. -->
<style is:global>
  .chip {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    line-height: var(--font-label-sm-line-height);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    border-radius: var(--border-radius);
    border: var(--border-width) solid transparent;
    padding: 3px 10px;
    height: 22px;
    white-space: nowrap;
    /* Plato negro del sistema (no transparente): el chip cae sobre el área
       blanca de las fotos (--color-image-bg) en hub/catalogo/home, y los
       textos de estado claros (#8dba7d/#c5a059/#a3a3a3) sobre blanco dan
       ~2:1. Sobre este negro pasan de 7:1. En fondos oscuros (SizeSelector,
       drawer) el plato es apenas más hondo que la superficie: el borde del
       color de estado mantiene la identidad. Contraste AAA en los 3 estados. */
    background-color: var(--color-surface-container-lowest);
  }

  .chip--in-stock {
    color: var(--color-status-in-stock);
    border-color: var(--color-status-in-stock);
  }

  .chip--low-stock {
    color: var(--color-status-low-stock);
    border-color: var(--color-status-low-stock);
  }

  .chip--out-of-stock {
    color: var(--color-status-out-of-stock);
    border-color: var(--color-status-out-of-stock);
  }
</style>