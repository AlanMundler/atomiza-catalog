---
import { site } from '@/site.config';
import { jsonLd } from '@/utils/jsonld';

// Consentimiento + carga diferida de tracking (Google, Meta, TikTok).
// La lógica vive en `src/utils/consent.ts`: módulo bundleado, minificado y
// cacheado una sola vez. Este componente solo expone la config en un
// `<script type="application/json">` (contenido permitido dentro de <head>)
// que reemplaza al viejo `define:vars`, que generaba ~130 líneas inline
// repetidas en cada una de las 199 páginas.
// Para desactivar el tracking, vaciar los IDs en `site.config.ts`: sin
// tracking no se renderiza ni la config ni el script.
const hasTracking = Boolean(site.gaMeasurementId || site.metaPixelId || site.tiktokPixelId);
const consentConfig = {
  consentKey: site.storage.consent,
  gaId: site.gaMeasurementId,
  metaPixelId: site.metaPixelId,
  tiktokPixelId: site.tiktokPixelId,
  securePrivacy: Boolean(site.secureprivacyScriptId),
};
---

{hasTracking && (
  <>
    <script is:inline type="application/json" id="consent-config" set:html={jsonLd(consentConfig)} />
    <script>
      import { initConsent, type ConsentConfig } from '@/utils/consent';
      import { initAnalytics } from '@/utils/analytics-client';

      const configEl = document.getElementById('consent-config');
      if (configEl?.textContent) {
        initConsent(JSON.parse(configEl.textContent) as ConsentConfig);
        initAnalytics();
      }
    </script>
  </>
)}
