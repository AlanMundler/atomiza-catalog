---
import { site } from '@/site.config';
const BASE = site.basePath;
const currentYear = new Date().getFullYear();
---

<footer class="footer" role="contentinfo">
  <div class="footer-inner container">
    <div class="footer-main">
      <div class="footer-brand">
        <a href={BASE} class="footer-logo" aria-label={`${site.name} - inicio`}>{site.name}</a>
        <p class="footer-tagline">{site.tagline}</p>
        <p class="footer-locality">{site.addressLocality}, {site.addressRegion}</p>
      </div>
      <nav class="footer-nav" aria-label="Secciones del sitio">
        <a href={`${BASE}catalogo/`} class="footer-nav-link">Catálogo</a>
        <a href={`${BASE}tridentes/`} class="footer-nav-link">Tridentes</a>
        <a href={`${BASE}quiz/`} class="footer-nav-link">Descubrí tu perfume</a>
        <a href={`${BASE}decants/`} class="footer-nav-link">Por aroma famoso</a>
        <a href={`${BASE}envios/`} class="footer-nav-link">Envíos</a>
      </nav>
      <div class="footer-contact">
        <a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer" class="footer-nav-link">WhatsApp</a>
        <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer" class="footer-nav-link">Instagram @{site.instagramHandle}</a>
        <a href={site.tiktokUrl} target="_blank" rel="noopener noreferrer" class="footer-nav-link">TikTok @{site.tiktokHandle}</a>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copyright">© {currentYear} {site.name}. Todos los derechos reservados.</p>
      <nav class="footer-legal" aria-label="Enlaces legales">
        <a href={`${BASE}blog/`} class="footer-legal-link">Guías</a>
        <a href={`${BASE}envios/`} class="footer-legal-link">Envíos</a>
        <a href={`${BASE}terminos/`} class="footer-legal-link">Términos y condiciones</a>
        <a href={`${BASE}privacidad/`} class="footer-legal-link">Política de privacidad</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-surface-container-lowest);
    border-top: var(--border-width) solid var(--color-outline-variant);
    padding: var(--spacing-stack-lg) 0 var(--spacing-stack-md);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-stack-md);
  }

  .footer-main {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-stack-sm);
    text-align: center;
  }

  @media (min-width: 768px) {
    .footer-main {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .footer-logo {
    font-family: var(--font-family);
    font-size: 24px;
    font-weight: 200;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-on-surface);
    text-decoration: none;
  }

  .footer-logo:hover {
    color: var(--color-primary);
  }

  .footer-tagline {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    color: var(--color-on-surface-variant);
    margin: 4px 0 0;
  }

  .footer-locality {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    color: var(--color-on-surface-variant);
    margin: 4px 0 0;
  }

  .footer-nav,
  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: center;
  }

  @media (min-width: 768px) {
    .footer-nav,
    .footer-contact {
      align-items: flex-start;
    }
  }

  .footer-nav-link {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    color: var(--color-on-surface);
    text-decoration: none;
    padding: 6px 0;
    transition: color var(--transition-duration) var(--transition-easing);
  }

  .footer-nav-link:hover {
    color: var(--color-primary);
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-stack-sm);
    padding-top: var(--spacing-stack-sm);
    border-top: var(--border-width) solid var(--color-outline-variant);
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .footer-copyright {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    color: var(--color-on-surface-variant);
    margin: 0;
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px 24px;
  }

  .footer-legal-link {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
    transition: color var(--transition-duration) var(--transition-easing);
  }

  .footer-legal-link:hover {
    color: var(--color-primary);
  }
</style>