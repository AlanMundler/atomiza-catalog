---
const BASE = '/atomiza-catalog/';
---

<footer class="footer" role="contentinfo">
  <div class="footer-inner container">
    <div class="footer-main">
      <div class="footer-brand">
        <span class="footer-logo">ATOMIZA</span>
        <p class="footer-tagline">Decants de autor</p>
      </div>

      <nav class="footer-social" aria-label="Redes sociales">
        <a 
          href="https://instagram.com/atomiza.cba" 
          target="_blank" 
          rel="noopener noreferrer"
          class="social-link social-link--instagram"
          aria-label="Instagram @atomiza.cba"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
          <span>@atomiza.cba</span>
        </a>
        <a 
          href="https://wa.me/5491123456789" 
          target="_blank" 
          rel="noopener noreferrer"
          class="social-link"
          aria-label="WhatsApp"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
        </a>
        <a 
          href="mailto:hola@atomiza.com.ar" 
          class="social-link"
          aria-label="Email"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
        </a>
      </nav>
    </div>

    <div class="footer-bottom">
      <p class="footer-copyright">© 2024 ATOMIZA. Todos los derechos reservados.</p>
      <nav class="footer-legal" aria-label="Enlaces legales">
        <a href={`${BASE}terminos/`} class="footer-legal-link">Términos y condiciones</a>
        <a href={`${BASE}privacidad/`} class="footer-legal-link">Política de privacidad</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-surface-container-lowest);
    border-top: var(--border-width) solid var(--color-outline-variant);
    padding: var(--spacing-stack-lg) 0 var(--spacing-stack-md);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-stack-md);
  }

  .footer-main {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-stack-sm);
    text-align: center;
  }

  @media (min-width: 768px) {
    .footer-main {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .footer-logo {
    font-family: var(--font-family);
    font-size: 24px;
    font-weight: 200;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-on-surface);
  }

  .footer-tagline {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    color: var(--color-on-surface-variant);
    margin: 4px 0 0;
  }

  .footer-social {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-on-surface-variant);
    transition: color var(--transition-duration) var(--transition-easing);
  }

  .social-link:hover {
    color: var(--color-primary);
  }

  .social-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
    border-radius: var(--border-radius);
  }

  .social-link--instagram span {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-stack-sm);
    padding-top: var(--spacing-stack-sm);
    border-top: var(--border-width) solid var(--color-outline-variant);
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .footer-copyright {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    color: var(--color-on-surface-variant);
    margin: 0;
  }

  .footer-legal {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .footer-legal-link {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
    transition: color var(--transition-duration) var(--transition-easing);
  }

  .footer-legal-link:hover {
    color: var(--color-primary);
  }
</style>