---
import Button from '@/components/ui/Button.astro';
import Drawer from '@/components/ui/Drawer.astro';
import { getCartItemCount } from '@/utils/cart';
import { buildWhatsAppLink } from '@/utils/formatters';
import { assetUrl, site } from '@/site.config';

const cartCount = getCartItemCount();
const BASE = site.basePath;
const whatsappLink = buildWhatsAppLink(site.whatsappNumber, site.whatsappMessage);
---

<header class="header" role="banner">
  <div class="header-inner container">
    <a href={BASE} class="header-logo" aria-label={`${site.name} - ${site.tagline}`}>
      <span class="logo-text">{site.name}</span>
      <span class="logo-lema">{site.tagline}</span>
    </a>

    <div class="header-actions">
      <a 
        href={site.instagramUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="header-social-btn"
        aria-label={`Instagram @${site.instagramHandle}`}
      >
        <img src={assetUrl('images/icons/instagram.svg')} width="28" height="28" alt="" aria-hidden="true" />
      </a>
      <a 
        href={whatsappLink} 
        target="_blank" 
        rel="noopener noreferrer"
        class="header-social-btn"
        aria-label="WhatsApp"
      >
        <img src={assetUrl('images/icons/whatsapp.svg')} width="28" height="28" alt="" aria-hidden="true" />
      </a>
      <a href={`${BASE}catalogo/`} class="header-catalogo-btn">Catálogo</a>
      <a href={`${BASE}quiz/`} class="header-quiz-btn">Descubrí tu perfume</a>

      <button 
        class="header-cart-btn"
        aria-label={`Carrito de compras, ${cartCount} artículos`}
        data-cart-trigger
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        <span class="cart-count" data-cart-count aria-hidden="true" hidden>{cartCount}</span>
      </button>

      <button 
        class="header-menu-btn"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-drawer"
        data-menu-trigger
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<Drawer 
  position="left" 
  id="mobile-drawer"
  class="mobile-drawer"
>
  <h2 slot="header" class="mobile-drawer-title">Menú</h2>
  <nav class="mobile-nav" role="navigation" aria-label="Menú móvil">
    <a href={BASE} class="mobile-nav-link">Inicio</a>
    <a href={`${BASE}catalogo/`} class="mobile-nav-link">Catálogo</a>
    <a href={`${BASE}quiz/`} class="mobile-nav-link">Descubrí tu perfume</a>
  </nav>
  <div class="mobile-cart-summary">
    <h3 class="mobile-cart-title">Carrito</h3>
    <p class="mobile-cart-count" data-cart-count-mobile>{cartCount} artículos</p>
    <Button variant="secondary" class="mobile-cart-btn" data-mobile-cart-open>
      Ver carrito
    </Button>
  </div>
  <div class="mobile-socials">
    <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer" class="mobile-social-link">
      <img src={assetUrl('images/icons/instagram.svg')} width="22" height="22" alt="" aria-hidden="true" />
      Instagram
    </a>
    <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="mobile-social-link">
      <img src={assetUrl('images/icons/whatsapp.svg')} width="22" height="22" alt="" aria-hidden="true" />
      WhatsApp
    </a>
  </div>
</Drawer>

<script>
  import { bindOnce, onPageLoad, onWindowOnce } from '@/utils/view-transitions';
  import { getCart } from '@/utils/cart';

  let ticking = false;
  let cartTrigger: HTMLElement | null = null;

  function handleScroll() {
    const header = document.querySelector('.header');
    const currentScroll = window.scrollY;

    if (currentScroll > 20) {
      header?.classList.add('header--scrolled');
    } else {
      header?.classList.remove('header--scrolled');
    }

    ticking = false;
  }

  // Header scroll effect
  onWindowOnce('header-scroll', 'scroll', () => {
    if (!ticking) {
      requestAnimationFrame(handleScroll);
      ticking = true;
    }
  }, { passive: true });

  // Listen for cart updates
  onWindowOnce('header-cart-update', 'cart:update', () => {
    updateCartCount();
  });

  function updateCartCount() {
    const badge = document.querySelector('[data-cart-count]') as HTMLElement | null;
    const mobileCount = document.querySelector('[data-cart-count-mobile]') as HTMLElement | null;
    const cart = getCart();
    const newCount = cart.items.reduce((sum, item) => sum + item.quantity, 0);
    if (badge) {
      badge.textContent = String(newCount);
      badge.hidden = newCount === 0;
    }
    if (mobileCount) {
      mobileCount.textContent = `${newCount} ${newCount === 1 ? 'artículo' : 'artículos'}`;
    }
    if (cartTrigger) {
      cartTrigger.setAttribute(
        'aria-label',
        `Carrito de compras, ${newCount} ${newCount === 1 ? 'artículo' : 'artículos'}`
      );
    }
  }

  onPageLoad('header', () => {
    cartTrigger = document.querySelector('[data-cart-trigger]');
    const menuTrigger = document.querySelector('[data-menu-trigger]');
    const mobileDrawer = document.querySelector('#mobile-drawer');

    // Cart drawer trigger
    if (cartTrigger) {
      bindOnce(cartTrigger, (el) => {
        el.addEventListener('click', () => {
          const event = new CustomEvent('cart:open');
          window.dispatchEvent(event);
        });
      });
    }

    // "Ver carrito" del menú móvil: cierra el drawer y abre el carrito
    const mobileCartBtn = document.querySelector('[data-mobile-cart-open]');
    if (mobileCartBtn && mobileDrawer) {
      bindOnce(mobileCartBtn, (el) => {
        el.addEventListener('click', () => {
          mobileDrawer.dispatchEvent(new CustomEvent('drawer:toggle', { detail: { open: false } }));
          window.dispatchEvent(new CustomEvent('cart:open'));
        });
      });
    }

    // Mobile menu trigger
    if (menuTrigger && mobileDrawer) {
      bindOnce(menuTrigger, () => {
        menuTrigger.addEventListener('click', () => {
          const drawerComponent = mobileDrawer.querySelector('.drawer');
          const isOpen = drawerComponent
            ? drawerComponent.classList.contains('drawer--open')
            : false;
          menuTrigger.setAttribute('aria-expanded', String(!isOpen));
          mobileDrawer.dispatchEvent(new CustomEvent('drawer:toggle', { detail: { open: !isOpen } }));
        });
      });

      // El drawer puede cerrarse por backdrop, X o Escape: el trigger se
      // sincroniza con el estado real para no quedar en "abierto". Se escucha
      // en window vía evento burbujeante porque el root del drawer ya quedó
      // marcado como bound por el propio Drawer (bindOnce es por elemento).
      onWindowOnce('menu-aria-close', 'drawer:close', () => {
        document.querySelector('[data-menu-trigger]')?.setAttribute('aria-expanded', 'false');
      });
    }

    updateCartCount();
  });
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background-color: rgba(18, 20, 20, 0.8);
    backdrop-filter: blur(20px);
    border-bottom: var(--border-width) solid var(--color-outline-variant);
    transition: all var(--transition-duration) var(--transition-easing);
  }

  .header--scrolled {
    background-color: rgba(18, 20, 20, 0.95);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    gap: 24px;
  }

  .header-logo {
    flex-shrink: 0;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    line-height: 1;
  }

  .logo-text {
    font-family: var(--font-family);
    font-size: 28px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-on-surface);
    transition: color var(--transition-duration) var(--transition-easing);
  }

  .logo-lema {
    font-family: var(--font-family);
    font-size: 10px;
    font-weight: 300;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
    white-space: nowrap;
    transition: color var(--transition-duration) var(--transition-easing);
  }

  @media (max-width: 640px) {
    .logo-text {
      font-size: 22px;
      letter-spacing: 0.12em;
    }

    .logo-lema {
      font-size: 9px;
      letter-spacing: 0.18em;
    }
  }

  .header-logo:hover .logo-text,
  .header-logo:hover .logo-lema {
    color: var(--color-primary);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  @media (max-width: 640px) {
    .header-actions {
      gap: 2px;
    }
  }

  .header-social-btn {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-on-surface);
    background: transparent;
    border: none;
    border-radius: var(--border-radius);
    cursor: pointer;
    text-decoration: none;
    transition: all var(--transition-duration) var(--transition-easing);
  }

  .header-social-btn:hover {
    color: var(--color-primary);
    background-color: var(--color-surface-container-high);
  }

  .header-social-btn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .header-social-btn + .header-social-btn {
    margin-left: 8px;
  }

  @media (max-width: 640px) {
    .header-social-btn {
      display: none;
    }
  }

  .header-catalogo-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-primary);
    background-color: transparent;
    border: var(--border-width) solid var(--color-primary);
    border-radius: var(--border-radius);
    padding: 8px 16px;
    height: 40px;
    white-space: nowrap;
    text-decoration: none;
    transition: all var(--transition-duration) var(--transition-easing);
  }

  @media (max-width: 640px) {
    .header-catalogo-btn {
      display: none;
    }
  }

  .header-catalogo-btn:hover {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
  }

  .header-catalogo-btn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .header-quiz-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
    background-color: transparent;
    border: none;
    border-radius: var(--border-radius);
    padding: 8px 12px;
    height: 40px;
    white-space: nowrap;
    text-decoration: none;
    transition: all var(--transition-duration) var(--transition-easing);
  }

  @media (max-width: 640px) {
    .header-quiz-btn {
      display: none;
    }
  }

  .header-quiz-btn:hover {
    color: var(--color-primary);
  }

  .header-quiz-btn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .header-cart-btn {
    position: relative;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-on-surface);
    background: transparent;
    border: none;
    border-radius: var(--border-radius);
    cursor: pointer;
    transition: all var(--transition-duration) var(--transition-easing);
  }

  .header-cart-btn:hover {
    color: var(--color-primary);
    background-color: var(--color-surface-container-high);
  }

  .header-cart-btn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  @media (max-width: 640px) {
    .header-cart-btn,
    .header-menu-btn {
      width: 42px;
      height: 42px;
    }

    .header-cart-btn {
      margin-right: 8px;
    }
  }

  .cart-count {
    position: absolute;
    top: 4px;
    right: 4px;
    min-width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-family);
    font-size: 10px;
    font-weight: 500;
    color: var(--color-on-primary);
    background-color: var(--color-primary);
    border-radius: 50%;
    padding: 0 4px;
  }

  .header-menu-btn {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-on-surface);
    background: transparent;
    border: none;
    border-radius: var(--border-radius);
    cursor: pointer;
    transition: all var(--transition-duration) var(--transition-easing);
  }

  .header-menu-btn:hover {
    color: var(--color-primary);
    background-color: var(--color-surface-container-high);
  }

  @media (min-width: 1024px) {
    .header-menu-btn {
      display: none;
    }
  }

  /* Mobile drawer styles */
  .mobile-drawer-title {
    font-family: var(--font-family);
    font-size: var(--font-headline-md-size);
    font-weight: var(--font-headline-md-weight);
    line-height: var(--font-headline-md-line-height);
    letter-spacing: var(--font-headline-md-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
    margin: 0;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 32px;
  }

  .mobile-nav-link {
    font-family: var(--font-family);
    font-size: var(--font-headline-md-size);
    font-weight: var(--font-headline-md-weight);
    letter-spacing: var(--font-headline-md-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
    padding: 12px 0;
    border-bottom: var(--border-width) solid var(--color-outline-variant);
    transition: color var(--transition-duration) var(--transition-easing);
  }

  .mobile-nav-link:hover {
    color: var(--color-primary);
  }

  .mobile-cart-summary {
    padding: 24px 0;
    border-top: var(--border-width) solid var(--color-outline-variant);
  }

  .mobile-cart-title {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
    margin: 0 0 8px;
  }

  .mobile-cart-count {
    font-family: var(--font-family);
    font-size: var(--font-body-lg-size);
    font-weight: var(--font-body-lg-weight);
    color: var(--color-on-surface);
    margin: 0 0 16px;
  }

  .mobile-cart-btn {
    width: 100%;
  }

  .mobile-socials {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: var(--spacing-stack-sm);
    border-top: var(--border-width) solid var(--color-outline-variant);
  }

  .mobile-social-link {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    font-weight: var(--font-body-md-weight);
    color: var(--color-on-surface);
    text-decoration: none;
    padding: 10px 0;
    transition: color var(--transition-duration) var(--transition-easing);
  }

  .mobile-social-link:hover {
    color: var(--color-primary);
  }
</style>