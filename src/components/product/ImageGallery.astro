---
import Modal from '@/components/ui/Modal.astro';
import type { PerfumeImage } from '@/data/types';

interface Props {
  images: PerfumeImage[];
  alt: string;
}

const { images, alt } = Astro.props;
const mainImage = images[0]?.src || '/images/placeholder.jpg';
const mainAlt = images[0]?.alt || alt;
---

<div class="image-gallery" role="region" aria-label="Galería de imágenes">
  <div class="image-gallery-main">
    <img 
      src={mainImage} 
      alt={mainAlt} 
      class="image-gallery-main-image"
      loading="eager"
      width="600"
      height="600"
      data-main-image
    />
  </div>

  {images.length > 1 && (
    <div class="image-gallery-thumbs" role="list" aria-label="Miniaturas">
      {images.map((image, index) => (
        <button
          class={`image-gallery-thumb ${index === 0 ? 'image-gallery-thumb--active' : ''}`}
          data-thumb-index={index}
          data-image-src={image.src}
          aria-label={`Ver imagen ${index + 1}`}
          aria-selected={index === 0}
        >
          <img src={image.src} alt={image.alt} loading="lazy" width="80" height="80" />
        </button>
      ))}
    </div>
  )}

  <Modal 
    id="image-zoom-modal"
    onClose={() => {}}
    class="image-zoom-modal"
  >
    <div class="image-zoom-content">
      <img 
        src={mainImage} 
        alt={mainAlt} 
        class="image-zoom-image"
        data-zoom-image
      />
    </div>
  </Modal>
</div>

<script>
  import { bindOnce, onPageLoad, onWindowOnce } from '@/utils/view-transitions';

  function resetBodyOverflowIfClosed() {
    if (!document.querySelector('.drawer--open') && !document.querySelector('dialog[open]')) {
      document.body.style.overflow = '';
    }
  }

  // Close zoom modal on Escape
  onWindowOnce('gallery-escape', 'keydown', (e) => {
    if ((e as KeyboardEvent).key === 'Escape') {
      document.querySelectorAll('dialog[open]').forEach((dialog) => (dialog as HTMLDialogElement).close());
      resetBodyOverflowIfClosed();
    }
  });

  onPageLoad('image-gallery', () => {
    const mainImageEl = document.querySelector('[data-main-image]') as HTMLImageElement | null;
    const thumbs = Array.from(document.querySelectorAll('.image-gallery-thumb')) as HTMLElement[];
    const zoomModal = document.querySelector('#image-zoom-modal');
    const zoomImage = document.querySelector('[data-zoom-image]') as HTMLImageElement | null;

    let currentIndex = 0;

    function updateActiveThumb() {
      thumbs.forEach((thumb, i) => {
        thumb.classList.toggle('image-gallery-thumb--active', i === currentIndex);
        thumb.setAttribute('aria-selected', String(i === currentIndex));
      });
    }

    // Open zoom modal on main image click
    if (mainImageEl) {
      bindOnce(mainImageEl, (el) => {
        el.addEventListener('click', () => {
          if (zoomModal) {
            const modalDialog = zoomModal.querySelector('dialog');
            if (modalDialog && zoomImage) {
              zoomImage.src = el.src;
              modalDialog.showModal();
              document.body.style.overflow = 'hidden';
            }
          }
        });
      });
    }

    thumbs.forEach((thumb, index) => {
      bindOnce(thumb, (el) => {
        el.addEventListener('click', () => {
          const src = el.getAttribute('data-image-src');
          if (src && mainImageEl) {
            mainImageEl.src = src;
            currentIndex = index;
            updateActiveThumb();
          }
        });

        // Keyboard navigation for thumbnails
        el.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
            e.preventDefault();
            const newIndex = e.key === 'ArrowRight'
              ? (index + 1) % thumbs.length
              : (index - 1 + thumbs.length) % thumbs.length;
            (thumbs[newIndex] as HTMLElement).focus();
            (thumbs[newIndex] as HTMLElement).click();
          }
        });
      });
    });
  });
</script>

<style>
  .image-gallery {
    position: relative;
  }

  .image-gallery-main {
    aspect-ratio: 3 / 4;
    border-radius: var(--border-radius);
    overflow: hidden;
    background-color: var(--color-surface-container-high);
  }

  .image-gallery-main-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    cursor: zoom-in;
    transition: transform var(--transition-duration) var(--transition-easing);
  }

  .image-gallery-main-image:hover {
    transform: scale(1.02);
  }

  .image-gallery-thumbs {
    display: flex;
    gap: 12px;
    margin-top: 16px;
    overflow-x: auto;
    padding-bottom: 8px;
    -webkit-overflow-scrolling: touch;
  }

  .image-gallery-thumb {
    flex-shrink: 0;
    width: 80px;
    height: 80px;
    border: 2px solid transparent;
    border-radius: var(--border-radius);
    overflow: hidden;
    background: var(--color-surface-container-high);
    cursor: pointer;
    padding: 0;
    transition: all var(--transition-duration) var(--transition-easing);
  }

  .image-gallery-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-gallery-thumb:hover {
    border-color: var(--color-primary);
  }

  .image-gallery-thumb--active {
    border-color: var(--color-primary);
  }

  .image-gallery-thumb:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Zoom modal */
  .image-zoom-modal {
    --modal-width: 90vw;
    --modal-height: 90vh;
  }

  .image-zoom-content {
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .image-zoom-image {
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
  }
</style>