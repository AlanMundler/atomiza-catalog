---
import Modal from '@/components/ui/Modal.astro';
import { assetUrl } from '@/site.config';
import type { PerfumeImage } from '@/data/types';

interface Props {
  images: PerfumeImage[];
  alt: string;
  large?: boolean;
}

const { images, alt, large = false } = Astro.props;
const mainImage = assetUrl(images[0]?.src);
const mainAlt = images[0]?.alt || alt;
---

<div class="image-gallery" role="region" aria-label="Galería de imágenes">
  <div class="image-gallery-main">
    <img 
      src={mainImage} 
      alt={mainAlt} 
      class={`image-gallery-main-image${large ? ' image-gallery-main-image--large' : ''}`}
      loading="eager"
      fetchpriority="high"
      width="600"
      height="600"
      data-main-image
    />
  </div>

  {images.length > 1 && (
    <div class="image-gallery-thumbs" role="list" aria-label="Miniaturas">
      {images.map((image, index) => (
        <button
          class={`image-gallery-thumb ${index === 0 ? 'image-gallery-thumb--active' : ''}`}
          data-thumb-index={index}
          data-image-src={assetUrl(image.src)}
          aria-label={`Ver imagen ${index + 1}`}
          aria-pressed={index === 0}
        >
          <img src={assetUrl(image.src)} alt={image.alt} loading="lazy" width="80" height="80" />
        </button>
      ))}
    </div>
  )}

  <Modal 
    id="image-zoom-modal"
    class="image-zoom-modal"
  >
    <div class="image-zoom-content">
      <img 
        src={mainImage} 
        alt={mainAlt} 
        class="image-zoom-image"
        data-zoom-image
      />
    </div>
  </Modal>
</div>

<script>
  import { bindOnce, onPageLoad } from '@/utils/view-transitions';

  onPageLoad('image-gallery', () => {
    const mainImageEl = document.querySelector('[data-main-image]') as HTMLImageElement | null;
    const thumbs = Array.from(document.querySelectorAll('.image-gallery-thumb')) as HTMLElement[];
    const zoomModal = document.querySelector('#image-zoom-modal');
    const zoomImage = document.querySelector('[data-zoom-image]') as HTMLImageElement | null;

    let currentIndex = 0;

    function updateActiveThumb() {
      thumbs.forEach((thumb, i) => {
        thumb.classList.toggle('image-gallery-thumb--active', i === currentIndex);
        thumb.setAttribute('aria-pressed', String(i === currentIndex));
      });
    }

    // Open zoom popout on main image click
    if (mainImageEl) {
      bindOnce(mainImageEl, (el) => {
        el.addEventListener('click', () => {
          if (zoomModal && zoomImage) {
            zoomImage.src = el.src;
            resetZoom();
            const opener = (zoomModal as any)._modalOpen;
            if (opener) {
              opener();
            } else {
              const dialogEl2 = zoomModal.querySelector('dialog');
              if (dialogEl2 && !dialogEl2.open) {
                dialogEl2.showModal();
                document.body.style.overflow = 'hidden';
              }
            }
          }
        });
      });
    }

    let zoomed = false;

    function resetZoom() {
      zoomed = false;
      if (zoomImage) {
        zoomImage.style.transform = '';
        zoomImage.style.transformOrigin = '50% 50%';
      }
    }

    function zoomToPoint(clientX: number, clientY: number) {
      if (!zoomImage) return;
      const rect = zoomImage.getBoundingClientRect();
      if (rect.width === 0) return;
      const px = (clientX - rect.left) / rect.width;
      const py = (clientY - rect.top) / rect.height;
      zoomImage.style.transformOrigin = `${px * 100}% ${py * 100}%`;
      zoomImage.style.transform = 'scale(2.4)';
    }

    const desktopHover = window.matchMedia('(hover: hover)');
    const dialogEl = zoomModal?.querySelector('dialog');

    if (zoomImage) {
      bindOnce(zoomImage, (img) => {
        if (desktopHover.matches) {
          img.addEventListener('pointermove', (e) => {
            if (!zoomed && e.pointerType === 'mouse') {
              zoomed = true;
              zoomToPoint(e.clientX, e.clientY);
            } else if (zoomed && e.pointerType === 'mouse') {
              zoomToPoint(e.clientX, e.clientY);
            }
          });
          img.addEventListener('pointerleave', () => {
            if (zoomed && desktopHover.matches) resetZoom();
          });
        } else {
          img.addEventListener('click', () => {
            if (zoomed) {
              resetZoom();
            } else {
              zoomed = true;
              zoomToPoint(img.clientWidth / 2, img.clientHeight / 2);
            }
          });
        }
        if (dialogEl) dialogEl.addEventListener('close', resetZoom);
      });
    }

    thumbs.forEach((thumb, index) => {
      bindOnce(thumb, (el) => {
        el.addEventListener('click', () => {
          const src = el.getAttribute('data-image-src');
          if (src && mainImageEl) {
            mainImageEl.src = src;
            currentIndex = index;
            updateActiveThumb();
          }
        });

        // Keyboard navigation for thumbnails
        el.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
            e.preventDefault();
            const newIndex = e.key === 'ArrowRight'
              ? (index + 1) % thumbs.length
              : (index - 1 + thumbs.length) % thumbs.length;
            (thumbs[newIndex] as HTMLElement).focus();
            (thumbs[newIndex] as HTMLElement).click();
          }
        });
      });
    });
  });
</script>

<style>
  .image-gallery {
    position: relative;
  }

  .image-gallery-main {
    aspect-ratio: 3 / 4;
    border-radius: var(--border-radius);
    overflow: hidden;
    background-color: #ffffff;
  }

  .image-gallery-main-image {
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    padding: 13%;
    object-fit: contain;
    cursor: zoom-in;
    transition: transform var(--transition-duration) var(--transition-easing);
  }

  .image-gallery-main-image--large {
    padding: 2%;
    transform: scale(1.1);
  }

  .image-gallery-main-image:hover {
    transform: scale(1.02);
  }

  .image-gallery-main-image--large:hover {
    transform: scale(1.122);
  }

  .image-gallery-thumbs {
    display: flex;
    gap: 12px;
    margin-top: 16px;
    overflow-x: auto;
    padding-bottom: 8px;
    -webkit-overflow-scrolling: touch;
  }

  .image-gallery-thumb {
    flex-shrink: 0;
    width: 80px;
    height: 80px;
    border: 2px solid transparent;
    border-radius: var(--border-radius);
    overflow: hidden;
    background: #ffffff;
    cursor: pointer;
    padding: 0;
    transition: all var(--transition-duration) var(--transition-easing);
  }

  .image-gallery-thumb img {
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    padding: 4px;
    object-fit: contain;
  }

  .image-gallery-thumb:hover {
    border-color: var(--color-primary);
  }

  .image-gallery-thumb--active {
    border-color: var(--color-primary);
  }

  .image-gallery-thumb:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Zoom modal */
  .image-zoom-modal {
    --modal-width: 90vw;
    --modal-height: 90vh;
  }

  .image-zoom-content {
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    cursor: zoom-in;
    touch-action: manipulation;
  }

  .image-zoom-image {
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
    will-change: transform;
    user-select: none;
    -webkit-user-select: none;
  }
</style>