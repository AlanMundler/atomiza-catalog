---
import ImageGallery from '@/components/product/ImageGallery.astro';
import SizeSelector from '@/components/product/SizeSelector.astro';
import Button from '@/components/ui/Button.astro';
import Chip from '@/components/ui/Chip.astro';
import Faq from '@/components/ui/Faq.astro';
import { DECANT_ML, isDecantSize, isSizeAvailable, sizeStockMessage } from '@/utils/stock';
import { buildWhatsAppLink, formatPrice } from '@/utils/formatters';
import { TRIDENT_DISCOUNT } from '@/utils/trident';
import { resenas, resenasRating, hasResenas } from '@/data/resenas';
import { site } from '@/site.config';
import type { Perfume, PerfumeSize } from '@/data/types';

interface Props {
  perfume: Perfume;
}

const { perfume } = Astro.props;
// Talla por defecto: 5ml si hay stock, si no la primera con stock. Así el
// radio marcado nunca queda en una talla deshabilitada.
const selectedSize =
  perfume.sizes.find(s => s.ml === DECANT_ML && isSizeAvailable(s)) ||
  perfume.sizes.find(s => isSizeAvailable(s)) ||
  perfume.sizes.find(s => s.ml === DECANT_ML) ||
  perfume.sizes[0];
const available = selectedSize ? isSizeAvailable(selectedSize) : false;
const countdownMessage = selectedSize ? sizeStockMessage(selectedSize) : null;
// Ancla de precio honesta:
// - Si el producto tiene frasco propio (un talle de ml >= 90), el "ancla de
//   mercado" mentía: `originalPrice` ES el precio de nuestro frasco, así que
//   mostramos la comparación real decant ↔ frasco (qué % del frasco ocupa el
//   decant + precio y $/ml de cada uno).
// - Sin frasco propio pero con `originalPrice`, se mantiene el ancla de
//   mercado (ahí sí es un precio externo que da contexto).
// - Sin ninguna de las dos, no se muestra ancla.
const BOTTLE_MIN_ML = 90;
const bottleSize = perfume.sizes.find((s) => s.ml >= BOTTLE_MIN_ML);
const decantSize = perfume.sizes.find((s) => isDecantSize(s));
const pricePerMl = (size: PerfumeSize) => Math.round(size.price / size.ml);
// % del frasco que ocupa el decant (5/100 => 5%) y cuántas veces rinde el
// frasco comparado con el decant (100/5 => 20×). Redondeados a entero.
const bottlePct = bottleSize && decantSize ? Math.round((decantSize.ml / bottleSize.ml) * 100) : null;
const bottleYield = bottleSize && decantSize ? Math.round(bottleSize.ml / decantSize.ml) : null;
const anchorMode: 'bottle' | 'market' | 'none' =
  selectedSize != null && bottleSize != null && decantSize != null
    ? 'bottle'
    : selectedSize != null && bottleSize == null && typeof perfume.originalPrice === 'number'
      ? 'market'
      : 'none';
const showPriceAnchor = anchorMode !== 'none';
// Dos reseñas reales para el punto de decisión: las de texto completo
// (Google trunca la primera con "..."). Nunca inventar testimonios.
const fichaResenas = resenas.filter((r) => !r.text.endsWith('...')).slice(0, 2);
// Sin talles cargados no se puede consultar precio: link genérico en vez
// de crashear el build en `selectedSize.price`.
const waMessage = selectedSize
  ? buildWhatsAppLink(
      site.whatsappNumber,
      `Hola! Quiero consultar por ${perfume.brand} ${perfume.name} (${selectedSize.ml}ml, ${formatPrice(selectedSize.price)}). ¿Me ayudás?`
    )
  : site.whatsappUrl;
// Recuperación sin stock (auditoría v2 N2): el decant de 5 ml es SIEMPRE el
// talle que se avisa, aunque el producto tenga frascos: es lo que se acaba y
// lo que el cliente vuelve a buscar. Solo cuando el producto completo quedó
// sin stock (`!available`) reemplaza el CTA deshabilitado.
const restockWaMessage = buildWhatsAppLink(
  site.whatsappNumber,
  `Hola, avisame cuando vuelva ${perfume.brand} ${perfume.name} (${DECANT_ML} ml).`
);
---

<article
  class="product-detail"
  data-perfume-id={perfume.id}
  data-perfume-label={`${perfume.brand} ${perfume.name}`}
  data-wa-number={site.whatsappNumber}
  data-sizes={JSON.stringify(perfume.sizes.map((s) => ({ ml: s.ml, price: s.price, stock: s.stock })))}
>
  <div class="product-detail-grid">
    <div class="product-detail-gallery">
      <ImageGallery images={perfume.images} alt={`${perfume.brand} ${perfume.name}`} />
    </div>

    <div class="product-detail-info">
      <div class="product-detail-header">
        <span class="product-detail-brand">{perfume.brand}</span>
        <div class="product-detail-title-row">
          <h1 class="product-detail-name">{perfume.name}</h1>
          {/* Sin stock se avisa DESDE el primer píxel (auditoría v2 N2): el
              chip vive junto al nombre, no 1-2 pantallas más abajo. */}
          {!available && (
            <Chip variant="out-of-stock" class="product-detail-stock-chip">
              Sin Stock
            </Chip>
          )}
        </div>
        <p class="product-detail-family">{perfume.olfactoryFamily}</p>
      </div>

      <div class="product-detail-description">
        <p>{perfume.description}</p>
      </div>

      <div class="product-detail-notes">
        <details class="notes-accordion" open>
          <summary class="notes-accordion-summary">
            <span>Notas olfativas</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>
          <div class="notes-accordion-content">
            <div class="notes-row">
              <span class="notes-label">Salida</span>
              <span class="notes-values">{perfume.notes.top.join(', ')}</span>
            </div>
            <div class="notes-row">
              <span class="notes-label">Corazón</span>
              <span class="notes-values">{perfume.notes.heart.join(', ')}</span>
            </div>
            <div class="notes-row">
              <span class="notes-label">Fondo</span>
              <span class="notes-values">{perfume.notes.base.join(', ')}</span>
            </div>
          </div>
        </details>
      </div>

      <div class="product-detail-selector">
        <SizeSelector 
          sizes={perfume.sizes} 
          selectedSize={selectedSize}
        />
      </div>

      {/* Siempre renderizado (oculto si no aplica) para que el script
          lo pueda mostrar al cambiar de talle sin re-render. */}
      <div
        class="stock-countdown"
        data-stock-countdown
        role="status"
        style={countdownMessage ? undefined : 'display:none'}
      >
        <p class="stock-countdown-title" data-stock-countdown-title>
          {countdownMessage ?? ''}
        </p>
      </div>

      <div class="product-detail-actions">
        {available ? (
          <Button 
            variant="primary" 
            size="lg" 
            class="product-detail-add-btn"
            data-add-to-cart
            data-fab-avoid
          >
            Agregar al pedido
          </Button>
        ) : (
          /* Sin stock no hay callejón (auditoría v2 N2): en el lugar del CTA
             deshabilitado, "Avisame cuando reponga" abre WhatsApp con el
             mensaje pre-armado para el decant de 5 ml. */
          <a
            href={restockWaMessage}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--secondary btn--lg btn--wrap product-detail-restock-btn"
            data-fab-avoid
          >
            Avisame cuando reponga
          </a>
        )}
        <a
          href={waMessage}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--secondary btn--lg btn--wrap product-detail-wa-btn"
          data-wa-btn
        >
          Consultar por WhatsApp
        </a>
      </div>

      {/* Ancla honesta: comparación decant ↔ frasco cuando el producto
          tiene frasco propio; ancla de mercado solo si no lo tiene. */}
      {showPriceAnchor && anchorMode === 'bottle' && decantSize && bottleSize && (
        <div class="price-anchor">
          <p class="price-anchor-text">
            <strong>{decantSize.ml} ml = {bottlePct}% del frasco</strong>. Un frasco de {bottleSize.ml} ml rinde <strong>{bottleYield}×</strong> este decant: el decant es la entrada, te lo ponés unos días y el frasco completo lo llevás si te convence.
          </p>
          <p class="price-anchor-compare">
            Decant {decantSize.ml} ml <strong>{formatPrice(decantSize.price)}</strong> · <strong>{formatPrice(pricePerMl(decantSize))}/ml</strong>
            <span class="price-anchor-sep" aria-hidden="true">—</span>
            Frasco {bottleSize.ml} ml <strong>{formatPrice(bottleSize.price)}</strong> · <strong>{formatPrice(pricePerMl(bottleSize))}/ml</strong>
          </p>
        </div>
      )}

      {showPriceAnchor && anchorMode === 'market' && selectedSize && (
        <div class="price-anchor">
          <p class="price-anchor-text">
            Un frasco completo de {perfume.brand} {perfume.name} ronda los <strong>{formatPrice(perfume.originalPrice!)}</strong>. Probalo primero por <strong>{formatPrice(selectedSize.price)}</strong> y decidí después.
          </p>
        </div>
      )}

      <div class="trust-strip" role="list" aria-label="Garantías de la compra">
        <span class="trust-item" role="listitem">{site.trust.origin}</span>
        <span class="trust-item" role="listitem">{site.trust.delivery}</span>
        {hasResenas && (
          <span class="trust-item trust-item--rating" role="listitem">
            <span class="trust-star" aria-hidden="true">★</span>
            {resenasRating.ratingValue.toFixed(1)} en Google · {resenasRating.reviewCount} reseñas
          </span>
        )}
      </div>

      <a href={`${site.basePath}tridentes/`} class="trident-cta">
        <span class="trident-cta-text">3 decants = {formatPrice(TRIDENT_DISCOUNT)} menos, automático</span>
        <span class="trident-cta-link">Ver cómo funciona →</span>
      </a>

      <div class="product-faq">
        <p class="product-faq-title">¿Dudas comunes?</p>
        <Faq
          items={[
            { question: '¿Los decants son originales?', answer: 'Sí: cada decant se extrae de un frasco original sellado.' },
            { question: '¿Cómo me llega el pedido?', answer: 'Entrega en mano o envío en Córdoba: lo coordinamos por WhatsApp cuando hacés el pedido.' },
            { question: '¿Cómo pago?', answer: 'Transferencia o efectivo, también se coordina por mensaje.' },
          ]}
          firstOpen={false}
          ctaHref={`${site.basePath}#preguntas-frecuentes`}
          ctaLabel="Ver todas las preguntas frecuentes"
          ctaVariant="link"
        />
      </div>

      {/* Reseñas reales de Google al pie del bloque de compra: nunca arriba
          de los CTAs para no empujarlos en mobile. */}
      {fichaResenas.length > 0 && (
        <div class="product-reviews">
          <p class="product-reviews-title">Clientes reales en Google</p>
          <div class="product-reviews-grid">
            {fichaResenas.map((r) => (
              <figure class="product-review">
                <div class="product-review-stars" role="img" aria-label={`${r.rating} de 5 estrellas`}>
                  {'★'.repeat(r.rating)}{'☆'.repeat(Math.max(0, 5 - r.rating))}
                </div>
                <blockquote class="product-review-text">“{r.text}”</blockquote>
                <figcaption class="product-review-name">{r.name} · {r.locality}</figcaption>
              </figure>
            ))}
          </div>
          {site.googleReviewsUrl && (
            <a
              href={site.googleReviewsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="product-reviews-link"
            >
              Ver todas en Google
            </a>
          )}
        </div>
      )}
    </div>
  </div>
</article>

{available && selectedSize && (
  <div class="sticky-buy" data-sticky-buy data-fab-avoid role="region" aria-label="Compra rápida">
    <div class="sticky-buy-info">
      <span class="sticky-buy-name">{perfume.brand} {perfume.name}</span>
      <span class="sticky-buy-price" data-sticky-price>{formatPrice(selectedSize.price)} · {selectedSize.ml}ml</span>
    </div>
    <Button variant="primary" size="lg" class="sticky-buy-btn" data-add-to-cart>
      Agregar
    </Button>
  </div>
)}

  <script>
    import { bindOnce, onPageLoad } from '@/utils/view-transitions';
    import { buildWhatsAppLink, formatPrice } from '@/utils/formatters';
    import { DECANT_ML, sizeStockMessage } from '@/utils/stock';
    import { syncSelectedSizeClass } from '@/utils/size-selector';

    onPageLoad('product-detail', () => {
      const addBtns = Array.from(document.querySelectorAll('[data-add-to-cart]'));
      const article = document.querySelector('[data-perfume-id]');
      const sizeInputs = Array.from(document.querySelectorAll('input[name="size"]'));

      if (addBtns.length > 0) {
        addBtns.forEach((btn) => {
          bindOnce(btn as HTMLElement, (el) => {
            el.addEventListener('click', () => {
              const perfumeId = document.querySelector('[data-perfume-id]')?.getAttribute('data-perfume-id');
              const selectedSizeInput = document.querySelector('input[name="size"]:checked');
              const sizeMl = selectedSizeInput ? parseInt((selectedSizeInput as HTMLInputElement).value) : DECANT_ML;

              const event = new CustomEvent('cart:add', {
                detail: { perfumeId, sizeMl, quantity: 1 }
              });
              window.dispatchEvent(event);

              // Open cart drawer
              window.dispatchEvent(new CustomEvent('cart:open'));
            });
          });
        });
      }

      // Al cambiar de talle (decant ↔ frasco) se actualizan el aviso de
      // stock, la barra fija y el link de WhatsApp sin re-render.
      if (article && sizeInputs.length > 0) {
        let sizes: { ml: number; price: number; stock: number }[] = [];
        try {
          sizes = JSON.parse(article.getAttribute('data-sizes') || '[]');
        } catch {
          sizes = [];
        }
        const label = article.getAttribute('data-perfume-label') || '';
        const waNumber = article.getAttribute('data-wa-number') || '';
        const countdown = article.querySelector('[data-stock-countdown]') as HTMLElement | null;
        const countdownTitle = article.querySelector('[data-stock-countdown-title]');
        const stickyPrice = document.querySelector('[data-sticky-price]');
        const waBtn = article.querySelector('[data-wa-btn]');

        sizeInputs.forEach((input) => {
          bindOnce(input as HTMLElement, (el) => {
            el.addEventListener('change', () => {
              // La marca visual vive en el label (el radio está oculto):
              // moverla al talle recién elegido.
              syncSelectedSizeClass(sizeInputs as HTMLInputElement[]);
              const size = sizes.find((s) => s.ml === parseInt((el as HTMLInputElement).value, 10));
              if (!size) return;
              const message = sizeStockMessage(size);
              if (countdown && countdownTitle) {
                countdownTitle.textContent = message ?? '';
                countdown.style.display = message ? '' : 'none';
              }
              if (stickyPrice) {
                stickyPrice.textContent = `${formatPrice(size.price)} · ${size.ml}ml`;
              }
              if (waBtn && waNumber) {
                waBtn.setAttribute(
                  'href',
                  buildWhatsAppLink(
                    waNumber,
                    `Hola! Quiero consultar por ${label} (${size.ml}ml, ${formatPrice(size.price)}). ¿Me ayudás?`
                  )
                );
              }
            });
          });
        });
      }
    });
  </script>

<style is:global>
  /* La barra de compra fija vive solo en la ficha; el FAB de WhatsApp se
     corre arriba y el contenido no queda tapado (solo mobile). */
  @media (max-width: 1023px) {
    body:has([data-sticky-buy]) .whatsapp-fab {
      bottom: 96px;
    }
    body:has([data-sticky-buy]) main {
      padding-bottom: 88px;
    }
  }
</style>

<style>
  .product-detail {
    padding: var(--spacing-stack-lg) 0;
  }

  .product-detail-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-stack-lg);
  }

  @media (min-width: 1024px) {
    /* Padding superior compacto: con la galería agrandada (+20%), los 80px
       originales dejaban la base 36px bajo el pliegue en la vista inicial. */
    .product-detail {
      padding-top: var(--spacing-stack-md);
    }

    .product-detail-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }

    /* La galería acompaña el scroll de la columna de info: elimina el
       hueco vacío que quedaba debajo de la imagen en desktop. */
    .product-detail-gallery {
      position: sticky;
      top: calc(var(--header-height) + 24px);
    }
  }

  .product-detail-info {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-stack-md);
  }

  .product-detail-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* Nombre + chip SIN STOCK en la misma línea visual: si el nombre es largo
     el chip baja y queda pegado a él, nunca suelto a una pantalla de
     distancia (auditoría v2 N2). */
  .product-detail-title-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 12px;
  }

  .product-detail-stock-chip {
    flex-shrink: 0;
  }

  /* El FAB de WhatsApp queda fijo a la derecha y, en estas alturas de
     viewport, el bloque de título entra en su franja al cargar la ficha:
     se le reserva aire para que el nombre nunca pase por debajo. No toca
     el layout de PC (el FAB vive en el margen vacío de la grilla). */
  @media (max-width: 1023px) {
    .product-detail-header {
      padding-right: 80px;
    }
  }

  .product-detail-brand {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
  }

  .product-detail-name {
    font-family: var(--font-family);
    font-size: var(--font-headline-lg-size);
    font-weight: var(--font-headline-lg-weight);
    line-height: var(--font-headline-lg-line-height);
    letter-spacing: var(--font-headline-lg-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
    margin: 0;
  }

  @media (max-width: 640px) {
    .product-detail-name {
      font-size: var(--font-headline-lg-mobile-size);
    }
  }

  .product-detail-family {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    color: var(--color-primary);
    margin: 0;
  }

  .product-detail-description {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    line-height: var(--font-body-md-line-height);
    letter-spacing: var(--font-body-md-tracking);
    color: var(--color-on-surface-variant);
    margin: 0;
  }

  .product-detail-notes {
    border-top: var(--border-width) solid var(--color-outline-variant);
    padding-top: var(--spacing-stack-md);
  }

  .notes-accordion {
    border: var(--border-width) solid var(--color-outline-variant);
    border-radius: var(--border-radius);
    overflow: hidden;
  }

  .notes-accordion[open] {
    border-color: var(--color-primary);
  }

  .notes-accordion-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
    cursor: pointer;
    list-style: none;
  }

  .notes-accordion-summary::-webkit-details-marker {
    display: none;
  }

  .notes-accordion-summary svg {
    flex-shrink: 0;
    color: var(--color-on-surface-variant);
    transition: transform var(--transition-duration) var(--transition-easing);
  }

  .notes-accordion[open] .notes-accordion-summary svg {
    transform: rotate(180deg);
  }

  .notes-accordion-content {
    padding: 0 20px 20px;
    border-top: var(--border-width) solid var(--color-outline-variant);
  }

  .notes-row {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 0;
    border-bottom: var(--border-width) solid var(--color-outline-variant);
  }

  .notes-row:last-child {
    border-bottom: none;
  }

  .notes-label {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
  }

  .notes-values {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    color: var(--color-on-surface);
  }

  .product-detail-selector {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: var(--spacing-stack-md) 0;
    border-top: var(--border-width) solid var(--color-outline-variant);
    border-bottom: var(--border-width) solid var(--color-outline-variant);
  }

  .product-detail-actions {
    display: flex;
    gap: 12px;
    padding-top: var(--spacing-stack-sm);
    align-items: stretch;
  }

  /* En PC "CONSULTAR POR WHATSAPP" no entra en una línea y el
     `btn--wrap` lo deja más alto que el primario (52px fijos).
     Ambos en auto + stretch => misma altura, texto centrado. */
  .product-detail-actions .product-detail-add-btn,
  .product-detail-actions .product-detail-restock-btn,
  .product-detail-actions .product-detail-wa-btn {
    flex: 1 1 0;
    min-width: 0;
    height: auto;
    min-height: 52px;
    text-align: center;
    line-height: 1.25;
  }

  @media (min-width: 641px) {
    .product-detail-actions .btn--lg {
      padding: 12px 16px;
    }
  }

  .price-anchor {
    padding: var(--spacing-stack-sm) var(--spacing-stack-md);
    background-color: var(--color-surface-container-high);
    border: var(--border-width) solid var(--color-outline-variant);
    border-radius: var(--border-radius);
  }

  .price-anchor-text {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    line-height: var(--font-body-md-line-height);
    color: var(--color-on-surface-variant);
    margin: 0;
  }

  .price-anchor-text strong {
    color: var(--color-primary);
    font-weight: 600;
  }

  /* Segunda línea del ancla decant ↔ frasco: los dos precios con su $/ml. */
  .price-anchor-compare {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    line-height: var(--font-body-md-line-height);
    letter-spacing: var(--font-body-md-tracking);
    color: var(--color-on-surface-variant);
    margin: 8px 0 0;
  }

  .price-anchor-compare strong {
    color: var(--color-on-surface);
    font-weight: 600;
  }

  .price-anchor-sep {
    margin: 0 8px;
    color: var(--color-primary);
  }

  /* Trust strip: tres garantías cortas bajo los CTAs. Uppercase label como
     el resto de la ficha; check en dorado, la estrella solo en la línea
     de rating. */
  .trust-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
