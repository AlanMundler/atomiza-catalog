---
import Chip from '@/components/ui/Chip.astro';
import { getStockStatus, getStockLabel } from '@/utils/stock';
import type { PerfumeSize } from '@/data/types';

interface Props {
  size: PerfumeSize;
  class?: string;
}

const { size, class: className = '' } = Astro.props;
const stockStatus = getStockStatus(size);
const stockLabel = getStockLabel(stockStatus);
---

<Chip variant={stockStatus} class={className}>
  {stockLabel}
</Chip>