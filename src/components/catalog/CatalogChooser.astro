---
/**
 * Portada de /catalogo/: dos caminos equivalentes (decants | frascos).
 * Sin props: lee perfumes.json y calcula conteos y precios mínimos
 * con perfumesForMode/sizeForMode (contrato compartido con las páginas
 * /catalogo/decants/ y /catalogo/frascos/).
 */
import type { Perfume } from '@/data/types';
import perfumesData from '@/data/perfumes.json';
import { site } from '@/site.config';
import { perfumesForMode, sizeForMode } from '@/utils/catalogo';
import { formatPrice } from '@/utils/formatters';

type CatalogMode = 'decants' | 'frascos';

const perfumes = perfumesData.perfumes as Perfume[];
const BASE = site.basePath;

/** Precio más bajo del modo, o null si no hay productos. */
function minPriceFor(list: Perfume[], mode: CatalogMode): number | null {
  let min: number | null = null;
  for (const p of list) {
    const size = sizeForMode(p, mode);
    if (size && Number.isFinite(size.price) && (min === null || size.price < min)) {
      min = size.price;
    }
  }
  return min;
}

/** Etiqueta de ml del modo ("5" / "90–100"), salida de los datos. */
function mlLabelFor(list: Perfume[], mode: CatalogMode): string {
  const mls = Array.from(new Set(list.map((p) => sizeForMode(p, mode)?.ml).filter((ml): ml is number => typeof ml === 'number'))).sort(
    (a, b) => a - b
  );
  if (mls.length === 0) return '';
  if (mls.length === 1) return String(mls[0]);
  return `${mls[0]}–${mls[mls.length - 1]}`;
}

function countLabel(n: number): string {
  return `${n} ${n === 1 ? 'fragancia' : 'fragancias'}`;
}

const decants = perfumesForMode(perfumes, 'decants');
const frascos = perfumesForMode(perfumes, 'frascos');
const decantPrice = minPriceFor(decants, 'decants');

interface ModeCard {
  key: CatalogMode;
  title: string;
  text: string;
  cta: string;
  href: string;
  count: string;
  ml: string;
}

const allCards: ModeCard[] = [
  {
    key: 'decants',
    title: 'Decants 5 ml',
    text:
      decantPrice !== null
        ? `Probá la fragancia en tu piel unos días antes de decidir. Desde ${formatPrice(decantPrice)}.`
        : 'Probá la fragancia en tu piel unos días antes de decidir.',
    cta: 'Ver decants',
    href: `${BASE}catalogo/decants/`,
    count: countLabel(decants.length),
    ml: mlLabelFor(decants, 'decants'),
  },
  {
    key: 'frascos',
    title: 'Frascos originales',
    text: 'El frasco sellado, tal cual sale de la casa.',
    cta: 'Ver frascos',
    href: `${BASE}catalogo/frascos/`,
    count: countLabel(frascos.length),
    ml: mlLabelFor(frascos, 'frascos'),
  },
];

// Si un modo queda sin productos, su card no se muestra.
const cards = allCards.filter((card) => (card.key === 'decants' ? decants.length : frascos.length) > 0);
---

<section class="chooser" aria-labelledby="chooser-title">
  <div class="container">
    <header class="chooser-hero">
      <h1 id="chooser-title" class="chooser-title">Catálogo</h1>
      <p class="chooser-subtitle">Elegí cómo querés probarlo: decant de 5 ml para probar sin compromiso, o el frasco original sellado.</p>
    </header>

    <div class="chooser-grid">
      {cards.map((card) => (
        <a class={`mode-card mode-card--${card.key}`} href={card.href}>
          <span class="mode-card-ml" aria-hidden="true">
            {card.ml}
            <em>ml</em>
          </span>
          <span class="mode-card-count">{card.count}</span>
          <span class="mode-card-title">{card.title}</span>
          <span class="mode-card-text">{card.text}</span>
          <span class="mode-card-cta">
            {card.cta}
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M2 8h11M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
            </svg>
          </span>
        </a>
      ))}
    </div>

    <footer class="chooser-foot">
      <p class="chooser-foot-copy">
        Todos los perfumes son árabes originales. Coordinamos entrega en mano en {site.addressLocality} o envío por Uber, y el pedido se cierra
        por WhatsApp.
      </p>
      <ul class="chooser-foot-links" role="list">
        <li><a class="chooser-foot-link" href={`${BASE}decants/`}>Ver decants por aroma famoso</a></li>
        <li><a class="chooser-foot-link" href={`${BASE}notas/`}>Explorar por nota</a></li>
      </ul>
    </footer>
  </div>
</section>

<style>
  .chooser {
    padding: var(--spacing-stack-lg) 0 var(--spacing-stack-lg);
  }

  .chooser-hero {
    text-align: center;
    margin-bottom: var(--spacing-stack-lg);
  }

  .chooser-title {
    font-family: var(--font-family);
    font-size: var(--font-display-lg-size);
    font-weight: var(--font-display-lg-weight);
    line-height: var(--font-display-lg-line-height);
    letter-spacing: var(--font-display-lg-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
    margin: 0 0 12px;
  }

  .chooser-subtitle {
    font-family: var(--font-family);
    font-size: var(--font-body-lg-size);
    font-weight: var(--font-body-lg-weight);
    line-height: var(--font-body-lg-line-height);
    letter-spacing: var(--font-body-lg-tracking);
    color: var(--color-on-surface-variant);
    margin: 0 auto;
    max-width: 34em;
  }

  .chooser-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-stack-sm);
  }

  @media (min-width: 768px) {
    .chooser-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-stack-md);
    }
  }

  /* Dos caminos equivalentes: misma estructura, misma altura,
     distinto acento (oro para decants, platino para frascos). */
  .mode-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: var(--spacing-stack-md) var(--spacing-stack-md) var(--spacing-stack-md);
    background-color: var(--color-surface-container);
    border: var(--border-width) solid var(--color-outline-variant);
    border-radius: var(--border-radius);
    color: var(--color-on-surface);
    text-decoration: none;
    overflow: hidden;
    transition:
      border-color var(--transition-duration) var(--transition-easing),
      background-color var(--transition-duration) var(--transition-easing),
      transform var(--transition-duration) var(--transition-easing);
  }

  .mode-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background-color: var(--mode-accent);
  }

  .mode-card--decants {
    --mode-accent: var(--color-primary);
  }

  .mode-card--frascos {
    /* Platino cálido: acento distinto, peso visual equivalente al oro. */
    --mode-accent: var(--color-on-surface-variant);
  }

  @media (hover: hover) and (pointer: fine) {
    .mode-card:hover {
      border-color: var(--mode-accent);
      background-color: var(--color-surface-container-high);
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    .mode-card:hover .mode-card-ml {
      opacity: 0.5;
    }

    .mode-card:hover .mode-card-cta {
      color: var(--mode-accent);
    }
  }

  .mode-card:focus-visible {
    outline: 2px solid var(--mode-accent);
    outline-offset: 2px;
  }

  /* Marca de agua tipográfica con el ml del modo (sale de los datos).
     En flujo normal (order:2) y alineada a la derecha: es la firma de la
     card, última línea del bloque, debajo del CTA que vive a la izquierda.
     Al no ser overlay, es imposible que tape el copy a cualquier ancho,
     incluso con numerales anchos como "90–100". */
  .mode-card-ml {
    order: 2;
    align-self: flex-end;
    margin-top: 4px;
    font-family: var(--font-family);
    font-size: clamp(40px, 4.5vw, 56px);
    font-weight: 200;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--mode-accent);
    opacity: 0.3;
    pointer-events: none;
    user-select: none;
    transition: opacity var(--transition-duration) var(--transition-easing);
  }

  .mode-card-ml em {
    font-style: normal;
    font-size: 0.28em;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    vertical-align: super;
    margin-left: 2px;
  }

  .mode-card-count {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    line-height: var(--font-label-sm-line-height);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--mode-accent);
  }

  .mode-card-title {
    font-family: var(--font-family);
    font-size: var(--font-headline-md-size);
    font-weight: var(--font-headline-md-weight);
    line-height: var(--font-headline-md-line-height);
    letter-spacing: var(--font-headline-md-tracking);
    color: var(--color-on-surface);
  }

  .mode-card-text {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    font-weight: var(--font-body-md-weight);
    line-height: var(--font-body-md-line-height);
    letter-spacing: var(--font-body-md-tracking);
    color: var(--color-on-surface-variant);
    max-width: 40em;
  }

  .mode-card-cta {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-top: 16px;
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
    transition: color var(--transition-duration) var(--transition-easing);
  }

  @media (max-width: 640px) {
    .chooser {
      padding: var(--spacing-stack-md) 0 var(--spacing-stack-md);
    }

    .chooser-hero {
      margin-bottom: var(--spacing-stack-md);
    }

    .chooser-title {
      font-size: 36px;
    }

    .mode-card {
      padding: var(--spacing-stack-sm) 20px 20px;
      min-height: 44px;
    }
  }

  .chooser-foot {
    margin-top: var(--spacing-stack-lg);
    text-align: center;
  }

  .chooser-foot-copy {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    font-weight: var(--font-body-md-weight);
    line-height: var(--font-body-md-line-height);
    letter-spacing: var(--font-body-md-tracking);
    color: var(--color-on-surface-variant);
    margin: 0 auto var(--spacing-stack-sm);
    max-width: 52em;
  }

  .chooser-foot-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 32px;
    list-style: none;
  }

  .chooser-foot-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 8px 4px;
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-primary);
    text-decoration: none;
    transition: color var(--transition-duration) var(--transition-easing);
  }

  .chooser-foot-link:hover {
    text-decoration: underline;
    color: var(--color-primary-container);
  }

  .chooser-foot-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
</style>
