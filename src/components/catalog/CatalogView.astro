---
import Filters from '@/components/catalog/Filters.astro';
import Search from '@/components/catalog/Search.astro';
import ProductGrid from '@/components/catalog/ProductGrid.astro';
import CatalogModeSwitch from '@/components/catalog/CatalogModeSwitch.astro';
import type { Perfume, GenderFilter } from '@/data/types';

interface Props {
  perfumes: Perfume[];
  mode: 'decants' | 'frascos';
  /** Fuerza un talle concreto en las cards (ml). Omitir para elegirlo por modo. */
  sizeMl?: number;
  title: string;
  subtitle: string;
}

const { perfumes, mode, sizeMl, title, subtitle } = Astro.props;

// Índice de búsqueda: marca/nombre/familia/notas. Se genera por vista para que
// la búsqueda difusa solo devuelva perfumes de este listado.
const searchIndex = perfumes.map((p) => ({
  id: p.id,
  text: `${p.brand} ${p.name} ${p.olfactoryFamily} ${p.notes.top.join(' ')} ${p.notes.heart.join(' ')} ${p.notes.base.join(' ')}`.toLowerCase(),
}));

// Filtro inicial desde la URL para el primer pintado (sin JS o antes de que
// el JS corrija el chip activo, evitaba el flash de "TODOS").
const urlFilter = Astro.url.searchParams.get('filter');
const initialFilter: GenderFilter = urlFilter === 'masculino' || urlFilter === 'femenino' || urlFilter === 'unisex' ? urlFilter : 'all';
---

<script is:inline type="application/json" id="search-index" set:html={JSON.stringify(searchIndex).replace(/</g, '\\u003c')} />
<div class="container">
  <CatalogModeSwitch active={mode} />
</div>
<section class="catalog-hero" aria-labelledby="catalog-title">
  <div class="container">
    <h1 id="catalog-title" class="catalog-title">{title}</h1>
    <p class="catalog-subtitle">{subtitle}</p>
  </div>
</section>

<section class="catalog-toolbar" aria-label="Filtros y búsqueda">
  <div class="container">
    <div class="toolbar-content">
      <div class="toolbar-filters">
        <Filters currentFilter={initialFilter} />
      </div>
      <div class="toolbar-search">
        <Search />
      </div>
    </div>
  </div>
</section>

<section class="catalog-results" data-catalog-page aria-labelledby="catalog-results-title">
  <div class="container">
    <div class="results-header">
      <h2 id="catalog-results-title" class="visually-hidden">Perfumes disponibles</h2>
      <p class="results-count" data-results-count role="status" aria-live="polite">
        {perfumes.length} {perfumes.length === 1 ? 'perfume' : 'perfumes'} encontrado{perfumes.length !== 1 ? 's' : ''}
      </p>
    </div>
    <ProductGrid perfumes={perfumes} sizeMl={sizeMl} sizeMode={mode} />
  </div>
</section>

<script>
  // Client-side filtering without page reload (static output has no query params at build time)
  import { bindOnce, onPageLoad, onWindowOnce } from '@/utils/view-transitions';
  import {
    buildResultsText,
    cardMatches,
    normalizeFilter,
  } from '@/utils/catalogo';
  import {
    applyCardVisibility,
    createFuzzyMatches,
    isPageActive,
    readSearchFromUrl,
    readSearchIndex,
    setEmptyState,
    setResultsCount,
    syncSearchInput,
    writeSearchToUrl,
  } from '@/utils/search-page';
  import type { SearchIndexEntry } from '@/utils/search-page';

  let currentFilter = 'all';
  let currentSearch = '';
  let fuzzyMatches: Set<string> | null = null;

  function readUrlState() {
    const params = new URL(window.location.href).searchParams;
    currentFilter = normalizeFilter(params.get('filter'));
    currentSearch = readSearchFromUrl();
  }

  function applyFilters() {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.product-card'));
    const visible = applyCardVisibility(cards, (card) =>
      cardMatches({
        gender: card.getAttribute('data-gender') || '',
        searchText: card.getAttribute('data-search') || '',
        perfumeId: card.getAttribute('data-perfume-id') || '',
        filter: currentFilter,
        query: currentSearch,
        fuzzyIds: fuzzyMatches,
      })
    );

    setResultsCount(
      document.querySelector('[data-results-count]'),
      buildResultsText(visible, currentFilter, currentSearch)
    );
    setEmptyState(
      document.querySelector('.product-grid'),
      document.querySelector('.product-grid-empty'),
      visible
    );
  }

  // Recalcula el set de fuzzy matches para la búsqueda actual. Se usa al
  // escribir (search:change), al navegar con atrás/adelante (popstate) y al
  // entrar a la página. El índice se relee del DOM cada vez: decants y frascos
  // tienen índices distintos y cachearlo entre navegaciones dejaría un set
  // incompleto (regresión detectada en review).
  function refreshFuzzyMatches() {
    fuzzyMatches = createFuzzyMatches(readSearchIndex('search-index'), currentSearch);
  }

  function applyUrlState() {
    readUrlState();
    syncSearchInput(currentSearch);
    updateActiveChip();
    refreshFuzzyMatches();
    applyFilters();
  }

  function updateActiveChip() {
    const filterButtons = document.querySelectorAll('.filter-chip') as NodeListOf<HTMLButtonElement>;
    filterButtons.forEach((b) => {
      const isActive = b.getAttribute('data-filter') === currentFilter;
      b.classList.toggle('filter-chip--active', isActive);
      b.setAttribute('aria-pressed', String(isActive));
    });
  }

  onWindowOnce('catalogo-search', 'search:change', (e) => {
    // Guarda View Transitions: este listener vive en window toda la sesión y,
    // tras navegar catálogo <-> hub, sigue registrado. Sin este root correría
    // en la página equivocada (índice inexistente, analytics falso) y una
    // tecla dispararía los dos handlers.
    if (!isPageActive('[data-catalog-page]')) return;

    currentSearch = (e as CustomEvent<{ query?: string }>).detail?.query || '';
    writeSearchToUrl(currentSearch);

    // Búsqueda fuzzy (lazy-loaded) sobre el índice inline
    refreshFuzzyMatches();

    applyFilters();
    if (currentSearch) {
      document.dispatchEvent(new CustomEvent('analytics:search', { detail: { query: currentSearch } }));
    }
  });

  // Back/forward del navegador re-aplica el estado de filtros y búsqueda.
  // Se recalculan los fuzzy matches porque el Set corresponde al query
  // anterior y si no el filtrado queda incorrecto.
  onWindowOnce('catalogo-popstate', 'popstate', () => {
    if (!isPageActive('[data-catalog-page]')) return;
    readUrlState();
    syncSearchInput(currentSearch);
    updateActiveChip();
    refreshFuzzyMatches();
    applyFilters();
  });

  onPageLoad('catalogo', () => {
    const filterButtons = document.querySelectorAll('.filter-chip') as NodeListOf<HTMLButtonElement>;
    filterButtons.forEach((button) => {
      bindOnce(button, (el) => {
        el.addEventListener('click', () => {
          const filter = el.getAttribute('data-filter');
          if (!filter) return;
          currentFilter = filter;
          const url = new URL(window.location.href);
          if (filter === 'all') {
            url.searchParams.delete('filter');
          } else {
            url.searchParams.set('filter', filter);
          }
          window.history.pushState({}, '', url);

          updateActiveChip();
          applyFilters();
        });
      });
    });

    applyUrlState();

    // Analytics: view_item_list con los perfumes visibles
    requestAnimationFrame(() => {
      const visibleCards = Array.from(document.querySelectorAll('.product-card')).filter(
        (c) => (c as HTMLElement).style.display !== 'none'
      );
      if (visibleCards.length > 0) {
        document.dispatchEvent(new CustomEvent('analytics:view_item_list', {
          detail: {
            listName: 'catalogo',
            items: visibleCards.slice(0, 10).map((c) => ({
              item_id: c.getAttribute('data-perfume-id') || '',
              item_name: c.getAttribute('data-search') || '',
            })),
          },
        }));
      }
    });
  });
</script>

<style>
  .catalog-hero {
    /* Aire superior chico: el respiro grande vive arriba del switch
       (CatalogModeSwitch.astro), no entre el switch y el H1. */
    padding: 16px 0 var(--spacing-stack-sm);
    text-align: center;
  }

  @media (max-width: 640px) {
    .catalog-hero {
      padding-top: 12px;
    }
  }

  .catalog-title {
    font-family: var(--font-family);
    font-size: var(--font-display-lg-size);
    font-weight: var(--font-display-lg-weight);
    line-height: var(--font-display-lg-line-height);
    letter-spacing: var(--font-display-lg-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
    margin: 0 0 12px;
  }

  @media (max-width: 640px) {
    .catalog-title {
      font-size: 36px;
    }
  }

  .catalog-subtitle {
    font-family: var(--font-family);
    font-size: var(--font-body-lg-size);
    font-weight: var(--font-body-lg-weight);
    line-height: var(--font-body-lg-line-height);
    letter-spacing: var(--font-body-lg-tracking);
    color: var(--color-on-surface-variant);
    margin: 0;
  }

  .catalog-toolbar {
    padding: 12px 0;
    border-top: var(--border-width) solid var(--color-outline-variant);
    border-bottom: var(--border-width) solid var(--color-outline-variant);
    position: sticky;
    top: var(--header-height);
    z-index: 50;
    background-color: var(--color-background);
  }

  @media (max-width: 640px) {
    .catalog-toolbar {
      padding: 8px 0;
    }

    .toolbar-content {
      gap: 8px;
    }
  }

  .toolbar-content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-stack-sm);
    align-items: center;
  }

  @media (min-width: 768px) {
    .toolbar-content {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
      gap: var(--spacing-stack-md);
    }
  }

  .toolbar-filters {
    width: 100%;
    max-width: 100%;
  }

  @media (min-width: 768px) {
    .toolbar-filters {
      grid-column: 2;
      justify-self: center;
    }
  }

  .toolbar-search {
    width: 100%;
    max-width: 400px;
  }

  @media (min-width: 768px) {
    .toolbar-search {
      grid-column: 3;
      justify-self: end;
      max-width: 280px;
    }
  }

  .catalog-results {
    padding: var(--spacing-stack-sm) 0 var(--spacing-stack-lg);
  }

  .results-header {
    margin-bottom: var(--spacing-stack-sm);
  }

  .results-count {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
    margin: 0;
  }
</style>
