---
import Filters from '@/components/catalog/Filters.astro';
import Search from '@/components/catalog/Search.astro';
import ProductGrid from '@/components/catalog/ProductGrid.astro';
import CatalogModeSwitch from '@/components/catalog/CatalogModeSwitch.astro';
import type { Perfume, GenderFilter } from '@/data/types';
import { jsonLd } from '@/utils/jsonld';

interface Props {
  perfumes: Perfume[];
  mode: 'decants' | 'frascos';
  /** Fuerza un talle concreto en las cards (ml). Omitir para elegirlo por modo. */
  sizeMl?: number;
  title: string;
  subtitle: string;
}

const { perfumes, mode, sizeMl, title, subtitle } = Astro.props;

// Índice de búsqueda: marca/nombre/familia/notas. Se genera por vista para que
// la búsqueda difusa solo devuelva perfumes de este listado.
const searchIndex = perfumes.map((p) => ({
  id: p.id,
  text: `${p.brand} ${p.name} ${p.olfactoryFamily} ${p.notes.top.join(' ')} ${p.notes.heart.join(' ')} ${p.notes.base.join(' ')}`.toLowerCase(),
}));

// Filtro inicial desde la URL para el primer pintado (sin JS o antes de que
// el JS corrija el chip activo, evitaba el flash de "TODOS").
const urlFilter = Astro.url.searchParams.get('filter');
const initialFilter: GenderFilter = urlFilter === 'masculino' || urlFilter === 'femenino' || urlFilter === 'unisex' ? urlFilter : 'all';
---

<script is:inline type="application/json" id="search-index" set:html={jsonLd(searchIndex)} />
<div class="container">
  <CatalogModeSwitch active={mode} />
</div>
<section class="catalog-hero" aria-labelledby="catalog-title">
  <div class="container">
    <h1 id="catalog-title" class="page-title catalog-title">{title}</h1>
    <p class="catalog-subtitle">{subtitle}</p>
  </div>
</section>

<section class="catalog-toolbar" aria-label="Filtros y búsqueda">
  <div class="container">
    <div class="toolbar-content">
      <div class="toolbar-filters">
        <Filters currentFilter={initialFilter} />
      </div>
      <div class="toolbar-search">
        <Search />
      </div>
    </div>
  </div>
</section>

<section class="catalog-results" data-catalog-page aria-labelledby="catalog-results-title">
  <div class="container">
    <div class="results-header">
      <h2 id="catalog-results-title" class="visually-hidden">Perfumes disponibles</h2>
      <p class="results-count" data-results-count role="status" aria-live="polite">
        {perfumes.length} {perfumes.length === 1 ? 'perfume' : 'perfumes'} encontrado{perfumes.length !== 1 ? 's' : ''}
      </p>
    </div>
    <ProductGrid perfumes={perfumes} sizeMl={sizeMl} sizeMode={mode} />
  </div>
</section>

<script>
  // Filtrado client-side sin recargar: el build estático no conoce la query.
  import { bindOnce } from '@/utils/view-transitions';
  import { createListController } from '@/utils/list-controller';
  import { buildResultsText, cardMatches, normalizeFilter } from '@/utils/catalogo';
  import { readSearchIndex, syncSearchInput, writeSearchToUrl } from '@/utils/search-page';

  interface CatalogState {
    search: string;
    filter: string;
  }

  // analytics de lista: una sola vez por entrada, después del primer pintado.
  let listAnnounced = false;

  const controller = createListController<CatalogState>({
    id: 'catalogo',
    rootSelector: '[data-catalog-page]',
    cardSelector: '.product-card',
    countSelector: '[data-results-count]',
    gridSelector: '.product-grid',
    emptySelector: '.product-grid-empty',
    readState: (url) => ({
      filter: normalizeFilter(url.searchParams.get('filter')),
      search: url.searchParams.get('search') || '',
    }),
    writeUrl: (state) => {
      writeSearchToUrl(state.search, {
        filter: state.filter === 'all' ? null : state.filter,
      });
    },
    index: () => readSearchIndex('search-index'),
    isVisible: (card, state, fuzzyIds) =>
      cardMatches({
        gender: card.getAttribute('data-gender') || '',
        searchText: card.getAttribute('data-search') || '',
        perfumeId: card.getAttribute('data-perfume-id') || '',
        filter: state.filter,
        query: state.search,
        fuzzyIds,
      }),
    countText: (visible, state) => buildResultsText(visible, state.filter, state.search),
    syncControls: (state) => {
      syncSearchInput(state.search);
      document.querySelectorAll<HTMLButtonElement>('.filter-chip').forEach((button) => {
        const active = button.getAttribute('data-filter') === state.filter;
        button.classList.toggle('filter-chip--active', active);
        button.setAttribute('aria-pressed', String(active));
      });
    },
    bindControls(ctl) {
      document.querySelectorAll<HTMLButtonElement>('.filter-chip').forEach((button) => {
        bindOnce(button, (el) => {
          el.addEventListener('click', () => {
            const filter = el.getAttribute('data-filter');
            if (filter) ctl.update({ filter });
          });
        });
      });
    },
    onSearch: (state) => {
      // Solo al escribir: un chip no debe emitir analytics de búsqueda.
      if (state.search) {
        document.dispatchEvent(
          new CustomEvent('analytics:search', { detail: { query: state.search } })
        );
      }
    },
    onEnter: () => {
      // onPageLoad corre en cada vista aunque el módulo no se re-ejecute: el
      // reset acá garantiza un view_item_list por entrada, no uno por sesión.
      listAnnounced = false;
    },
    afterApply() {
      if (listAnnounced) return;
      listAnnounced = true;
      // rAF: espera a que el primer filtrado asiente el DOM antes de medir.
      requestAnimationFrame(() => {
        const visibleCards = Array.from(document.querySelectorAll<HTMLElement>('.product-card')).filter(
          (card) => card.style.display !== 'none'
        );
        if (visibleCards.length === 0) return;
        document.dispatchEvent(
          new CustomEvent('analytics:view_item_list', {
            detail: {
              listName: 'catalogo',
              items: visibleCards.slice(0, 10).map((card) => ({
                item_id: card.getAttribute('data-perfume-id') || '',
                item_name: card.getAttribute('data-search') || '',
              })),
            },
          })
        );
      });
    },
  });

  controller.init();
</script>

<style>
  .catalog-hero {
    /* Aire superior chico: el respiro grande vive arriba del switch
       (CatalogModeSwitch.astro), no entre el switch y el H1. */
    padding: 16px 0 var(--spacing-stack-sm);
    text-align: center;
  }

  @media (max-width: 640px) {
    .catalog-hero {
      padding-top: 12px;
    }
  }

  /* Tipografía y escala mobile: clase global `.page-title` (global.css). */
  .catalog-title {
    margin: 0 0 12px;
  }

  .catalog-subtitle {
    font-family: var(--font-family);
    font-size: var(--font-body-lg-size);
    font-weight: var(--font-body-lg-weight);
    line-height: var(--font-body-lg-line-height);
    letter-spacing: var(--font-body-lg-tracking);
    color: var(--color-on-surface-variant);
    margin: 0;
  }

  .catalog-toolbar {
    padding: 12px 0;
    border-top: var(--border-width) solid var(--color-outline-variant);
    border-bottom: var(--border-width) solid var(--color-outline-variant);
    position: sticky;
    top: var(--header-height);
    z-index: 50;
    background-color: var(--color-background);
  }

  @media (max-width: 640px) {
    .catalog-toolbar {
      padding: 8px 0;
    }

    .toolbar-content {
      gap: 8px;
    }
  }

  .toolbar-content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-stack-sm);
    align-items: center;
  }

  @media (min-width: 768px) {
    .toolbar-content {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
      gap: var(--spacing-stack-md);
    }
  }

  .toolbar-filters {
    width: 100%;
    max-width: 100%;
  }

  @media (min-width: 768px) {
    .toolbar-filters {
      grid-column: 2;
      justify-self: center;
    }
  }

  .toolbar-search {
    width: 100%;
    max-width: 400px;
  }

  @media (min-width: 768px) {
    .toolbar-search {
      grid-column: 3;
      justify-self: end;
      max-width: 280px;
    }
  }

  .catalog-results {
    padding: var(--spacing-stack-sm) 0 var(--spacing-stack-lg);
  }

  .results-header {
    margin-bottom: var(--spacing-stack-sm);
  }

  .results-count {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
    margin: 0;
  }
</style>
