---
import type { GenderFilter } from '@/data/types';

interface Props {
  currentFilter?: GenderFilter;
}

const { currentFilter = 'all' } = Astro.props;

const filters: { value: GenderFilter; label: string }[] = [
  { value: 'all', label: 'TODOS' },
  { value: 'masculino', label: 'MASCULINO' },
  { value: 'femenino', label: 'FEMENINO' },
  { value: 'unisex', label: 'UNISEX' },
];
---

<div class="flex flex-wrap gap-2 justify-center" role="group" aria-label="Filtrar por categoría">
  {filters.map((filter) => (
    <button
      type="button"
      class={`btn btn-sm ${currentFilter === filter.value ? 'btn-primary' : 'btn-ghost border border-base-300 text-base-content/60 hover:text-primary hover:border-primary hover:bg-primary/10'}`}
      data-filter={filter.value}
      aria-pressed={currentFilter === filter.value}
    >
      {filter.label}
    </button>
  ))}
</div>
