---
import Chip from '@/components/ui/Chip.astro';
import type { GenderFilter } from '@/data/types';

interface Props {
  currentFilter: GenderFilter;
}

const { currentFilter } = Astro.props;

const filters: { value: GenderFilter; label: string }[] = [
  { value: 'all', label: 'TODOS' },
  { value: 'masculino', label: 'MASCULINO' },
  { value: 'femenino', label: 'FEMENINO' },
  { value: 'unisex', label: 'UNISEX' },
  { value: 'boutique', label: 'BOUTIQUE' },
];
---

<div class="filters" role="group" aria-label="Filtrar por categoría">
  {filters.map((filter) => (
    <button
      class={`filter-chip ${currentFilter === filter.value ? 'filter-chip--active' : ''}`}
      data-filter={filter.value}
      aria-pressed={currentFilter === filter.value}
    >
      <Chip variant="gender" class="filter-chip-inner">
        {filter.label}
      </Chip>
    </button>
  ))}
</div>
<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
  }

  .filter-chip {
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    line-height: 1;
  }

  .filter-chip-inner {
    transition: all var(--transition-duration) var(--transition-easing);
  }

  .filter-chip:hover .filter-chip-inner {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .filter-chip--active .filter-chip-inner {
    color: var(--color-primary);
    border-color: var(--color-primary);
    background-color: rgba(197, 160, 89, 0.1);
  }

  .filter-chip:focus-visible .filter-chip-inner {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
</style>