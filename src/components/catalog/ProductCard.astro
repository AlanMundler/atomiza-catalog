---
import Chip from '@/components/ui/Chip.astro';
import { getStockStatus, getStockLabel, primarySize } from '@/utils/stock';
import { sizeForMode } from '@/utils/catalogo';
import { formatPrice } from '@/utils/formatters';
import { site, assetUrl } from '@/site.config';
import type { Perfume } from '@/data/types';

interface Props {
  perfume: Perfume;
  /** true en las cards above-the-fold (home): eager + prioridad alta (LCP). */
  eager?: boolean;
  /** Fuerza un talle concreto (ml). Si no existe, se usa el talle principal. */
  sizeMl?: number;
  /**
   * Elige el talle por modo, por producto (los frascos pueden ser 90 o 100 ml).
   * Se ignora cuando `sizeMl` matchea una talla existente.
   */
  sizeMode?: 'decants' | 'frascos';
}

const { perfume, eager = false, sizeMl, sizeMode } = Astro.props;
const mainImage = assetUrl(perfume.images[0]?.src);
const mainAlt = perfume.images[0]?.alt || `${perfume.brand} ${perfume.name}`;

// Talle de la card: el forzado (si existe), el del modo, o el principal (5ml).
// Si el perfume no tiene tallas, se muestra como sin stock en vez de romper
// el build.
const forcedSize = sizeMl != null ? perfume.sizes.find((s) => s.ml === sizeMl) : undefined;
const selectedSize =
  forcedSize ?? (sizeMode ? sizeForMode(perfume, sizeMode) : undefined) ?? primarySize(perfume);
const stockStatus = selectedSize ? getStockStatus(selectedSize) : 'out-of-stock';
const stockLabel = getStockLabel(stockStatus);
const isOutOfStock = stockStatus === 'out-of-stock';
---

<!-- article y no link: el botón quick-add es un interactivo separado
  (un <button> dentro de un <a> es HTML inválido y rompe teclado/lectores).
  El link interno usa stretched-link y cubre toda la card igual que antes. -->
{/* role=listitem: el padre ProductGrid expone role=list. */}
<div
  class="product-card"
  role="listitem"
  data-perfume-id={perfume.id}
  data-gender={perfume.gender}
  data-search={`${perfume.brand} ${perfume.name} ${perfume.olfactoryFamily}`.toLowerCase()}
>
  <a
    href={`${site.basePath}producto/${perfume.slug}/`}
    class="product-card-link"
  >
    <div class="product-card-image-wrapper">
      <img
        src={mainImage}
        alt={mainAlt}
        class="product-card-image"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        decoding="async"
        width="400"
        height="400"
      />
      {isOutOfStock && <div class="product-card-overlay" aria-hidden="true"></div>}
      <Chip
        variant={stockStatus}
        class="product-card-stock"
      >
        {stockLabel}
      </Chip>
    </div>
    <div class="product-card-info">
      <span class="product-card-brand">{perfume.brand}</span>
      <h3 class="product-card-name" title={perfume.name}>{perfume.name}</h3>
      <span class="product-card-price">{selectedSize ? formatPrice(selectedSize.price) : '—'}</span>
    </div>
  </a>
  {selectedSize && !isOutOfStock && (
    <button
      type="button"
      class="product-card-quick"
      data-quick-add
      data-size-ml={selectedSize.ml}
      aria-label={`Agregar ${perfume.brand} ${perfume.name} al pedido`}
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
    </button>
  )}
</div>

<!-- Estilos: src/styles/global.css, bloque "Card de producto". Viven ahí y no
  acá porque la card se usa en ~185 páginas y así viajan en un solo asset
  cacheado en vez de repetirse inlineadas. -->
