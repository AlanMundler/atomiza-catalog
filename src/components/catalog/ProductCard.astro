---
import Chip from '@/components/ui/Chip.astro';
import { getStockStatus, getStockLabel } from '@/utils/stock';
import { formatPrice } from '@/utils/formatters';
import { site, assetUrl } from '@/site.config';
import type { Perfume } from '@/data/types';

interface Props {
  perfume: Perfume;
  /** true en las cards above-the-fold (home): eager + prioridad alta (LCP). */
  eager?: boolean;
}

const { perfume, eager = false } = Astro.props;
const mainImage = assetUrl(perfume.images[0]?.src);
const mainAlt = perfume.images[0]?.alt || `${perfume.brand} ${perfume.name}`;

// Get primary size (5ml) for price display. Si el perfume no tiene tallas,
// se muestra como sin stock en vez de romper el build.
const primarySize = perfume.sizes.find(s => s.ml === 5) || perfume.sizes[0];
const stockStatus = primarySize ? getStockStatus(primarySize) : 'out-of-stock';
const stockLabel = getStockLabel(stockStatus);
const isOutOfStock = stockStatus === 'out-of-stock';
// Las imágenes vectoriales (SVG) se muestran a mayor tamaño que las fotos
const isVector = (perfume.images[0]?.src || '').toLowerCase().endsWith('.svg');
---

<a
  href={`${site.basePath}producto/${perfume.slug}/`}
  class="product-card"
  aria-label={`Ver ${perfume.brand} ${perfume.name}`}
  data-perfume-id={perfume.id}
  data-gender={perfume.gender}
  data-search={`${perfume.brand} ${perfume.name} ${perfume.olfactoryFamily}`.toLowerCase()}
>
  <div class="product-card-image-wrapper">
    <img
      src={mainImage}
      alt={mainAlt}
      class={`product-card-image${isVector ? ' product-card-image--large' : ''}`}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      width="400"
      height="400"
    />
    {primarySize && !isOutOfStock && (
      <button
        type="button"
        class="product-card-quick"
        data-quick-add
        data-size-ml={primarySize.ml}
        aria-label={`Agregar ${perfume.brand} ${perfume.name} al pedido`}
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </button>
    )}
    {isOutOfStock && <div class="product-card-overlay" aria-hidden="true"></div>}
    <Chip
      variant={stockStatus}
      class="product-card-stock"
    >
      {stockLabel}
    </Chip>
  </div>
  <div class="product-card-info">
    <span class="product-card-brand">{perfume.brand}</span>
    <h3 class="product-card-name" title={perfume.name}>{perfume.name}</h3>
    <span class="product-card-price">{primarySize ? formatPrice(primarySize.price) : '—'}</span>
  </div>
</a>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
    background-color: var(--color-surface-container);
    border: var(--border-width) solid var(--color-on-surface);
    border-radius: var(--border-radius);
    overflow: hidden;
    transition: all var(--transition-duration) var(--transition-easing);
  }

  .product-card:hover {
    border-color: var(--color-primary);
    box-shadow: 0 0 20px rgba(233, 193, 118, 0.15);
    transform: translateY(-4px);
  }

  .product-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .product-card-image-wrapper {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-card-image {
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    padding: 13%;
    object-fit: contain;
    transition: transform 400ms var(--transition-easing);
  }

  .product-card-image--large {
    padding: 2%;
    transform: scale(1.1);
  }

  .product-card:hover .product-card-image {
    transform: scale(1.04);
  }

  .product-card:hover .product-card-image--large {
    transform: scale(1.144);
  }

  .product-card-overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(18, 20, 20, 0.6);
    pointer-events: none;
  }

  .product-card-stock {
    position: absolute;
    bottom: 12px;
    left: 12px;
    z-index: 1;
  }

  /* Quick-add: sumar al pedido sin entrar a la ficha. Siempre visible
     (en touch no hay hover) y de 44px para el pulgar. */
  .product-card-quick {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 2;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-on-primary);
    background-color: var(--color-primary);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
    transition: transform var(--transition-duration) var(--transition-easing);
  }

  .product-card-quick:hover {
    transform: scale(1.08);
  }

  .product-card-quick:focus-visible {
    outline: 2px solid var(--color-on-surface);
    outline-offset: 2px;
  }

  .product-card-info {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
  }

  .product-card-brand {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
  }

  .product-card-name {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    font-weight: var(--font-body-md-weight);
    color: var(--color-on-surface);
    line-height: 1.3;
    margin: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  .product-card-price {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-primary);
    margin-top: auto;
  }
</style>