---
import Chip from '@/components/ui/Chip.astro';
import { getStockStatus, getStockLabel, primarySize } from '@/utils/stock';
import { formatPrice } from '@/utils/formatters';
import { site, assetUrl } from '@/site.config';
import type { Perfume } from '@/data/types';

interface Props {
  perfume: Perfume;
  /** true en las cards above-the-fold (home): eager + prioridad alta (LCP). */
  eager?: boolean;
}

const { perfume, eager = false } = Astro.props;
const mainImage = assetUrl(perfume.images[0]?.src);
const mainAlt = perfume.images[0]?.alt || `${perfume.brand} ${perfume.name}`;

// Get primary size (5ml) for price display. Si el perfume no tiene tallas,
// se muestra como sin stock en vez de romper el build.
const primary = primarySize(perfume);
const stockStatus = primary ? getStockStatus(primary) : 'out-of-stock';
const stockLabel = getStockLabel(stockStatus);
const isOutOfStock = stockStatus === 'out-of-stock';
---

<!-- article y no link: el botón quick-add es un interactivo separado
  (un <button> dentro de un <a> es HTML inválido y rompe teclado/lectores).
  El link interno usa stretched-link y cubre toda la card igual que antes. -->
{/* role=listitem: el padre ProductGrid expone role=list. */}
<div
  class="product-card"
  role="listitem"
  data-perfume-id={perfume.id}
  data-gender={perfume.gender}
  data-search={`${perfume.brand} ${perfume.name} ${perfume.olfactoryFamily}`.toLowerCase()}
>
  <a
    href={`${site.basePath}producto/${perfume.slug}/`}
    class="product-card-link"
    aria-label={`Ver ${perfume.brand} ${perfume.name}`}
  >
    <div class="product-card-image-wrapper">
      <img
        src={mainImage}
        alt={mainAlt}
        class="product-card-image"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        width="400"
        height="400"
      />
      {isOutOfStock && <div class="product-card-overlay" aria-hidden="true"></div>}
      <Chip
        variant={stockStatus}
        class="product-card-stock"
      >
        {stockLabel}
      </Chip>
    </div>
    <div class="product-card-info">
      <span class="product-card-brand">{perfume.brand}</span>
      <h3 class="product-card-name" title={perfume.name}>{perfume.name}</h3>
      <span class="product-card-price">{primary ? formatPrice(primary.price) : '—'}</span>
    </div>
  </a>
  {primary && !isOutOfStock && (
    <button
      type="button"
      class="product-card-quick"
      data-quick-add
      data-size-ml={primary.ml}
      aria-label={`Agregar ${perfume.brand} ${perfume.name} al pedido`}
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
    </button>
  )}
</div>

<!-- is:global: la home inyecta estas mismas cards por JS (sorteo
  client-side en home-random.ts) y el CSS scopeado de Astro no aplicaría
  a los nodos creados dinámicamente. Las clases son propias del componente. -->
<style is:global>
  .product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    background-color: var(--color-surface-container);
    border: var(--border-width) solid var(--color-on-surface);
    border-radius: var(--border-radius);
    overflow: hidden;
    transition: all var(--transition-duration) var(--transition-easing);
  }

  .product-card:hover {
    border-color: var(--color-primary);
    box-shadow: 0 0 20px color-mix(in srgb, var(--color-primary) 15%, transparent);
    transform: translateY(-4px);
  }

  /* Link estirado sobre toda la card (stretched-link): el click en
     cualquier parte navega, menos en el botón quick-add que está por
     encima (z-index) y frena la navegación en quick-add.ts. */
  .product-card-link {
    display: flex;
    flex-direction: column;
    flex: 1;
    color: inherit;
    text-decoration: none;
  }

  .product-card-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .product-card-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .product-card-image-wrapper {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-color: var(--color-image-bg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-card-image {
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    padding: 13%;
    object-fit: contain;
    transition: transform 400ms var(--transition-easing);
  }

  .product-card:hover .product-card-image {
    transform: scale(1.04);
  }

  .product-card-overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(18, 20, 20, 0.75);
    pointer-events: none;
  }

  .product-card-stock {
    position: absolute;
    bottom: 12px;
    left: 12px;
    z-index: 1;
  }

  /* Quick-add: sumar al pedido sin entrar a la ficha. Siempre visible
     (en touch no hay hover) y de 44px para el pulgar. */
  .product-card-quick {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 2;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-on-primary);
    background-color: var(--color-primary);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
    transition: transform var(--transition-duration) var(--transition-easing);
  }

  .product-card-quick:hover {
    transform: scale(1.08);
  }

  .product-card-quick:active {
    transform: scale(0.95);
  }

  .product-card-quick:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .product-card-quick:focus-visible {
    outline: 2px solid var(--color-on-surface);
    outline-offset: 2px;
  }

  .product-card-info {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
  }

  .product-card-brand {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
  }

  .product-card-name {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    font-weight: var(--font-body-md-weight);
    color: var(--color-on-surface);
    line-height: 1.3;
    margin: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  .product-card-price {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-primary);
    margin-top: auto;
  }
</style>