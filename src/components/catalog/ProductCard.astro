---
import { getStockStatus, getStockLabel } from '@/utils/stock';
import { formatPrice } from '@/utils/formatters';
import { site, assetUrl } from '@/site.config';
import type { Perfume } from '@/data/types';

interface Props {
  perfume: Perfume;
}

const { perfume } = Astro.props;
const mainImage = assetUrl(perfume.images[0]?.src);
const mainAlt = perfume.images[0]?.alt || `${perfume.brand} ${perfume.name}`;

const primarySize = perfume.sizes.find(s => s.ml === 5) || perfume.sizes[0];
const stockStatus = getStockStatus(primarySize);
const stockLabel = getStockLabel(stockStatus);
const isOutOfStock = stockStatus === 'out-of-stock';
const isVector = (perfume.images[0]?.src || '').toLowerCase().endsWith('.svg');

const badgeVariant = {
  'in-stock': 'badge-success',
  'low-stock': 'badge-warning',
  'out-of-stock': 'badge-error',
  'default': 'badge-ghost'
};
---

<a
  href={`${site.basePath}producto/${perfume.slug}/`}
  class="card bg-base-200 border border-base-300 hover:border-primary hover:shadow-[0_0_20px_rgba(233,193,118,0.15)] transition-all duration-200 hover:-translate-y-1 group"
  aria-label={`Ver ${perfume.brand} ${perfume.name}`}
  data-gender={perfume.gender}
  data-search={`${perfume.brand} ${perfume.name}`.toLowerCase()}
>
  <figure class="relative aspect-[3/4] overflow-hidden bg-white">
    <img 
      src={mainImage} 
      alt={mainAlt} 
      class={`w-full h-full object-contain transition-transform duration-400 ease-out group-hover:scale-105${isVector ? ' p-[2%] scale-110 group-hover:scale-[1.155]' : ' p-[13%]'}`}
      loading="lazy"
      width="400"
      height="400"
    />
    {isOutOfStock && <div class="absolute inset-0 bg-black/60 pointer-events-none"></div>}
    <div class="absolute bottom-3 left-3 z-10">
      <span class={`badge badge-sm ${badgeVariant[stockStatus]} border-0`}>
        {stockLabel}
      </span>
    </div>
  </figure>
  <div class="card-body p-4 gap-1">
    <span class="text-xs font-medium tracking-[0.1em] uppercase text-base-content/60">{perfume.brand}</span>
    <h3 class="text-sm font-normal text-base-content truncate m-0" title={perfume.name}>{perfume.name}</h3>
    <span class="text-xs font-medium tracking-[0.1em] uppercase text-primary mt-1">
      {primarySize ? formatPrice(primarySize.price) : '—'}
    </span>
  </div>
</a>
