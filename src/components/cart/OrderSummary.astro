---
import Button from '@/components/ui/Button.astro';
import { formatPrice } from '@/utils/formatters';

interface Props {
  subtotal: number;
}

const { subtotal } = Astro.props;
const total = subtotal; // No shipping/tax for now
---

<div class="order-summary" role="region" aria-label="Resumen del pedido">
  <div class="order-summary-line">
    <span class="order-summary-label">Subtotal</span>
    <span class="order-summary-value">{formatPrice(subtotal)}</span>
  </div>
  <div class="order-summary-line order-summary-line--total">
    <span class="order-summary-label">Total estimado</span>
    <span class="order-summary-value">{formatPrice(total)}</span>
  </div>
  <p class="order-summary-note">El total final se confirma al coordinar el envío</p>
  <Button 
    variant="primary" 
    size="lg" 
    class="order-summary-btn"
    data-finalize-order
  >
    Finalizar pedido
  </Button>
</div>

<script>
  const finalizeBtn = document.querySelector('[data-finalize-order]');
  
  finalizeBtn?.addEventListener('click', () => {
    const event = new CustomEvent('order:finalize');
    window.dispatchEvent(event);
  });
</script>

<style>
  .order-summary {
    padding-top: 16px;
    border-top: var(--border-width) solid var(--color-outline-variant);
    margin-top: 8px;
  }

  .order-summary-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0;
  }

  .order-summary-line--total {
    padding-top: 16px;
    margin-top: 8px;
    border-top: var(--border-width) solid var(--color-outline-variant);
  }

  .order-summary-label {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    color: var(--color-on-surface-variant);
  }

  .order-summary-value {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    font-weight: var(--font-body-md-weight);
    color: var(--color-on-surface);
  }

  .order-summary-line--total .order-summary-label {
    font-size: var(--font-headline-md-size);
    font-weight: var(--font-headline-md-weight);
    letter-spacing: var(--font-headline-md-tracking);
    text-transform: uppercase;
  }

  .order-summary-line--total .order-summary-value {
    font-size: var(--font-headline-md-size);
    font-weight: var(--font-headline-md-weight);
    color: var(--color-primary);
  }

  .order-summary-note {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    color: var(--color-on-surface-variant);
    margin: 12px 0 20px;
    text-align: center;
  }

  .order-summary-btn {
    width: 100%;
  }
</style>