---
import { formatPrice } from '@/utils/formatters';
import type { CartItem } from '@/data/types';

interface Props {
  item: CartItem;
}

const { item } = Astro.props;
const perfume = item.perfumeId; // We'd need to fetch perfume data, for now use ID
const lineTotal = item.size.price * item.quantity;
---

<li class="cart-item" data-perfume-id={item.perfumeId} data-size-ml={item.size.ml}>
  <div class="cart-item-image">
    <img src={`/images/perfumes/${item.perfumeId}-1.jpg`} alt={perfume} loading="lazy" width="60" height="60" />
  </div>
  <div class="cart-item-details">
    <div class="cart-item-brand">{perfume}</div>
    <div class="cart-item-name">{perfume}</div>
    <div class="cart-item-meta">
      <span class="cart-item-size">{item.size.ml}ml</span>
      <span class="cart-item-price">{formatPrice(item.size.price)}</span>
    </div>
    <div class="cart-item-quantity">
      <button 
        class="quantity-btn quantity-btn--decrease" 
        data-action="decrease"
        aria-label="Disminuir cantidad"
        {item.quantity <= 1 && 'disabled'}
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </button>
      <span class="quantity-value" aria-live="polite">{item.quantity}</span>
      <button 
        class="quantity-btn quantity-btn--increase" 
        data-action="increase"
        aria-label="Aumentar cantidad"
        {item.quantity >= item.size.stock && 'disabled'}
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </button>
    </div>
  </div>
  <div class="cart-item-total">
    <span class="cart-item-line-total">{formatPrice(lineTotal)}</span>
    <button 
      class="cart-item-remove" 
      data-action="remove"
      aria-label="Eliminar del carrito"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
</li>

<script>
  const itemElements = document.querySelectorAll('.cart-item');
  
  itemElements.forEach((element) => {
    const perfumeId = element.getAttribute('data-perfume-id');
    const sizeMl = element.getAttribute('data-size-ml');
    
    if (!perfumeId || !sizeMl) return;
    
    const decreaseBtn = element.querySelector('[data-action="decrease"]');
    const increaseBtn = element.querySelector('[data-action="increase"]');
    const removeBtn = element.querySelector('[data-action="remove"]');
    const quantityValue = element.querySelector('.quantity-value');
    
    decreaseBtn?.addEventListener('click', () => {
      const currentQty = parseInt(quantityValue?.textContent || '1');
      if (currentQty > 1) {
        updateQuantity(perfumeId, sizeMl, currentQty - 1);
      }
    });
    
    increaseBtn?.addEventListener('click', () => {
      const currentQty = parseInt(quantityValue?.textContent || '1');
      const maxStock = parseInt(increaseBtn?.getAttribute('data-max-stock') || '10');
      if (currentQty < maxStock) {
        updateQuantity(perfumeId, sizeMl, currentQty + 1);
      }
    });
    
    removeBtn?.addEventListener('click', () => {
      if (confirm('¿Eliminar este artículo del carrito?')) {
        removeItem(perfumeId, sizeMl);
      }
    });
  });
  
  function updateQuantity(perfumeId: string, sizeMl: string, quantity: number) {
    // This would call the cart utility
    const event = new CustomEvent('cart:update-quantity', {
      detail: { perfumeId, sizeMl: parseInt(sizeMl), quantity }
    });
    window.dispatchEvent(event);
  }
  
  function removeItem(perfumeId: string, sizeMl: string) {
    const event = new CustomEvent('cart:remove', {
      detail: { perfumeId, sizeMl: parseInt(sizeMl) }
    });
    window.dispatchEvent(event);
  }
</script>

<style>
  .cart-item {
    display: grid;
    grid-template-columns: 60px 1fr auto;
    gap: 16px;
    padding: 12px 0;
    border-bottom: var(--border-width) solid var(--color-outline-variant);
    align-items: center;
  }

  .cart-item-image {
    width: 60px;
    height: 60px;
    border-radius: var(--border-radius);
    overflow: hidden;
    flex-shrink: 0;
  }

  .cart-item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-item-details {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .cart-item-brand {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
  }

  .cart-item-name {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    font-weight: var(--font-body-md-weight);
    color: var(--color-on-surface);
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cart-item-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 4px;
  }

  .cart-item-size {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .cart-item-price {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    color: var(--color-on-surface-variant);
  }

  .cart-item-quantity {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
  }

  .quantity-btn {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-on-surface);
    background: var(--color-surface-container-high);
    border: var(--border-width) solid var(--color-outline-variant);
    border-radius: var(--border-radius);
    cursor: pointer;
    transition: all var(--transition-duration) var(--transition-easing);
  }

  .quantity-btn:hover:not(:disabled) {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .quantity-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .quantity-btn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .quantity-value {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    font-weight: var(--font-body-md-weight);
    color: var(--color-on-surface);
    min-width: 24px;
    text-align: center;
  }

  .cart-item-total {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
  }

  .cart-item-line-total {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    font-weight: var(--font-body-md-weight);
    color: var(--color-on-surface);
  }

  .cart-item-remove {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-on-surface-variant);
    background: transparent;
    border: none;
    border-radius: var(--border-radius);
    cursor: pointer;
    transition: all var(--transition-duration) var(--transition-easing);
  }

  .cart-item-remove:hover {
    color: var(--color-error);
    background-color: var(--color-error-container);
  }

  .cart-item-remove:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  @media (max-width: 480px) {
    .cart-item {
      grid-template-columns: 50px 1fr;
      grid-template-rows: auto auto;
    }

    .cart-item-total {
      grid-column: 2;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      width: 100%;
    }

    .cart-item-quantity {
      grid-column: 1 / -1;
    }
  }
</style>