---
import Modal from '@/components/ui/Modal.astro';
import Button from '@/components/ui/Button.astro';
import { assetUrl, site } from '@/site.config';
---

<Modal 
  id="order-modal"
  title="Finalizar pedido"
  class="order-modal"
>
  <div class="order-modal-content">
    <p class="order-modal-text">Completa tus datos y elegí cómo enviar el pedido:</p>

    <div class="form-group">
      <label for="customer-name" class="form-label">Nombre completo</label>
      <input 
        type="text" 
        id="customer-name" 
        class="form-input"
        placeholder="Juan Pérez"
        required
        maxlength="80"
        autocomplete="name"
      />
    </div>

    <div class="form-group">
      <label for="customer-contact" class="form-label">Contacto (WhatsApp o Instagram)</label>
      <input 
        type="text" 
        id="customer-contact" 
        class="form-input"
        placeholder="+54 9 11 1234-5678 / @usuario"
        required
        maxlength="120"
        autocomplete="tel"
      />
    </div>

    <div class="form-group">
      <label for="order-preview" class="form-label">Mensaje del pedido</label>
      <textarea 
        id="order-preview" 
        class="form-textarea order-preview"
        readonly
        aria-label="Vista previa del mensaje del pedido"
      ></textarea>
    </div>

    <div class="order-modal-actions">
      <Button 
        variant="primary" 
        class="order-modal-btn"
        data-send-whatsapp
        aria-label="Enviar por WhatsApp"
        title="Enviar por WhatsApp"
      >
        <span class="order-modal-btn-icon">
          <img src={assetUrl('images/icons/whatsapp.svg')} width="20" height="20" alt="" aria-hidden="true" />
        </span>
        <span class="order-modal-btn-label">Enviar por WhatsApp</span>
      </Button>
      <Button 
        variant="secondary" 
        class="order-modal-btn"
        data-send-instagram
        aria-label="Enviar por Instagram"
        title="Enviar por Instagram"
      >
        <span class="order-modal-btn-icon">
          <img src={assetUrl('images/icons/instagram.svg')} width="20" height="20" alt="" aria-hidden="true" />
        </span>
        <span class="order-modal-btn-label">Enviar por Instagram</span>
      </Button>
      <Button 
        variant="ghost" 
        class="order-modal-btn order-modal-btn--copy"
        data-copy-order
        aria-label="Copiar mensaje"
        title="Copiar mensaje"
      >
        <span class="order-modal-btn-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
        </span>
        <span class="order-modal-btn-label">Copiar mensaje</span>
      </Button>
    </div>

    <p class="order-modal-note">El pedido se envía a <strong>@{site.instagramHandle}</strong></p>
  </div>
</Modal>

<script>
  import { getCart } from '@/utils/cart';
  import { generateOrderText, buildWhatsAppLink } from '@/utils/formatters';
  import type { OrderChannel } from '@/utils/formatters';
  import { getPerfumesMap } from '@/utils/perfumes-client';
  import { bindOnce, onPageLoad, onWindowOnce } from '@/utils/view-transitions';
  import { site } from '@/site.config';

  const WHATSAPP_NUMBER = site.whatsappNumber;
  const INSTAGRAM_HANDLE = site.instagramHandle;

  let nameInput: HTMLInputElement | null = null;
  let contactInput: HTMLInputElement | null = null;
  let preview: HTMLTextAreaElement | null = null;
  let copyBtn: HTMLElement | null = null;

  async function buildOrderText(channel: OrderChannel = 'whatsapp'): Promise<string> {
    const cart = getCart();
    const perfumesMap = await getPerfumesMap();
    const name = nameInput?.value.trim() || '[Tu nombre]';
    const contact = contactInput?.value.trim() || '[Tu WhatsApp/Instagram]';
    return generateOrderText(cart.items, perfumesMap, name, contact, channel);
  }

  async function refreshPreview() {
    if (preview) {
      preview.value = await buildOrderText();
      autoResizePreview();
    }
  }

  function autoResizePreview() {
    if (!preview) return;
    preview.style.height = 'auto';
    preview.style.height = `${preview.scrollHeight}px`;
  }

  async function copyTextToClipboard(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      if (preview) {
        preview.select();
        try {
          return (document as any).execCommand('copy');
        } catch {
          return false;
        }
      }
      return false;
    }
  }

  function openModal() {
    const modal = document.querySelector('#order-modal');
    if (!modal) return;
    modal.dispatchEvent(new CustomEvent('modal:open'));
    requestAnimationFrame(autoResizePreview);
  }

  onWindowOnce('order-finalize', 'order:finalize', async () => {
    // Pre-calienta el catálogo para que `window.open` se ejecute dentro de
    // la activación de usuario (un fetch pendiente haría que el popup
    // blocker bloquee el envío por WhatsApp).
    await getPerfumesMap().catch(() => null);
    refreshPreview();
    openModal();
  });

  onPageLoad('order-modal', () => {
    const modal = document.querySelector('#order-modal');
    if (!modal) return;

    nameInput = modal.querySelector('#customer-name') as HTMLInputElement | null;
    contactInput = modal.querySelector('#customer-contact') as HTMLInputElement | null;
    preview = modal.querySelector('#order-preview') as HTMLTextAreaElement | null;
    const whatsappBtn = modal.querySelector('[data-send-whatsapp]') as HTMLElement | null;
    const instagramBtn = modal.querySelector('[data-send-instagram]') as HTMLElement | null;
    copyBtn = modal.querySelector('[data-copy-order]') as HTMLElement | null;

    if (nameInput) {
      bindOnce(nameInput, (el) => el.addEventListener('input', refreshPreview));
    }
    if (contactInput) {
      bindOnce(contactInput, (el) => el.addEventListener('input', refreshPreview));
    }
    if (whatsappBtn) {
      bindOnce(whatsappBtn, (el) => el.addEventListener('click', async () => {
        const text = await buildOrderText();
        const url = buildWhatsAppLink(WHATSAPP_NUMBER, text);
        const win = window.open(url, '_blank', 'noopener');
        // Si el popup blocker lo intercepta, copiá el mensaje y abrí igual
        // el link como ancla (navegación directa, no bloqueable).
        if (!win) {
          await copyTextToClipboard(text);
          const a = document.createElement('a');
          a.href = url;
          a.target = '_blank';
          a.rel = 'noopener';
          a.click();
        }
      }));
    }
    if (instagramBtn) {
      bindOnce(instagramBtn, (el) => el.addEventListener('click', async () => {
        const text = await buildOrderText('instagram');
        const label = el.querySelector('.order-modal-btn-label');
        const originalText = label?.textContent || '';
        const copied = await copyTextToClipboard(text);
        window.open(`https://ig.me/m/${INSTAGRAM_HANDLE}`, '_blank');
        if (copied && label) {
          label.textContent = '¡Copiado!';
          setTimeout(() => {
            if (label) label.textContent = originalText;
          }, 2000);
        }
      }));
    }
    if (copyBtn) {
      bindOnce(copyBtn, (el) => el.addEventListener('click', async () => {
        if (!preview) return;
        const label = el.querySelector('.order-modal-btn-label');
        const originalText = label?.textContent || '';
        const copied = await copyTextToClipboard(preview.value);
        if (copied && label) {
          label.textContent = '¡Copiado!';
          setTimeout(() => {
            if (label) label.textContent = originalText;
          }, 2000);
        }
      }));
    }
  });
</script>

<style>
  .order-modal {
    --modal-width: 515px;
  }

  :global(#order-modal .modal-content) {
    scrollbar-width: thin;
    scrollbar-color: var(--color-outline-variant) transparent;
  }

  :global(#order-modal .modal-content::-webkit-scrollbar) {
    width: 5px;
  }

  :global(#order-modal .modal-content::-webkit-scrollbar-track) {
    background: transparent;
  }

  :global(#order-modal .modal-content::-webkit-scrollbar-thumb) {
    background-color: var(--color-outline-variant);
    border-radius: 4px;
  }

  :global(#order-modal .modal) {
    width: 515px;
  }

  @media (max-width: 640px) {
    :global(#order-modal .modal) {
      width: 100vw;
      max-width: 100vw;
    }
  }

  .order-modal-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .order-modal-text {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    color: var(--color-on-surface-variant);
    margin: 0;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-label {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
  }

  .form-input {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    color: var(--color-on-surface);
    background-color: var(--color-surface-container-high);
    border: var(--border-width) solid var(--color-outline-variant);
    border-radius: var(--border-radius);
    padding: 12px 16px;
    transition: all var(--transition-duration) var(--transition-easing);
  }

  .form-input::placeholder {
    color: var(--color-on-surface-variant);
    opacity: 0.5;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(233, 193, 118, 0.2);
  }

  .form-textarea {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    color: var(--color-on-surface-variant);
    background-color: var(--color-surface-container-high);
    border: var(--border-width) solid var(--color-outline-variant);
    border-radius: var(--border-radius);
    padding: 12px 16px;
    resize: none;
    overflow-y: auto;
    max-height: 180px;
    line-height: 1.6;
    scrollbar-width: thin;
    scrollbar-color: var(--color-outline-variant) transparent;
  }

  .form-textarea::-webkit-scrollbar {
    width: 5px;
  }

  .form-textarea::-webkit-scrollbar-track {
    background: transparent;
  }

  .form-textarea::-webkit-scrollbar-thumb {
    background-color: var(--color-outline-variant);
    border-radius: 4px;
  }

  .order-preview {
    font-family: 'Montserrat', monospace;
    font-size: 13px;
    white-space: pre-wrap;
  }

  .order-modal-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    margin-top: 4px;
  }

  .order-modal-actions .order-modal-btn {
    flex: none;
    width: 100%;
    min-width: 0;
    height: 38px;
    padding: 0 6px;
    gap: 3px;
    border-radius: var(--border-radius);
    font-size: 10px;
    letter-spacing: 0.04em;
  }

  .order-modal-actions .order-modal-btn--copy {
    grid-column: 1 / -1;
    justify-self: center;
    width: auto;
    padding: 0 16px;
  }

  .order-modal-btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .order-modal-btn-icon svg {
    width: 16px;
    height: 16px;
  }

  .order-modal-btn-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 479px) {
    .order-modal-actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 16px;
    }

    .order-modal-actions .order-modal-btn {
      width: 56px;
      height: 56px;
      padding: 0;
      border-radius: 50%;
      flex: 0 0 auto;
    }

    .order-modal-btn-label {
      display: none;
    }
  }

  .order-modal-note {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    color: var(--color-on-surface-variant);
    text-align: center;
    margin: 0;
  }

  .order-modal-note strong {
    color: var(--color-primary);
  }
</style>
