---
import Modal from '@/components/ui/Modal.astro';
import Button from '@/components/ui/Button.astro';
---

<Modal 
  id="order-modal"
  title="Finalizar pedido"
  class="order-modal"
>
  <div class="order-modal-content">
    <p class="order-modal-text">Completa tus datos y elegí cómo enviar el pedido:</p>

    <div class="form-group">
      <label for="customer-name" class="form-label">Nombre completo</label>
      <input 
        type="text" 
        id="customer-name" 
        class="form-input"
        placeholder="Juan Pérez"
        aria-required="true"
        autocomplete="name"
      />
    </div>

    <div class="form-group">
      <label for="customer-contact" class="form-label">Contacto (WhatsApp o Instagram)</label>
      <input 
        type="text" 
        id="customer-contact" 
        class="form-input"
        placeholder="+54 9 11 1234-5678 / @usuario"
        aria-required="true"
        autocomplete="tel"
      />
    </div>

    <div class="form-group">
      <label for="order-preview" class="form-label">Mensaje del pedido</label>
      <textarea 
        id="order-preview" 
        class="form-textarea order-preview"
        readonly
        aria-label="Vista previa del mensaje del pedido"
      ></textarea>
    </div>

    <div class="order-modal-actions">
      <Button 
        variant="primary" 
        class="order-modal-btn"
        data-send-whatsapp
        aria-label="Enviar por WhatsApp"
        title="Enviar por WhatsApp"
      >
        <span class="order-modal-btn-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
        </span>
        <span class="order-modal-btn-label">Enviar por WhatsApp</span>
      </Button>
      <Button 
        variant="secondary" 
        class="order-modal-btn"
        data-send-instagram
        aria-label="Enviar por Instagram"
        title="Enviar por Instagram"
      >
        <span class="order-modal-btn-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </span>
        <span class="order-modal-btn-label">Enviar por Instagram</span>
      </Button>
      <Button 
        variant="ghost" 
        class="order-modal-btn order-modal-btn--copy"
        data-copy-order
        aria-label="Copiar mensaje"
        title="Copiar mensaje"
      >
        <span class="order-modal-btn-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
        </span>
        <span class="order-modal-btn-label">Copiar mensaje</span>
      </Button>
    </div>

    <p class="order-modal-note">El pedido se envía a <strong>@atomiza.cba</strong></p>
  </div>
</Modal>

<script>
  import { getCart } from '@/utils/cart';
  import { generateOrderText, buildWhatsAppLink } from '@/utils/formatters';

  const WHATSAPP_NUMBER = '5493472559307';
  const INSTAGRAM_HANDLE = 'atomiza.cba';

  const modal = document.querySelector('#order-modal');
  const nameInput = modal?.querySelector('#customer-name') as HTMLInputElement | null;
  const contactInput = modal?.querySelector('#customer-contact') as HTMLInputElement | null;
  const preview = modal?.querySelector('#order-preview') as HTMLTextAreaElement | null;
  const whatsappBtn = modal?.querySelector('[data-send-whatsapp]') as HTMLElement | null;
  const instagramBtn = modal?.querySelector('[data-send-instagram]') as HTMLElement | null;
  const copyBtn = modal?.querySelector('[data-copy-order]') as HTMLElement | null;

  function getPerfumesMap(): Map<string, any> {
    try {
      const data = JSON.parse(localStorage.getItem('perfumes-data') || '{"perfumes":[]}');
      return new Map((data.perfumes || []).map((p: any) => [p.id, p]));
    } catch {
      return new Map();
    }
  }

  function buildOrderText(): string {
    const cart = getCart();
    const perfumesMap = getPerfumesMap();
    const name = nameInput?.value.trim() || '[Tu nombre]';
    const contact = contactInput?.value.trim() || '[Tu WhatsApp/Instagram]';
    return generateOrderText(cart.items, perfumesMap, name, contact);
  }

  function refreshPreview() {
    if (preview) {
      preview.value = buildOrderText();
      autoResizePreview();
    }
  }

  function autoResizePreview() {
    if (!preview) return;
    preview.style.height = 'auto';
    preview.style.height = `${preview.scrollHeight}px`;
  }

  function openModal() {
    if (!modal) return;
    const event = new CustomEvent('modal:open');
    modal.dispatchEvent(event);
    requestAnimationFrame(autoResizePreview);
  }

  nameInput?.addEventListener('input', refreshPreview);
  contactInput?.addEventListener('input', refreshPreview);

  whatsappBtn?.addEventListener('click', () => {
    const text = buildOrderText();
    window.open(buildWhatsAppLink(WHATSAPP_NUMBER, text), '_blank');
  });

  instagramBtn?.addEventListener('click', () => {
    const text = encodeURIComponent(buildOrderText());
    window.open(`https://ig.me/m/${INSTAGRAM_HANDLE}?text=${text}`, '_blank');
  });

  copyBtn?.addEventListener('click', async () => {
    if (!preview) return;
    try {
      await navigator.clipboard.writeText(preview.value);
    } catch {
      preview.select();
      document.execCommand('copy');
    }
    const label = copyBtn.querySelector('.order-modal-btn-label');
    const originalText = label?.textContent || '';
    if (label) label.textContent = '¡Copiado!';
    setTimeout(() => {
      if (label) label.textContent = originalText;
    }, 2000);
  });

  window.addEventListener('order:finalize', () => {
    refreshPreview();
    openModal();
  });
</script>

<style>
  .order-modal {
    --modal-width: 480px;
  }

  .order-modal-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .order-modal-text {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    color: var(--color-on-surface-variant);
    margin: 0;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-label {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
  }

  .form-input {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    color: var(--color-on-surface);
    background-color: var(--color-surface-container-high);
    border: var(--border-width) solid var(--color-outline-variant);
    border-radius: var(--border-radius);
    padding: 12px 16px;
    transition: all var(--transition-duration) var(--transition-easing);
  }

  .form-input::placeholder {
    color: var(--color-on-surface-variant);
    opacity: 0.5;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(233, 193, 118, 0.2);
  }

  .form-textarea {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    color: var(--color-on-surface-variant);
    background-color: var(--color-surface-container-high);
    border: var(--border-width) solid var(--color-outline-variant);
    border-radius: var(--border-radius);
    padding: 12px 16px;
    resize: none;
    overflow: hidden;
    line-height: 1.6;
  }

  .order-preview {
    font-family: 'Montserrat', monospace;
    font-size: 13px;
    white-space: pre-wrap;
  }

  .order-modal-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 8px;
  }

  .order-modal-btn {
    flex: 0 0 auto;
    width: 52px;
    height: 52px;
    padding: 0;
    gap: 0;
    border-radius: 50%;
  }

  .order-modal-btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .order-modal-btn-label {
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    white-space: nowrap;
    transition: max-width var(--transition-duration) var(--transition-easing), opacity var(--transition-duration) var(--transition-easing), margin-left var(--transition-duration) var(--transition-easing);
  }

  .order-modal-btn:hover .order-modal-btn-label,
  .order-modal-btn:focus-visible .order-modal-btn-label {
    max-width: 220px;
    opacity: 1;
    margin-left: 8px;
  }

  .order-modal-btn--copy {
    border-radius: var(--border-radius);
  }

  @media (min-width: 480px) {
    .order-modal-actions {
      justify-content: space-between;
    }
  }

  .order-modal-note {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    color: var(--color-on-surface-variant);
    text-align: center;
    margin: 0;
  }

  .order-modal-note strong {
    color: var(--color-primary);
  }
</style>
