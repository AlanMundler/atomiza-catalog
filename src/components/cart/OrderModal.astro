---
import Modal from '@/components/ui/Modal.astro';
import Button from '@/components/ui/Button.astro';
import { assetUrl, site } from '@/site.config';
---

<Modal 
  id="order-modal"
  title="Finalizar pedido"
  class="order-modal"
>
  <div class="order-modal-content">
    <nav class="order-stepper" aria-label="Pasos del pedido">
      <ol class="stepper-list">
        <li class="stepper-item stepper-item--done">
          <span class="stepper-circle" aria-hidden="true">1</span>
          <span class="stepper-label">Carrito</span>
        </li>
        <li class="stepper-item stepper-item--current">
          <span class="stepper-circle" aria-hidden="true">2</span>
          <span class="stepper-label">Datos</span>
        </li>
        <li class="stepper-item">
          <span class="stepper-circle" aria-hidden="true">3</span>
          <span class="stepper-label">Envío</span>
        </li>
      </ol>
    </nav>
    <p class="order-modal-text">Completa tus datos y elegí cómo enviar el pedido:</p>

    <div class="form-group">
      <label for="customer-name" class="form-label">Nombre completo</label>
      <input 
        type="text" 
        id="customer-name" 
        class="form-input"
        placeholder="Juan Pérez"
        required
        maxlength="80"
        autocomplete="name"
      />
    </div>

    <div class="form-group">
      <label for="customer-contact" class="form-label">Contacto (WhatsApp o Instagram)</label>
      <input 
        type="text" 
        id="customer-contact" 
        class="form-input"
        placeholder="+54 9 11 1234-5678 / @usuario"
        required
        maxlength="120"
        autocomplete="tel"
      />
    </div>

    <p class="form-error" data-form-error hidden role="alert"></p>

    <div class="form-group">
      <label for="order-preview" class="form-label">Mensaje del pedido</label>
      <textarea 
        id="order-preview" 
        class="form-textarea order-preview"
        readonly
        aria-label="Vista previa del mensaje del pedido"
      ></textarea>
    </div>

    <div class="order-modal-actions">
      <Button 
        variant="primary" 
        class="order-modal-btn"
        data-send-whatsapp
        aria-label="Enviar por WhatsApp"
        title="Enviar por WhatsApp"
      >
        <span class="order-modal-btn-icon">
          <img src={assetUrl('images/icons/whatsapp.svg')} width="24" height="24" alt="" aria-hidden="true" />
        </span>
        <span class="order-modal-btn-label">Enviar por WhatsApp</span>
      </Button>
      <Button 
        variant="secondary" 
        class="order-modal-btn"
        data-send-instagram
        aria-label="Enviar por Instagram"
        title="Enviar por Instagram"
      >
        <span class="order-modal-btn-icon">
          <img src={assetUrl('images/icons/instagram.svg')} width="26" height="26" alt="" aria-hidden="true" />
        </span>
        <span class="order-modal-btn-label">Enviar por Instagram</span>
      </Button>
      <Button 
        variant="ghost" 
        class="order-modal-btn order-modal-btn--copy"
        data-copy-order
        aria-label="Copiar mensaje"
        title="Copiar mensaje"
      >
        <span class="order-modal-btn-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
        </span>
        <span class="order-modal-btn-label">Copiar mensaje</span>
      </Button>
    </div>

    <p class="order-modal-note">El pedido se envía a <strong>@{site.instagramHandle}</strong></p>
  </div>
</Modal>

<script>
  import { getCart } from '@/utils/cart';
  import { generateOrderText, buildWhatsAppLink } from '@/utils/formatters';
  import type { OrderChannel } from '@/utils/formatters';
  import { getPerfumesMap } from '@/utils/perfumes-client';
  import { bindOnce, onPageLoad, onWindowOnce } from '@/utils/view-transitions';
  import { site } from '@/site.config';

  const WHATSAPP_NUMBER = site.whatsappNumber;
  const INSTAGRAM_HANDLE = site.instagramHandle;
  const ORDER_FORM_STORAGE_KEY = 'atomiza-order-form';

  function loadSavedForm(): { name: string; contact: string } {
    try {
      const stored = localStorage.getItem(ORDER_FORM_STORAGE_KEY);
      if (stored) {
        const parsed = JSON.parse(stored);
        return { name: parsed.name || '', contact: parsed.contact || '' };
      }
    } catch {
      // Ignore parse errors
    }
    return { name: '', contact: '' };
  }

  function saveForm(name: string, contact: string): void {
    try {
      localStorage.setItem(ORDER_FORM_STORAGE_KEY, JSON.stringify({ name, contact }));
    } catch {
      // Ignore quota errors
    }
  }

  let nameInput: HTMLInputElement | null = null;
  let contactInput: HTMLInputElement | null = null;
  let preview: HTMLTextAreaElement | null = null;
  let copyBtn: HTMLElement | null = null;

  async function buildOrderText(channel: OrderChannel = 'whatsapp'): Promise<string> {
    const cart = getCart();
    const perfumesMap = await getPerfumesMap();
    const name = nameInput?.value.trim() || '[Tu nombre]';
    const contact = contactInput?.value.trim() || '[Tu WhatsApp/Instagram]';
    return generateOrderText(cart.items, perfumesMap, name, contact, channel);
  }

  async function refreshPreview() {
    if (preview) {
      preview.value = await buildOrderText();
      autoResizePreview();
    }
  }

  // El modal antes enviaba el pedido aunque nombre/contacto estuvieran
  // vacíos (el texto usaba `[Tu nombre]` como placeholder). Ahora se valida
  // y se bloquea el envío hasta completar los datos.
  function validateOrder(): string | null {
    if (getCart().items.length === 0) {
      return 'Tu carrito está vacío. Agregá al menos un decant antes de enviar.';
    }
    if ((nameInput?.value.trim() || '').length < 2) {
      return 'Escribí tu nombre para poder coordinar el pedido.';
    }
    if ((contactInput?.value.trim() || '').length < 3) {
      return 'Escribí tu WhatsApp o tu Instagram para poder contactarte.';
    }
    return null;
  }

  function showFormError(message: string | null): boolean {
    const modal = document.querySelector('#order-modal');
    const errorEl = modal?.querySelector('[data-form-error]') as HTMLElement | null;
    if (!errorEl) return message !== null;
    if (!message) {
      errorEl.hidden = true;
      errorEl.textContent = '';
      return false;
    }
    errorEl.textContent = message;
    errorEl.hidden = false;
    // Foco en el primer dato faltante para no hacer adivinar al usuario.
    if (getCart().items.length === 0) {
      (document.querySelector('[data-cart-trigger]') as HTMLElement | null)?.focus();
    } else if ((nameInput?.value.trim() || '').length < 2) {
      nameInput?.focus();
    } else {
      contactInput?.focus();
    }
    return true;
  }

  function autoResizePreview() {
    if (!preview) return;
    preview.style.height = 'auto';
    preview.style.height = `${preview.scrollHeight}px`;
  }

  async function copyTextToClipboard(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      if (preview) {
        preview.select();
        try {
          return (document as any).execCommand('copy');
        } catch {
          return false;
        }
      }
      return false;
    }
  }

  function openModal() {
    const modal = document.querySelector('#order-modal');
    if (!modal) return;

    // Cargar datos guardados si los inputs están vacíos
    if (nameInput && !nameInput.value.trim()) {
      const saved = loadSavedForm();
      if (saved.name) nameInput.value = saved.name;
      if (contactInput && saved.contact) contactInput.value = saved.contact;
    }

    modal.dispatchEvent(new CustomEvent('modal:open'));
    requestAnimationFrame(autoResizePreview);
  }

  onWindowOnce('order-finalize', 'order:finalize', async () => {
    // Pre-calienta el catálogo para que `window.open` se ejecute dentro de
    // la activación de usuario (un fetch pendiente haría que el popup
    // blocker bloquee el envío por WhatsApp).
    await getPerfumesMap().catch(() => null);
    await refreshPreview();
    showFormError(null);
    openModal();
  });

  onPageLoad('order-modal', () => {
    const modal = document.querySelector('#order-modal');
    if (!modal) return;

    nameInput = modal.querySelector('#customer-name') as HTMLInputElement | null;
    contactInput = modal.querySelector('#customer-contact') as HTMLInputElement | null;
    preview = modal.querySelector('#order-preview') as HTMLTextAreaElement | null;
    const whatsappBtn = modal.querySelector('[data-send-whatsapp]') as HTMLElement | null;
    const instagramBtn = modal.querySelector('[data-send-instagram]') as HTMLElement | null;
    copyBtn = modal.querySelector('[data-copy-order]') as HTMLElement | null;

    if (nameInput) {
      bindOnce(nameInput, (el) => el.addEventListener('input', () => { showFormError(null); refreshPreview(); saveForm(el.value, contactInput?.value || ''); }));
    }
    if (contactInput) {
      bindOnce(contactInput, (el) => el.addEventListener('input', () => { showFormError(null); refreshPreview(); saveForm(nameInput?.value || '', el.value); }));
    }
    if (whatsappBtn) {
      bindOnce(whatsappBtn, (el) => el.addEventListener('click', async () => {
        if (showFormError(validateOrder())) return;
        const text = await buildOrderText();
        const url = buildWhatsAppLink(WHATSAPP_NUMBER, text);
        const win = window.open(url, '_blank', 'noopener');
        // Si el popup blocker lo intercepta, copiá el mensaje y abrí igual
        // el link como ancla (navegación directa, no bloqueable). El ancla
        // tiene que estar en el DOM para que Safari/Firefox la sigan.
        if (!win) {
          await copyTextToClipboard(text);
          const a = document.createElement('a');
          a.href = url;
          a.target = '_blank';
          a.rel = 'noopener';
          a.style.display = 'none';
          document.body.appendChild(a);
          a.click();
          a.remove();
        }
      }));
    }
    if (instagramBtn) {
      bindOnce(instagramBtn, (el) => el.addEventListener('click', async () => {
        if (showFormError(validateOrder())) return;
        const text = await buildOrderText('instagram');
        const label = el.querySelector('.order-modal-btn-label');
        const originalText = label?.textContent || '';
        const copied = await copyTextToClipboard(text);
        window.open(`https://ig.me/m/${INSTAGRAM_HANDLE}`, '_blank', 'noopener');
        if (copied && label) {
          label.textContent = '¡Copiado!';
          setTimeout(() => {
            if (label) label.textContent = originalText;
          }, 2000);
        }
      }));
    }
    if (copyBtn) {
      bindOnce(copyBtn, (el) => el.addEventListener('click', async () => {
        if (!preview) return;
        const label = el.querySelector('.order-modal-btn-label');
        const originalText = label?.textContent || '';
        const copied = await copyTextToClipboard(preview.value);
        if (copied && label) {
          label.textContent = '¡Copiado!';
          setTimeout(() => {
            if (label) label.textContent = originalText;
          }, 2000);
        }
      }));
    }
  });
</script>

<style>
  .order-modal {
    --modal-width: 515px;
  }

  :global(#order-modal .modal-content) {
    scrollbar-width: thin;
    scrollbar-color: var(--color-outline-variant) transparent;
  }

  :global(#order-modal .modal-content::-webkit-scrollbar) {
    width: 5px;
  }

  :global(#order-modal .modal-content::-webkit-scrollbar-track) {
    background: transparent;
  }

  :global(#order-modal .modal-content::-webkit-scrollbar-thumb) {
    background-color: var(--color-outline-variant);
    border-radius: 4px;
  }

  :global(#order-modal .modal) {
    width: 515px;
  }

  @media (max-width: 640px) {
    :global(#order-modal .modal) {
      width: 100vw;
      max-width: 100vw;
    }
  }

  .order-modal-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .order-modal-text {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    color: var(--color-on-surface-variant);
    margin: 0;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-label {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
  }

  .form-input {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    color: var(--color-on-surface);
    background-color: var(--color-surface-container-high);
    border: var(--border-width) solid var(--color-outline-variant);
    border-radius: var(--border-radius);
    padding: 12px 16px;
    transition: all var(--transition-duration) var(--transition-easing);
  }

  .form-input::placeholder {
    color: var(--color-on-surface-variant);
    opacity: 0.5;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(233, 193, 118, 0.2);
  }

  .form-error {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    color: var(--color-error);
    background-color: var(--color-error-container);
    border-radius: var(--border-radius);
    padding: 10px 14px;
    margin: 0;
  }

  .form-textarea {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    color: var(--color-on-surface-variant);
    background-color: var(--color-surface-container-high);
    border: var(--border-width) solid var(--color-outline-variant);
    border-radius: var(--border-radius);
    padding: 12px 16px;
    resize: none;
    overflow-y: auto;
    max-height: 180px;
    line-height: 1.6;
    scrollbar-width: thin;
    scrollbar-color: var(--color-outline-variant) transparent;
  }

  .form-textarea::-webkit-scrollbar {
    width: 5px;
  }

  .form-textarea::-webkit-scrollbar-track {
    background: transparent;
  }

  .form-textarea::-webkit-scrollbar-thumb {
    background-color: var(--color-outline-variant);
    border-radius: 4px;
  }

  .order-preview {
    font-family: 'Montserrat', monospace;
    font-size: 13px;
    white-space: pre-wrap;
  }

  .order-modal-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    margin-top: 4px;
  }

  .order-modal-actions .order-modal-btn {
    flex: none;
    width: 100%;
    min-width: 0;
    min-height: 44px;
    padding: 0 12px;
    gap: 8px;
    border-radius: var(--border-radius);
    font-size: var(--font-label-sm-size);
    letter-spacing: var(--font-label-sm-tracking);
  }

  .order-modal-actions .order-modal-btn--copy {
    grid-column: 1 / -1;
    justify-self: center;
    width: auto;
    padding: 0 16px;
  }

  .order-modal-btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .order-modal-btn-icon svg {
    width: 16px;
    height: 16px;
  }

  .order-modal-btn-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 479px) {
    .order-modal-actions {
      grid-template-columns: 1fr;
    }

    .order-modal-actions .order-modal-btn {
      min-height: 48px;
      font-size: var(--font-label-sm-size);
      justify-content: center;
    }

    .order-modal-actions .order-modal-btn--copy {
      grid-column: 1;
    }
  }

  .order-modal-note {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    color: var(--color-on-surface-variant);
    text-align: center;
    margin: 0;
  }

  .order-modal-note strong {
    color: var(--color-primary);
  }

  /* Stepper visual */
  .order-stepper {
    margin-bottom: var(--spacing-stack-md);
  }

  .stepper-list {
    display: flex;
    justify-content: space-between;
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  .stepper-list::before {
    content: '';
    position: absolute;
    top: 16px;
    left: 16px;
    right: 16px;
    height: 2px;
    background-color: var(--color-outline-variant);
    z-index: 0;
  }

  .stepper-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    flex: 1;
    position: relative;
    z-index: 1;
  }

  .stepper-circle {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    background-color: var(--color-surface-container-high);
    border: var(--border-width) solid var(--color-outline-variant);
    color: var(--color-on-surface-variant);
    transition: all var(--transition-duration) var(--transition-easing);
  }

  .stepper-label {
    font-family: var(--font-family);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
    text-align: center;
    white-space: nowrap;
  }

  .stepper-item--done .stepper-circle {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-on-primary);
  }

  .stepper-item--done .stepper-label {
    color: var(--color-primary);
  }

  .stepper-item--current .stepper-circle {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-on-primary);
    box-shadow: 0 0 0 3px rgba(233, 193, 118, 0.3);
  }

  .stepper-item--current .stepper-label {
    color: var(--color-primary);
    font-weight: 600;
  }

  @media (max-width: 479px) {
    .stepper-circle {
      width: 28px;
      height: 28px;
      font-size: 10px;
    }
    .stepper-label {
      font-size: 10px;
    }
  }
</style>
