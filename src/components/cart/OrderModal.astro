---
import Modal from '@/components/ui/Modal.astro';
import Button from '@/components/ui/Button.astro';
import { assetUrl, site } from '@/site.config';
---

<Modal 
  id="order-modal"
  title="Armar pedido"
  class="order-modal"
>
  <div class="order-modal-content">
    <nav class="order-stepper" aria-label="Pasos del pedido">
      <ol class="stepper-list">
        <li class="stepper-item stepper-item--done">
          <span class="stepper-circle" aria-hidden="true">1</span>
          <span class="stepper-label">Carrito</span>
        </li>
        <li class="stepper-item stepper-item--current" aria-current="step">
          <span class="stepper-circle" aria-hidden="true">2</span>
          <span class="stepper-label">Datos</span>
        </li>
        <li class="stepper-item">
          <span class="stepper-circle" aria-hidden="true">3</span>
          {/* "Envío" mentía: el envío se coordina fuera, en WhatsApp/Instagram. */}
          <span class="stepper-label">Enviar</span>
        </li>
      </ol>
    </nav>
    <p class="order-modal-text">Completá tus datos y elegí cómo querés recibir el pedido:</p>

    <div class="form-group">
      <label for="customer-name" class="form-label">Nombre completo</label>
      <input
        type="text"
        id="customer-name"
        class="form-input"
        placeholder="Juan Pérez"
        required
        maxlength="80"
        autocomplete="name"
        aria-describedby="order-form-error"
      />
    </div>

    <div class="form-group">
      <label for="customer-contact" class="form-label">Contacto (WhatsApp o Instagram)</label>
      <input
        type="text"
        id="customer-contact"
        class="form-input"
        placeholder="+54 9 11 1234-5678 / @usuario"
        required
        maxlength="120"
        autocomplete="tel"
        aria-describedby="order-form-error"
      />
    </div>

    <p class="form-error" id="order-form-error" data-form-error hidden role="alert"></p>

    <div class="form-group">
      <span class="form-label" id="order-delivery-label">Entrega</span>
      <div class="delivery-options" role="radiogroup" aria-labelledby="order-delivery-label">
        {Object.entries(site.delivery).map(([value, label]) => (
          <label class="delivery-chip">
            <input
              type="radio"
              class="delivery-radio"
              name="order-delivery"
              value={value}
              checked={value === 'coordinar'}
              data-delivery-option
            />
            <span class="delivery-chip-text">{label}</span>
          </label>
        ))}
      </div>
    </div>

    <details class="order-preview-details">
      <summary class="order-preview-summary">Ver el mensaje del pedido</summary>
      <textarea
        id="order-preview"
        class="form-textarea order-preview"
        readonly
        aria-label="Mensaje del pedido"
      ></textarea>
    </details>

    <div class="order-modal-actions">
      <Button 
        variant="primary" 
        size="lg"
        class="order-modal-btn order-modal-btn--main"
        data-send-whatsapp
        aria-label="Enviar por WhatsApp"
      >
        <span class="order-modal-btn-icon">
          <img src={assetUrl('images/icons/whatsapp.svg')} width="24" height="24" alt="" aria-hidden="true" />
        </span>
        <span class="order-modal-btn-label">Enviar por WhatsApp</span>
      </Button>

      <p class="order-modal-note">Te respondemos hoy y coordinamos pago y entrega. El pedido va a <strong>@{site.instagramHandle}</strong></p>

      <div class="order-modal-actions-secondary">
        <Button 
          variant="secondary" 
          class="order-modal-btn order-modal-btn--alt"
          data-send-instagram
          aria-label="Enviar por Instagram"
        >
          <span class="order-modal-btn-icon">
            <img src={assetUrl('images/icons/instagram.svg')} width="20" height="20" alt="" aria-hidden="true" />
          </span>
          <span class="order-modal-btn-label">Instagram</span>
        </Button>
        <Button 
          variant="secondary" 
          class="order-modal-btn order-modal-btn--alt"
          data-copy-order
          aria-label="Copiar mensaje"
        >
          <span class="order-modal-btn-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
          </span>
          <span class="order-modal-btn-label">Copiar mensaje</span>
        </Button>
      </div>
    </div>
  </div>
</Modal>

<script>
  import { getCart } from '@/utils/cart';
  import { generateOrderText, buildWhatsAppLink, resolveCartItems } from '@/utils/formatters';
  import type { DeliveryKey, OrderChannel } from '@/utils/formatters';
  import { getPerfumesMap } from '@/utils/perfumes-client';
  import { bindOnce, onPageLoad, onWindowOnce } from '@/utils/view-transitions';
  import { site } from '@/site.config';

  const WHATSAPP_NUMBER = site.whatsappNumber;
  const INSTAGRAM_HANDLE = site.instagramHandle;
  const ORDER_FORM_STORAGE_KEY = site.storage.orderForm;

  function isDeliveryKey(value: unknown): value is DeliveryKey {
    return typeof value === 'string' && Object.prototype.hasOwnProperty.call(site.delivery, value);
  }

  function loadSavedForm(): { name: string; contact: string; delivery: DeliveryKey } {
    try {
      const stored = localStorage.getItem(ORDER_FORM_STORAGE_KEY);
      if (stored) {
        const parsed = JSON.parse(stored);
        return {
          name: parsed.name || '',
          contact: parsed.contact || '',
          delivery: isDeliveryKey(parsed.delivery) ? parsed.delivery : 'coordinar',
        };
      }
    } catch {
      // Ignore parse errors
    }
    return { name: '', contact: '', delivery: 'coordinar' };
  }

  function saveForm(name: string, contact: string, delivery: DeliveryKey): void {
    try {
      localStorage.setItem(ORDER_FORM_STORAGE_KEY, JSON.stringify({ name, contact, delivery }));
    } catch {
      // Ignore quota errors
    }
  }

  let nameInput: HTMLInputElement | null = null;
  let contactInput: HTMLInputElement | null = null;
  let preview: HTMLTextAreaElement | null = null;
  let copyBtn: HTMLElement | null = null;
  let previewDetails: HTMLDetailsElement | null = null;

  /** Entrega elegida en los chips (default 'coordinar' si nada marcado). */
  function getDelivery(): DeliveryKey {
    const checked = document.querySelector<HTMLInputElement>(
      '#order-modal [name="order-delivery"]:checked'
    );
    return isDeliveryKey(checked?.value) ? checked.value : 'coordinar';
  }

  async function buildOrderText(channel: OrderChannel = 'whatsapp'): Promise<string> {
    const cart = getCart();
    const perfumesMap = await getPerfumesMap();
    const name = nameInput?.value.trim() || '[Tu nombre]';
    const contact = contactInput?.value.trim() || '[Tu WhatsApp/Instagram]';
    return generateOrderText({
      items: cart.items,
      perfumes: perfumesMap,
      customerName: name,
      contact: contact,
      channel,
      delivery: getDelivery(),
    });
  }

  async function refreshPreview() {
    if (preview) {
      preview.value = await buildOrderText();
      autoResizePreview();
    }
  }

  // El modal antes enviaba el pedido aunque nombre/contacto estuvieran
  // vacíos (el texto usaba `[Tu nombre]` como placeholder). Ahora se valida
  // y se bloquea el envío hasta completar los datos. Además se valida contra
  // items COMPRABLES (con stock en el catálogo vivo): si todo quedó SIN
  // STOCK después de agregar, el pedido saldría con TOTAL $0.
  async function validateOrder(): Promise<string | null> {
    if (getCart().items.length === 0) {
      return 'Tu carrito está vacío. Agregá al menos un decant antes de enviar.';
    }
    if ((nameInput?.value.trim() || '').length < 2) {
      return 'Escribí tu nombre para poder coordinar el pedido.';
    }
    if ((contactInput?.value.trim() || '').length < 3) {
      return 'Escribí tu WhatsApp o tu Instagram para poder contactarte.';
    }
    try {
      const orderable = resolveCartItems(getCart().items, await getPerfumesMap())
        .filter((r) => r.available);
      if (orderable.length === 0) {
        return 'Los perfumes de tu carrito quedaron sin stock. Sacalos y elegí otros del catálogo.';
      }
    } catch {
      // Sin catálogo no se puede validar stock: se deja pasar, el texto del
      // pedido igual se arma contra el catálogo vivo al enviar.
    }
    return null;
  }

  function showFormError(message: string | null): boolean {
    const modal = document.querySelector('#order-modal');
    const errorEl = modal?.querySelector('[data-form-error]') as HTMLElement | null;
    const invalid = message !== null;
    if (nameInput) nameInput.setAttribute('aria-invalid', String(invalid && (nameInput.value.trim().length < 2)));
    if (contactInput) contactInput.setAttribute('aria-invalid', String(invalid && (contactInput.value.trim().length < 3)));
    if (!errorEl) return invalid;
    if (!message) {
      errorEl.hidden = true;
      errorEl.textContent = '';
      return false;
    }
    errorEl.textContent = message;
    errorEl.hidden = false;
    // Foco en el primer dato faltante para no hacer adivinar al usuario.
    if (getCart().items.length === 0) {
      (document.querySelector('[data-cart-trigger]') as HTMLElement | null)?.focus();
    } else if ((nameInput?.value.trim() || '').length < 2) {
      nameInput?.focus();
    } else {
      contactInput?.focus();
    }
    return true;
  }

  function autoResizePreview() {
    if (!preview) return;
    // Con el <details> cerrado el textarea no está pintado y scrollHeight da
    // 0: redimensionar igual lo dejaría en altura 0 al abrirlo.
    if (preview.getClientRects().length === 0) return;
    preview.style.height = 'auto';
    preview.style.height = `${preview.scrollHeight}px`;
  }

  async function copyTextToClipboard(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      if (preview) {
        // El fallback selecciona el textarea: necesita que el <details> esté
        // abierto para que la selección exista.
        if (previewDetails) previewDetails.open = true;
        preview.select();
        try {
          return document.execCommand('copy');
        } catch {
          return false;
        }
      }
      return false;
    }
  }

  function persistForm(): void {
    saveForm(nameInput?.value || '', contactInput?.value || '', getDelivery());
  }

  function openModal() {
    const modal = document.querySelector('#order-modal');
    if (!modal) return;

    // Cargar datos guardados si los inputs están vacíos
    if (nameInput && !nameInput.value.trim()) {
      const saved = loadSavedForm();
      if (saved.name) nameInput.value = saved.name;
      if (contactInput && saved.contact) contactInput.value = saved.contact;
      if (saved.delivery !== 'coordinar') {
        const radio = modal.querySelector<HTMLInputElement>(
          `[name="order-delivery"][value="${saved.delivery}"]`
        );
        if (radio) radio.checked = true;
      }
    }

    modal.dispatchEvent(new CustomEvent('modal:open'));
    requestAnimationFrame(autoResizePreview);
  }

  onWindowOnce('order-finalize', 'order:finalize', async () => {
    // Pre-calienta el catálogo para que `window.open` se ejecute dentro de
    // la activación de usuario (un fetch pendiente haría que el popup
    // blocker bloquee el envío por WhatsApp).
    await getPerfumesMap().catch(() => null);
    await refreshPreview();
    showFormError(null);
    openModal();
  });

  onPageLoad('order-modal', () => {
    const modal = document.querySelector('#order-modal');
    if (!modal) return;

    nameInput = modal.querySelector('#customer-name') as HTMLInputElement | null;
    contactInput = modal.querySelector('#customer-contact') as HTMLInputElement | null;
    preview = modal.querySelector('#order-preview') as HTMLTextAreaElement | null;
    previewDetails = modal.querySelector('.order-preview-details') as HTMLDetailsElement | null;
    const whatsappBtn = modal.querySelector('[data-send-whatsapp]') as HTMLElement | null;
    const instagramBtn = modal.querySelector('[data-send-instagram]') as HTMLElement | null;
    copyBtn = modal.querySelector('[data-copy-order]') as HTMLElement | null;

    if (nameInput) {
      bindOnce(nameInput, (el) => el.addEventListener('input', () => { showFormError(null); refreshPreview(); saveForm(el.value, contactInput?.value || '', getDelivery()); }));
    }
    if (contactInput) {
      bindOnce(contactInput, (el) => el.addEventListener('input', () => { showFormError(null); refreshPreview(); saveForm(nameInput?.value || '', el.value, getDelivery()); }));
    }
    // Chips de entrega: la opción elegida cambia una línea del mensaje.
    modal.querySelectorAll<HTMLInputElement>('[name="order-delivery"]').forEach((radio) => {
      bindOnce(radio, (el) => el.addEventListener('change', () => { refreshPreview(); persistForm(); }));
    });
    // El preview vive en un <details> cerrado: al abrirlo recién se puede
    // medir, así que se redimensiona ahí.
    if (previewDetails) {
      bindOnce(previewDetails, (el) => el.addEventListener('toggle', () => {
        if (el.open) autoResizePreview();
      }));
    }
    if (whatsappBtn) {
      bindOnce(whatsappBtn, (el) => el.addEventListener('click', async () => {
        if (showFormError(await validateOrder())) return;
        const text = await buildOrderText();
        const url = buildWhatsAppLink(WHATSAPP_NUMBER, text);
        const win = window.open(url, '_blank', 'noopener');
        // Si el popup blocker lo intercepta, copiá el mensaje y abrí igual
        // el link como ancla (navegación directa, no bloqueable). El ancla
        // tiene que estar en el DOM para que Safari/Firefox la sigan.
        if (!win) {
          await copyTextToClipboard(text);
          const a = document.createElement('a');
          a.href = url;
          a.target = '_blank';
          a.rel = 'noopener';
          a.style.display = 'none';
          document.body.appendChild(a);
          a.click();
          a.remove();
        }
      }));
    }
    if (instagramBtn) {
      bindOnce(instagramBtn, (el) => el.addEventListener('click', async () => {
        if (showFormError(await validateOrder())) return;
        const text = await buildOrderText('instagram');
        const label = el.querySelector('.order-modal-btn-label');
        const originalText = label?.textContent || '';
        const copied = await copyTextToClipboard(text);
        window.open(`https://ig.me/m/${INSTAGRAM_HANDLE}`, '_blank', 'noopener,noreferrer');
        if (copied && label) {
          label.textContent = '¡Copiado!';
          setTimeout(() => {
            if (label) label.textContent = originalText;
          }, 2000);
        }
      }));
    }
    if (copyBtn) {
      bindOnce(copyBtn, (el) => el.addEventListener('click', async () => {
        if (!preview) return;
        // Copiar también valida: antes se copiaba el mensaje con los
        // placeholders `[Tu nombre]` sin avisar que era inválido.
        if (showFormError(await validateOrder())) return;
        const label = el.querySelector('.order-modal-btn-label');
        const originalText = label?.textContent || '';
        const copied = await copyTextToClipboard(preview.value);
        if (copied && label) {
          label.textContent = '¡Copiado!';
          setTimeout(() => {
            if (label) label.textContent = originalText;
          }, 2000);
        }
      }));
    }
  });
</script>

<style>
  .order-modal {
    --modal-width: 515px;
  }

  :global(#order-modal .modal-content) {
    scrollbar-width: thin;
    scrollbar-color: var(--color-outline-variant) transparent;
  }

  :global(#order-modal .modal-content::-webkit-scrollbar) {
    width: 5px;
  }

  :global(#order-modal .modal-content::-webkit-scrollbar-track) {
    background: transparent;
  }

  :global(#order-modal .modal-content::-webkit-scrollbar-thumb) {
    background-color: var(--color-outline-variant);
    border-radius: 4px;
  }

  :global(#order-modal .modal) {
    width: 515px;
  }

  @media (max-width: 640px) {
    :global(#order-modal .modal) {
      width: 100vw;
      max-width: 100vw;
    }
  }

  .order-modal-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .order-modal-text {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    color: var(--color-on-surface-variant);
    margin: 0;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-label {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
  }

  .form-input {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    color: var(--color-on-surface);
    background-color: var(--color-surface-container-high);
    border: var(--border-width) solid var(--color-outline-variant);
    border-radius: var(--border-radius);
    padding: 12px 16px;
    transition: all var(--transition-duration) var(--transition-easing);
  }

  .form-input::placeholder {
    color: var(--color-on-surface-variant);
    opacity: 0.85;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 20%, transparent);
  }

  .form-error {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    color: var(--color-error);
    background-color: var(--color-error-container);
    border-radius: var(--border-radius);
    padding: 10px 14px;
    margin: 0;
  }

  /* Chips de entrega: radios nativos (accesibles, funcionan sin JS para
     marcar la opción) disfrazados de botones. */
  .delivery-options {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .delivery-chip {
    position: relative;
    cursor: pointer;
  }

  .delivery-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .delivery-chip-text {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 6px 14px;
    font-family: var(--font-family);
    font-size: 13px;
    color: var(--color-on-surface-variant);
    background-color: var(--color-surface-container-high);
    border: var(--border-width) solid var(--color-outline-variant);
    border-radius: var(--border-radius);
    transition: all var(--transition-duration) var(--transition-easing);
    user-select: none;
  }

  .delivery-chip:hover .delivery-chip-text {
    border-color: var(--color-primary);
    color: var(--color-on-surface);
  }

  .delivery-radio:checked + .delivery-chip-text {
    color: var(--color-primary);
    border-color: var(--color-primary);
    background-color: color-mix(in srgb, var(--color-primary-container) 14%, transparent);
    font-weight: 600;
  }

  .delivery-radio:focus-visible + .delivery-chip-text {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Preview colapsable: el mensaje es para verificar, no para leer.
     Cerrado por default; NUNCA se abre solo (el JS solo redimensiona al
     abrirlo el usuario). */
  .order-preview-details {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .order-preview-summary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-primary);
    cursor: pointer;
    user-select: none;
    list-style: none;
  }

  .order-preview-summary::-webkit-details-marker {
    display: none;
  }

  .order-preview-summary::after {
    content: '+';
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border: var(--border-width) solid var(--color-outline-variant);
    border-radius: 50%;
    font-size: 14px;
    line-height: 1;
    transition: transform var(--transition-duration) var(--transition-easing);
  }

  .order-preview-details[open] .order-preview-summary::after {
    transform: rotate(45deg);
  }

  .order-preview-summary:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: var(--border-radius);
  }

  .form-textarea {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    color: var(--color-on-surface-variant);
    background-color: var(--color-surface-container-high);
    border: var(--border-width) solid var(--color-outline-variant);
    border-radius: var(--border-radius);
    padding: 12px 16px;
    resize: none;
    overflow-y: auto;
    max-height: 180px;
    line-height: 1.6;
    scrollbar-width: thin;
    scrollbar-color: var(--color-outline-variant) transparent;
  }

  .form-textarea::-webkit-scrollbar {
    width: 5px;
  }

  .form-textarea::-webkit-scrollbar-track {
    background: transparent;
  }

  .form-textarea::-webkit-scrollbar-thumb {
    background-color: var(--color-outline-variant);
    border-radius: 4px;
  }

  .order-preview {
    font-family: 'Montserrat', monospace;
    font-size: 13px;
    white-space: pre-wrap;
    /* Dentro del <details> (flex) el textarea encoge al ancho de sus cols
       si no se fuerza: siempre a lo ancho del modal. */
    width: 100%;
  }

  /* Un solo CTA principal: WhatsApp grande y a lo ancho. Instagram y
     Copiar mensaje pasan a una fila secundaria discreta (el peso visual
     que antes tenían los tres repartidos ahora concentra la acción). */
  .order-modal-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 4px;
  }

  .order-modal-actions .order-modal-btn {
    border-radius: var(--border-radius);
    letter-spacing: var(--font-label-sm-tracking);
  }

  .order-modal-btn--main {
    width: 100%;
    height: auto;
    min-height: 56px;
    padding: 0 20px;
    gap: 10px;
    font-size: var(--font-label-md-size, var(--font-label-sm-size));
  }

  .order-modal-actions-secondary {
    /* Fila discreta: botones achicados al contenido, centrados. Con dos
       columnas 1fr en 390px el ellipsis se comía "Copiar mensaje". */
    display: grid;
    grid-template-columns: repeat(2, minmax(0, auto));
    justify-content: center;
    gap: 8px 12px;
  }

  .order-modal-actions-secondary .order-modal-btn--alt {
    width: auto;
    min-width: 0;
    min-height: 38px;
    height: auto;
    padding: 6px 14px;
    gap: 6px;
    justify-content: center;
    font-size: 12px;
    opacity: 0.9;
  }

  .order-modal-btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .order-modal-btn-icon svg {
    width: 16px;
    height: 16px;
  }

  .order-modal-btn-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .order-modal-note {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    color: var(--color-on-surface-variant);
