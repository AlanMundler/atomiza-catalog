---
import Modal from '@/components/ui/Modal.astro';
import Button from '@/components/ui/Button.astro';
import { generateInstagramOrderText } from '@/utils/formatters';
import { getCart } from '@/utils/cart';
import type { Perfume } from '@/data/types';
import perfumesData from '@/data/perfumes.json';

const cart = getCart();
const perfumesMap = new Map(perfumesData.perfumes.map((p: Perfume) => [p.id, p]));
const orderText = generateInstagramOrderText(cart.items, perfumesMap, '[Tu nombre]', '[Tu WhatsApp/Instagram]');
---

<Modal 
  isOpen={false} 
  id="instagram-modal"
  title="Finalizar pedido"
  onClose={() => {}}
  class="instagram-modal"
>
  <div class="instagram-modal-content" slot="header">
    <p class="instagram-modal-text">Completa tus datos para generar el mensaje de pedido:</p>
    
    <div class="form-group">
      <label for="customer-name" class="form-label">Nombre completo</label>
      <input 
        type="text" 
        id="customer-name" 
        class="form-input"
        placeholder="Juan Pérez"
        aria-required="true"
      />
    </div>
    
    <div class="form-group">
      <label for="customer-contact" class="form-label">Contacto (WhatsApp o Instagram)</label>
      <input 
        type="text" 
        id="customer-contact" 
        class="form-input"
        placeholder="+54 9 11 1234-5678 / @usuario"
        aria-required="true"
      />
    </div>
    
    <div class="form-group">
      <label class="form-label">Vista previa del mensaje</label>
      <textarea 
        id="order-preview" 
        class="form-textarea order-preview"
        readonly
        aria-label="Vista previa del mensaje para Instagram"
      >{orderText}</textarea>
    </div>
    
    <div class="instagram-modal-actions">
      <Button 
        variant="secondary" 
        class="instagram-modal-btn"
        data-copy-order
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        Copiar mensaje
      </Button>
      <Button 
        variant="primary" 
        class="instagram-modal-btn instagram-modal-btn--primary"
        data-open-instagram
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
        Abrir Instagram
      </Button>
    </div>
    
    <p class="instagram-modal-note">Se abrirá Instagram para enviar el mensaje a <strong>@atomiza.cba</strong></p>
  </div>
</Modal>

<script>
  const modal = document.querySelector('#instagram-modal');
  const nameInput = modal?.querySelector('#customer-name');
  const contactInput = modal?.querySelector('#customer-contact');
  const previewTextarea = modal?.querySelector('#order-preview');
  const copyBtn = modal?.querySelector('[data-copy-order]');
  const openBtn = modal?.querySelector('[data-open-instagram]');
  
  function updatePreview() {
    const name = nameInput?.value || '[Tu nombre]';
    const contact = contactInput?.value || '[Tu WhatsApp/Instagram]';
    
    // Re-generate the text with actual values
    // In a real implementation, this would call the formatter function
    if (previewTextarea) {
      const text = previewTextarea.value
        .replace('[Tu nombre]', name)
        .replace('[Tu WhatsApp/Instagram]', contact);
      previewTextarea.value = text;
    }
  }
  
  nameInput?.addEventListener('input', updatePreview);
  contactInput?.addEventListener('input', updatePreview);
  
  copyBtn?.addEventListener('click', async () => {
    if (previewTextarea) {
      await navigator.clipboard.writeText(previewTextarea.value);
      const originalText = copyBtn.textContent;
      copyBtn.textContent = '¡Copiado!';
      setTimeout(() => {
        copyBtn.textContent = originalText;
      }, 2000);
    }
  });
  
  openBtn?.addEventListener('click', () => {
    if (previewTextarea) {
      const encodedText = encodeURIComponent(previewTextarea.value);
      window.open(`https://instagram.com/direct/new?t=${encodedText}`, '_blank');
    }
  });
  
  // Listen for order:finalize event
  window.addEventListener('order:finalize', () => {
    const instagramModal = document.querySelector('#instagram-modal');
    if (instagramModal) {
      const modalDialog = instagramModal.querySelector('dialog');
      if (modalDialog) {
        modalDialog.showModal();
        document.body.style.overflow = 'hidden';
      }
    }
  });
</script>

<style>
  .instagram-modal {
    --modal-width: 480px;
  }

  .instagram-modal-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .instagram-modal-text {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    color: var(--color-on-surface-variant);
    margin: 0;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-label {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
  }

  .form-input {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    color: var(--color-on-surface);
    background-color: var(--color-surface-container-high);
    border: var(--border-width) solid var(--color-outline-variant);
    border-radius: var(--border-radius);
    padding: 12px 16px;
    transition: all var(--transition-duration) var(--transition-easing).
  }

  .form-input::placeholder {
    color: var(--color-on-surface-variant).
    opacity: 0.5.
  }

  .form-input:focus {
    outline: none.
    border-color: var(--color-primary).
    box-shadow: 0 0 0 3px rgba(233, 193, 118, 0.2).
  }

  .form-textarea {
    font-family: var(--font-family).
    font-size: var(--font-body-md-size).
    color: var(--color-on-surface-variant).
    background-color: var(--color-surface-container-high).
    border: var(--border-width) solid var(--color-outline-variant).
    border-radius: var(--border-radius).
    padding: 12px 16px.
    min-height: 200px.
    resize: vertical.
    line-height: 1.6.
  }

  .order-preview {
    font-family: 'Montserrat', monospace.
    font-size: 13px.
    white-space: pre-wrap.
  }

  .instagram-modal-actions {
    display: flex.
    flex-direction: column.
    gap: 12px.
    margin-top: 8px.
  }

  @media (min-width: 480px) {
    .instagram-modal-actions {
      flex-direction: row.
    }
    
    .instagram-modal-btn {
      flex: 1.
    }
  }

  .instagram-modal-btn--primary {
    order: -1.
  }

  .instagram-modal-note {
    font-family: var(--font-family).
    font-size: var(--font-label-sm-size).
    color: var(--color-on-surface-variant).
    text-align: center.
    margin: 0.
  }

  .instagram-modal-note strong {
    color: var(--color-primary).
  }
</style>