---
import Drawer from '@/components/ui/Drawer.astro';
---

<Drawer 
  position="right" 
  id="cart-drawer"
  class="cart-drawer"
>
  <div class="cart-header" slot="header">
    <h2 class="cart-title">Tu pedido</h2>
    <button class="cart-clear" data-clear-cart>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <polyline points="3 6 5 6 21 6"></polyline>
        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
      </svg>
      Vaciar
    </button>
  </div>

  <div class="cart-content" id="cart-content"></div>
</Drawer>

<script>
  import {
    getCart,
    addToCart,
    removeFromCart,
    changeCartItemQuantity,
    clearCart
  } from '@/utils/cart';
  import { formatPrice, escapeHtml, resolveCartItems } from '@/utils/formatters';
  import type { ResolvedCartItem } from '@/utils/formatters';
  import type { Perfume } from '@/data/types';
  import { getPerfumesMap } from '@/utils/perfumes-client';
  import { bindOnce, onPageLoad, onWindowOnce } from '@/utils/view-transitions';
  import { TRIDENT_COUNT, TRIDENT_DISCOUNT, descuentoTridente, tridentesCompletos } from '@/utils/trident';
  import { initQuickAdd } from '@/utils/quick-add';
  import { assetUrl } from '@/site.config';

  // El quick-add vive acá y no en Layout: Astro dropea el 2º <script> del
  // layout y el init nunca llegaba al bundle. El drawer existe en todas las
  // páginas, así que la delegación global queda cubierta igual.
  initQuickAdd();

  let drawerRoot: HTMLElement | null = null;
  let perfumesMap = new Map<string, any>();

  async function render() {
    const content = document.querySelector('#cart-content') as HTMLElement | null;
    if (!content) return;

    const cart = getCart();

    if (cart.items.length === 0) {
      content.innerHTML = `
        <div class="cart-empty">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          <p class="cart-empty-text">Tu carrito está vacío</p>
          <p class="cart-empty-subtext">Agrega decants desde el catálogo</p>
          <a href="${assetUrl('catalogo/')}" class="btn btn--primary btn--md empty-cta">Ver catálogo</a>
        </div>
      `;
      return;
    }

    // Solo se descarga el catálogo cuando hay items (evita el fetch en cada
    // página para visitantes con el carrito vacío).
    perfumesMap = await getPerfumesMap();
    const resolved = resolveCartItems(cart.items, perfumesMap);
    const unavailableCount = resolved.filter((r) => !r.available).length;
    // El subtotal SIEMPRE se calcula contra el catálogo vivo (igual que el
    // mensaje de pedido), nunca con el precio snapshot del carrito.
    const subtotal = resolved.reduce(
      (sum, r) => sum + (r.available ? r.size.price * r.quantity : 0),
      0
    );
    // Descuento automático: cada 3 decants comprables restan $2.000.
    const orderableCount = resolved
      .filter((r) => r.available)
      .reduce((sum, r) => sum + r.quantity, 0);
    const tridentes = tridentesCompletos(orderableCount);
    const discount = descuentoTridente(orderableCount);
    const total = subtotal - discount;
    // Con 1-2 decants conviene sumar: el nudge lleva al catálogo (acción),
    // no a otra página intermedia.
    const missing = TRIDENT_COUNT - orderableCount;
    // Tira fina de progreso (no caja): con 1-2 decants el próximo hito
    // siempre es el primer tridente (−$2.000).
    let dots = '';
    for (let i = 0; i < TRIDENT_COUNT; i++) {
      dots += `<i class="${i < orderableCount ? 'on' : ''}"></i>`;
    }
    const tridentNudge = orderableCount > 0 && missing > 0
      ? `<a class="trident-nudge" href="${assetUrl('catalogo/')}"><span class="trident-dots" aria-hidden="true">${dots}</span><span>Te falta${missing === 1 ? '' : 'n'} ${missing} para −${formatPrice(TRIDENT_DISCOUNT)}</span><span aria-hidden="true">→</span></a>`
      : tridentes > 0
        ? `<p class="trident-nudge trident-nudge--ready"><span aria-hidden="true">✓</span><span>${tridentes} ${tridentes === 1 ? 'tridente' : 'tridentes'}: −${formatPrice(discount)} en tu pedido</span></p>`
        : '';

    const totalsHtml = discount > 0
      ? `<div class="order-summary-line">
          <span class="order-summary-label">Subtotal</span>
          <span class="order-summary-value">${formatPrice(subtotal)}</span>
        </div>
        <div class="order-summary-line order-summary-line--discount">
          <span class="order-summary-label">Descuento tridente</span>
          <span class="order-summary-value">−${formatPrice(discount)}</span>
        </div>
        <div class="order-summary-line order-summary-line--total">
          <span class="order-summary-label">Total</span>
          <span class="order-summary-value" data-cart-total>${formatPrice(total)}</span>
        </div>`
      : `<div class="order-summary-line order-summary-line--total">
          <span class="order-summary-label">Total estimado</span>
          <span class="order-summary-value" data-cart-total>${formatPrice(total)}</span>
        </div>`;

    content.innerHTML = `
      <ul class="cart-items" role="list" aria-label="Artículos en el carrito">
        ${resolved.map(itemHtml).join('')}
      </ul>
      ${tridentNudge}
      <div class="order-summary" role="region" aria-label="Resumen del pedido">
        ${totalsHtml}
        ${
          unavailableCount > 0
            ? `<p class="order-summary-note">${unavailableCount === 1 ? 'Un perfume quedó sin stock y no se incluye en el total' : `${unavailableCount} perfumes quedaron sin stock y no se incluyen en el total`}</p>`
            : ''
        }
        <p class="order-summary-note">El total final se confirma al coordinar el envío</p>
        <button type="button" class="btn btn--primary btn--lg order-summary-btn" data-finalize-order>
          Finalizar pedido
        </button>
      </div>
    `;
  }

  function itemHtml(item: ResolvedCartItem): string {
    const perfume = item.perfume || ({} as Perfume);
    const brand = perfume.brand || item.perfumeId;
    const name = perfume.name || item.perfumeId;
    const image = assetUrl(perfume.images?.[0]?.src);
    const size = item.size;
    const available = item.available;
    const displayQuantity = available ? item.quantity : item.requestedQuantity;
    const lineTotal = available ? size.price * item.quantity : 0;
    const isVector = (perfume.images?.[0]?.src || '').toLowerCase().endsWith('.svg');
    const es = escapeHtml;

    return `
      <li class="cart-item${available ? '' : ' cart-item--unavailable'}" data-perfume-id="${es(item.perfumeId)}" data-size-ml="${es(size.ml)}">
        <div class="cart-item-image${isVector ? ' cart-item-image--square' : ''}">
          <img src="${es(image)}" alt="${es(brand)} ${es(name)}" loading="lazy" width="64" height="64" />
        </div>
        <div class="cart-item-info">
          <div class="cart-item-brand">${es(brand)}</div>
          <div class="cart-item-name">${es(name)}</div>
          <div class="cart-item-meta">
            <span class="cart-item-size">${es(size.ml)}ml</span>
            <span class="cart-item-price">${formatPrice(size.price)}</span>
            ${!available ? '<span class="cart-item-status">SIN STOCK</span>' : ''}
          </div>
        </div>
        <div class="cart-item-controls">
          <div class="cart-item-quantity">
            <button type="button" class="quantity-btn quantity-btn--decrease" data-action="decrease" aria-label="Disminuir cantidad" ${!available || displayQuantity <= 1 ? 'disabled' : ''}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </button>
            <span class="quantity-value" aria-live="polite">${es(displayQuantity)}</span>
            <button type="button" class="quantity-btn quantity-btn--increase" data-action="increase" aria-label="Aumentar cantidad" ${!available || displayQuantity >= size.stock ? 'disabled' : ''}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </button>
          </div>
          <div class="cart-item-total">
            <span class="cart-item-line-total">${available ? formatPrice(lineTotal) : '—'}</span>
            <button type="button" class="cart-item-remove" data-action="remove" aria-label="Eliminar del carrito">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
        </div>
      </li>
    `;
  }

  function updateAndRerender() {
    window.dispatchEvent(new CustomEvent('cart:update'));
  }

  async function handleAction(target: HTMLElement) {
    const action = target.getAttribute('data-action');
    const itemEl = target.closest('.cart-item') as HTMLElement | null;
    if (!itemEl) return;

    const perfumeId = itemEl.getAttribute('data-perfume-id');
    const sizeMl = parseInt(itemEl.getAttribute('data-size-ml') || '', 10);
    const perfume = (await getPerfumesMap()).get(perfumeId || '');
    const size = perfume?.sizes?.find((s: any) => s.ml === sizeMl);
    if (!perfumeId || !size) return;

    // +1/-1 como delta atómico (lee el carrito fresco adentro): dos clicks
    // rápidos ya no pierden una unidad por leer la misma cantidad vieja.
    if (action === 'decrease') {
      changeCartItemQuantity(perfumeId, size, -1);
    } else if (action === 'increase') {
      changeCartItemQuantity(perfumeId, size, 1);
    } else if (action === 'remove') {
      removeFromCart(perfumeId, size);
    }
    updateAndRerender();
  }

  // Listen for cart open event
  onWindowOnce('cart-open', 'cart:open', () => {
    render();
    if (drawerRoot) {
      drawerRoot.dispatchEvent(new CustomEvent('drawer:toggle', { detail: { open: true } }));
    }
  });

  function showToast(message: string, type: 'error' | 'success' = 'error') {
    const existing = document.querySelector('.cart-toast');
    if (existing) existing.remove();
    const toast = document.createElement('div');
    toast.className = 'cart-toast';
    toast.setAttribute('role', 'status');
    toast.textContent = message;
    toast.style.cssText = `
      position:fixed;bottom:24px;left:50%;transform:translateX(-50%);
      padding:10px 20px;border-radius:8px;font-size:14px;z-index:2147483647;
      color:#fff;font-family:var(--font-family);
      background:${type === 'error' ? '#c62828' : '#2e7d32'};
      box-shadow:0 4px 12px rgba(0,0,0,.3);
      animation:toast-in .3s ease;
    `;
    document.body.appendChild(toast);
    setTimeout(() => { toast.style.opacity = '0'; toast.style.transition = 'opacity .3s'; }, 2500);
    setTimeout(() => toast.remove(), 3000);
  }

  // Listen for add to cart event
  onWindowOnce('cart-add', 'cart:add', async (e) => {
    const { perfumeId, sizeMl, quantity } = (e as CustomEvent).detail;
    try {
      let perfume = (await getPerfumesMap()).get(perfumeId);
      // Si el catálogo cacheado está desactualizado, forzar refetch.
      if (!perfume) perfume = (await getPerfumesMap(true)).get(perfumeId);

      const size = perfume?.sizes?.find((s: any) => s.ml === sizeMl);
      if (!perfumeId || !size) {
        showToast('No se pudo agregar al carrito. Intentá de nuevo.', 'error');
        return;
      }
      if (size.stock <= 0) {
        showToast('Este perfume está sin stock.', 'error');
        return;
      }

      addToCart({ perfumeId, size, quantity: quantity || 1 });
      window.dispatchEvent(new CustomEvent('cart:update'));
    } catch {
      showToast('Error de conexión. Revisá tu internet y intentá de nuevo.', 'error');
    }
  });

  // Listen for cart updates
  onWindowOnce('cart-update', 'cart:update', () => {
    render();
  });

  onPageLoad('cart-drawer', () => {
    drawerRoot = document.querySelector('#cart-drawer');
    const content = document.querySelector('#cart-content') as HTMLElement | null;
    const clearBtn = document.querySelector('[data-clear-cart]') as HTMLElement | null;

    if (content) {
      bindOnce(content, (el) => {
        el.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          const actionEl = target.closest('[data-action]') as HTMLElement | null;
          const finalizeEl = target.closest('[data-finalize-order]') as HTMLElement | null;

          if (actionEl) {
            handleAction(actionEl);
            return;
          }
          if (finalizeEl) {
            window.dispatchEvent(new CustomEvent('order:finalize'));
          }
        });
      });
    }

    if (clearBtn) {
      bindOnce(clearBtn, (el) => {
        el.addEventListener('click', () => {
          if (confirm('¿Estás seguro de que quieres vaciar el carrito?')) {
            clearCart();
            updateAndRerender();
          }
        });
      });
    }

    render();
  });
</script>

<style is:global>
  .cart-drawer {
    --drawer-width: 400px;
  }

  .cart-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    border-bottom: var(--border-width) solid var(--color-outline-variant);
  }

  .cart-title {
    font-family: var(--font-family);
    font-size: var(--font-headline-md-size);
    font-weight: var(--font-headline-md-weight);
    line-height: var(--font-headline-md-line-height);
    letter-spacing: var(--font-headline-md-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
    margin: 0;
  }

  .cart-clear {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 8px;
    transition: color var(--transition-duration) var(--transition-easing);
  }

  .cart-clear:hover {
    color: var(--color-error);
  }

  .cart-clear:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: var(--border-radius);
  }

  .cart-content {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .cart-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 48px 24px;
    text-align: center;
    color: var(--color-on-surface-variant);
    flex: 1;
  }

  .cart-empty-text {
    font-family: var(--font-family);
    font-size: var(--font-headline-md-size);
    font-weight: var(--font-headline-md-weight);
    letter-spacing: var(--font-headline-md-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
    margin: 16px 0 8px;
  }

  .cart-empty-subtext {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    margin: 0;
  }

  .cart-empty .empty-cta {
    margin-top: var(--spacing-stack-md);
    min-height: 44px;
  }

  /* Nudge de tridente: tira fina con progreso, no caja que grite. */
  .trident-nudge {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 12px;
    padding: 9px 12px;
    font-family: var(--font-family);
    font-size: 13px;
    line-height: 1.4;
    color: var(--color-primary);
    text-decoration: none;
    text-align: center;
    background-color: rgba(197, 160, 89, 0.07);
    border: var(--border-width) solid var(--color-outline-variant);
    border-radius: var(--border-radius);
  }

  a.trident-nudge:hover {
    border-color: var(--color-primary);
    background-color: rgba(197, 160, 89, 0.12);
  }

  .trident-nudge--ready {
    color: var(--color-status-in-stock);
    border-color: var(--color-status-in-stock);
    background: transparent;
  }

  .trident-dots {
    display: inline-flex;
    gap: 4px;
    flex-shrink: 0;
  }

  .trident-dots i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--color-outline-variant);
  }

  .trident-dots i.on {
    background-color: var(--color-primary);
  }

  .cart-items {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--color-outline-variant) transparent;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 0 4px 0 0;
    list-style: none;
  }

  .cart-items::-webkit-scrollbar {
    width: 5px;
  }

  .cart-items::-webkit-scrollbar-track {
    background: transparent;
  }

  .cart-items::-webkit-scrollbar-thumb {
    background-color: var(--color-outline-variant);
    border-radius: 4px;
  }

  /* Cart item */
  /* El drawer nunca supera 400px aunque el viewport sea desktop: las
     media queries por viewport no sirven acá, el layout compacto (2
     columnas + controles a lo ancho) es el base para todos los casos. */
  .cart-item {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 10px;
    padding: 12px;
    background-color: var(--color-surface-container-high);
    border: var(--border-width) solid var(--color-outline-variant);
    border-radius: var(--border-radius);
    align-items: start;
  }

  .cart-item-image {
    width: 56px;
    aspect-ratio: 3 / 4;
    border-radius: calc(var(--border-radius) - 4px);
    overflow: hidden;
    background-color: var(--color-surface-container-highest);
    flex-shrink: 0;
  }

  .cart-item-image--square {
    aspect-ratio: 1 / 1;
  }

  .cart-item-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .cart-item-info {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .cart-item-brand {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cart-item-name {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    font-weight: var(--font-body-md-weight);
    color: var(--color-on-surface);
    line-height: 1.3;
    margin: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  .cart-item-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 2px;
  }

  .cart-item-size {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-on-primary);
    background-color: var(--color-primary);
    padding: 3px 10px;
    border-radius: var(--border-radius);
  }

  .cart-item-price {
    font-family: var(--font-family);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-on-surface-variant);
  }

  .cart-item--unavailable {
    opacity: 0.6;
    background-color: var(--color-surface-container);
  }

  .cart-item--unavailable .cart-item-image {
    background-color: var(--color-surface-container-highest);
  }

  .cart-item-status {
    font-family: var(--font-family);
    font-size: var(--font-label-sm-size);
    font-weight: var(--font-label-sm-weight);
    letter-spacing: var(--font-label-sm-tracking);
    text-transform: uppercase;
    color: var(--color-status-out-of-stock);
    border: var(--border-width) solid var(--color-outline-variant);
    padding: 3px 10px;
    border-radius: var(--border-radius);
  }

  .cart-item-controls {
    display: flex;
    grid-column: 1 / -1;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }

  .cart-item-quantity {
    display: flex;
    align-items: center;
    gap: 4px;
    background-color: var(--color-surface-container-highest);
    border: var(--border-width) solid var(--color-outline-variant);
    border-radius: var(--border-radius);
    padding: 3px 4px;
  }

  .quantity-btn {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-on-surface);
    background: transparent;
    border: none;
    border-radius: var(--border-radius);
    cursor: pointer;
    transition: all var(--transition-duration) var(--transition-easing);
  }

  .quantity-btn:hover:not(:disabled) {
    color: var(--color-primary);
    background-color: var(--color-surface-container);
  }

  .quantity-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .quantity-btn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .quantity-value {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    font-weight: var(--font-body-md-weight);
    color: var(--color-on-surface);
    min-width: 22px;
    text-align: center;
  }

  .cart-item-total {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .cart-item-line-total {
    font-family: var(--font-family);
    font-size: var(--font-body-md-size);
    font-weight: var(--font-body-md-weight);
    color: var(--color-on-surface);
  }

  .cart-item-remove {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-on-surface-variant);
    opacity: 0.6;
    background: transparent;
    border: none;
    border-radius: var(--border-radius);
    cursor: pointer;
    transition: all var(--transition-duration) var(--transition-easing);
  }

  .cart-item-remove:hover {
    opacity: 1;
  }

