---
import Drawer from '@/components/ui/Drawer.astro';
---

<Drawer 
  position="right" 
  id="cart-drawer"
  class="cart-drawer"
>
  <div class="flex items-center justify-between p-5 border-b border-base-300" slot="header">
    <h2 class="font-medium text-lg uppercase tracking-wider m-0">Tu pedido</h2>
    <button class="btn btn-ghost btn-sm text-base-content/60 hover:text-error gap-1" data-clear-cart>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <polyline points="3 6 5 6 21 6"></polyline>
        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
      </svg>
      Vaciar
    </button>
  </div>

  <div class="cart-content" id="cart-content"></div>
</Drawer>

<script>
  import {
    getCart,
    addToCart,
    removeFromCart,
    updateCartItemQuantity,
    clearCart
  } from '@/utils/cart';
  import { formatPrice, escapeHtml, resolveCartItems } from '@/utils/formatters';
  import type { ResolvedCartItem } from '@/utils/formatters';
  import type { Perfume } from '@/data/types';
  import { getPerfumesMap } from '@/utils/perfumes-client';
  import { bindOnce, onPageLoad, onWindowOnce } from '@/utils/view-transitions';
  import { assetUrl } from '@/site.config';

  let drawerRoot: HTMLElement | null = null;
  let perfumesMap = new Map<string, any>();

  async function render() {
    const content = document.querySelector('#cart-content') as HTMLElement | null;
    if (!content) return;

    const cart = getCart();

    if (cart.items.length === 0) {
      content.innerHTML = `
        <div class="flex flex-col items-center justify-center flex-1 p-6 text-center text-base-content/60">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          <p class="text-lg font-medium uppercase tracking-wider mt-4 mb-2">Tu carrito está vacío</p>
          <p class="text-sm m-0">Agrega decants desde el catálogo</p>
        </div>
      `;
      return;
    }

    // Solo se descarga el catálogo cuando hay items (evita el fetch en cada
    // página para visitantes con el carrito vacío).
    perfumesMap = await getPerfumesMap();
    const resolved = resolveCartItems(cart.items, perfumesMap);
    const unavailableCount = resolved.filter((r) => !r.available).length;
    // El subtotal SIEMPRE se calcula contra el catálogo vivo (igual que el
    // mensaje de pedido), nunca con el precio snapshot del carrito.
    const subtotal = resolved.reduce(
      (sum, r) => sum + (r.available ? r.size.price * r.quantity : 0),
      0
    );

    content.innerHTML = `
      <ul class="flex flex-col gap-3 flex-1 min-h-0 overflow-y-auto scrollbar-thin list-none m-0 p-0 px-1" role="list" aria-label="Artículos en el carrito">
        ${resolved.map(itemHtml).join('')}
      </ul>
      <div class="shrink-0 mt-3 p-3 bg-base-200 border border-base-300" role="region" aria-label="Resumen del pedido">
        <div class="flex justify-between items-center pt-2 border-t border-base-300">
          <span class="text-sm text-base-content/60">Total estimado</span>
          <span class="text-sm font-medium text-primary">${formatPrice(subtotal)}</span>
        </div>
        ${
          unavailableCount > 0
            ? `<p class="text-[10px] text-base-content/60 text-center my-1">${unavailableCount === 1 ? 'Un perfume quedó sin stock y no se incluye en el total' : `${unavailableCount} perfumes quedaron sin stock y no se incluyen en el total`}</p>`
            : ''
        }
        <p class="text-[10px] text-base-content/60 my-1 text-center">El total final se confirma al coordinar el envío</p>
        <button type="button" class="btn btn-primary btn-lg w-full mt-2" data-finalize-order>
          Finalizar pedido
        </button>
      </div>
    `;
  }

  function itemHtml(item: ResolvedCartItem): string {
    const perfume = item.perfume || ({} as Perfume);
    const brand = perfume.brand || item.perfumeId;
    const name = perfume.name || item.perfumeId;
    const image = assetUrl(perfume.images?.[0]?.src);
    const size = item.size;
    const available = item.available;
    const displayQuantity = available ? item.quantity : item.requestedQuantity;
    const lineTotal = available ? size.price * item.quantity : 0;
    const isVector = (perfume.images?.[0]?.src || '').toLowerCase().endsWith('.svg');
    const es = escapeHtml;

    return `
      <li class="flex gap-3 p-2 bg-base-200 border border-base-300 ${available ? '' : 'opacity-60'}" data-perfume-id="${es(item.perfumeId)}" data-size-ml="${es(size.ml)}">
        <div class="w-16 h-16 shrink-0 ${isVector ? 'bg-white rounded-sm p-1' : ''}">
          <img class="w-full h-full object-contain" src="${es(image)}" alt="${es(brand)} ${es(name)}" loading="lazy" width="64" height="64" />
        </div>
        <div class="flex-1 min-w-0">
          <div class="text-[10px] font-medium tracking-[0.1em] uppercase text-base-content/60">${es(brand)}</div>
          <div class="text-xs truncate">${es(name)}</div>
          <div class="flex items-center gap-2 mt-1 text-[11px]">
            <span class="font-medium tracking-[0.1em] uppercase">${es(size.ml)}ml</span>
            <span class="font-medium text-primary">${formatPrice(size.price)}</span>
            ${!available ? '<span class="badge badge-error badge-xs text-[8px] border-0">SIN STOCK</span>' : ''}
          </div>
        </div>
        <div class="flex flex-col items-end justify-between shrink-0">
          <div class="flex items-center gap-1">
            <button type="button" class="btn btn-ghost btn-xs w-6 h-6 min-h-0 p-0" data-action="decrease" aria-label="Disminuir cantidad" ${!available || displayQuantity <= 1 ? 'disabled' : ''}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </button>
            <span class="text-xs font-medium w-4 text-center" aria-live="polite">${es(displayQuantity)}</span>
            <button type="button" class="btn btn-ghost btn-xs w-6 h-6 min-h-0 p-0" data-action="increase" aria-label="Aumentar cantidad" ${!available || displayQuantity >= size.stock ? 'disabled' : ''}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </button>
          </div>
          <div class="flex items-center gap-2 mt-1">
            <span class="text-xs font-medium text-primary">${available ? formatPrice(lineTotal) : '—'}</span>
            <button type="button" class="btn btn-ghost btn-xs text-base-content/60 hover:text-error w-5 h-5 min-h-0 p-0" data-action="remove" aria-label="Eliminar del carrito">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
        </div>
      </li>
    `;
  }

  function updateAndRerender() {
    window.dispatchEvent(new CustomEvent('cart:update'));
  }

  async function handleAction(target: HTMLElement) {
    const action = target.getAttribute('data-action');
    const itemEl = target.closest('.cart-item') as HTMLElement | null;
    if (!itemEl) return;

    const perfumeId = itemEl.getAttribute('data-perfume-id');
    const sizeMl = parseInt(itemEl.getAttribute('data-size-ml') || '', 10);
    const perfume = (await getPerfumesMap()).get(perfumeId || '');
    const size = perfume?.sizes?.find((s: any) => s.ml === sizeMl);
    if (!perfumeId || !size) return;

    const current = getCart().items.find(
      (i) => i.perfumeId === perfumeId && i.size.ml === sizeMl
    );

    if (action === 'decrease' && current) {
      updateCartItemQuantity(perfumeId, size, current.quantity - 1);
    } else if (action === 'increase' && current) {
      updateCartItemQuantity(perfumeId, size, current.quantity + 1);
    } else if (action === 'remove') {
      removeFromCart(perfumeId, size);
    }
    updateAndRerender();
  }

  // Listen for cart open event
  onWindowOnce('cart-open', 'cart:open', () => {
    render();
    if (drawerRoot) {
      drawerRoot.dispatchEvent(new CustomEvent('drawer:toggle', { detail: { open: true } }));
    }
  });

  // Listen for add to cart event
  onWindowOnce('cart-add', 'cart:add', async (e) => {
    const { perfumeId, sizeMl, quantity } = (e as CustomEvent).detail;
    const perfume = (await getPerfumesMap()).get(perfumeId);
    const size = perfume?.sizes?.find((s: any) => s.ml === sizeMl);
    if (!perfumeId || !size) return;

    addToCart({ perfumeId, size, quantity: quantity || 1 });
    window.dispatchEvent(new CustomEvent('cart:update'));
  });

  // Listen for cart updates
  onWindowOnce('cart-update', 'cart:update', () => {
    render();
  });

  onPageLoad('cart-drawer', () => {
    drawerRoot = document.querySelector('#cart-drawer');
    const content = document.querySelector('#cart-content') as HTMLElement | null;
    const clearBtn = document.querySelector('[data-clear-cart]') as HTMLElement | null;

    if (content) {
      bindOnce(content, (el) => {
        el.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          const actionEl = target.closest('[data-action]') as HTMLElement | null;
          const finalizeEl = target.closest('[data-finalize-order]') as HTMLElement | null;

          if (actionEl) {
            handleAction(actionEl);
            return;
          }
          if (finalizeEl) {
            window.dispatchEvent(new CustomEvent('order:finalize'));
          }
        });
      });
    }

    if (clearBtn) {
      bindOnce(clearBtn, (el) => {
        el.addEventListener('click', () => {
          if (confirm('¿Estás seguro de que quieres vaciar el carrito?')) {
            clearCart();
            updateAndRerender();
          }
        });
      });
    }

    render();
  });
</script>

<style is:global>
  .cart-drawer {
    --drawer-width: 400px;
  }

  @media (max-width: 480px) {
    .cart-drawer {
      --drawer-width: 100vw;
    }
  }
</style>